@page "{id:int}"
@model CheckinApp.Pages.Courses.EditModel
@{
    ViewData["Title"] = "编辑课程";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>编辑课程</h2>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label>课程名称</label>
            <input asp-for="Name" required autocomplete="off" />
        </div>
        <div class="field">
            <label>老师</label>
            <input asp-for="Teacher" autocomplete="off" />
        </div>
        <div class="field">
            <label>地点</label>
            <input asp-for="Location" autocomplete="off" />
        </div>
        <div class="field">
            <label>星期</label>
            <select asp-for="Weekday">
                @for (var i = 1; i <= 7; i++)
                {
                    <option value="@i" selected="@(i == Model.Weekday ? "selected" : null)">周@("一二三四五六日"[i - 1])</option>
                }
            </select>
        </div>
        <div class="field">
            <label>开始节次</label>
            <select asp-for="StartPeriod">
                @for (var i = 1; i <= Model.PeriodCount; i++)
                {
                    <option value="@i" selected="@(i == Model.StartPeriod ? "selected" : null)">第 @i 节</option>
                }
            </select>
        </div>
        <div class="field">
            <label>结束节次</label>
            <select asp-for="EndPeriod">
                @for (var i = 1; i <= Model.PeriodCount; i++)
                {
                    <option value="@i" selected="@(i == Model.EndPeriod ? "selected" : null)">第 @i 节</option>
                }
            </select>
        </div>
        <div class="field">
            <label>上课周次</label>
            <input asp-for="WeeksText" autocomplete="off" />
        </div>
        <div class="field">
            <label>课程类别</label>
            <select asp-for="Category">
                <option value="required" selected="@(Model.Category == "required" ? "selected" : null)">必修课</option>
                <option value="college" selected="@(Model.Category == "college" ? "selected" : null)">院级选修课</option>
                <option value="school" selected="@(Model.Category == "school" ? "selected" : null)">校级选修课</option>
                <option value="other" selected="@(Model.Category == "other" ? "selected" : null)">其它</option>
            </select>
        </div>
        @* 颜色按「课程」分，不再按类别分：同一门课整学期同一个色，一周里分散的几次课能顺着颜色串起来。
           「自动」= 不落库，读的时候按课名算，所以同名课天然同色，也不用为每门课存一个值。 *@
        <div class="field">
            <label>卡片颜色</label>
            @{
                var autoColor = string.IsNullOrEmpty(Model.Color)
                    ? CoursePalette.DefaultFor(Model.Name)
                    : Model.Color;
            }
            <div class="cc-swatches" id="ccSwatches" data-auto="@autoColor">
                <label class="cc-swatch @(string.IsNullOrEmpty(Model.Color) ? "on" : "")"
                       title="自动（按课程名分配）" data-key="auto">
                    <span class="cc-dot"></span>
                    <input type="radio" name="Color" value="" checked="@(string.IsNullOrEmpty(Model.Color) ? "checked" : null)" />
                </label>
                @foreach (var (key, label) in CoursePalette.All)
                {
                    var on = Model.Color == key;
                    <label class="cc-swatch cs-@key @(on ? "on" : "")" title="@label" data-key="@key">
                        <span class="cc-dot"></span>
                        <input type="radio" name="Color" value="@key" checked="@(on ? "checked" : null)" />
                    </label>
                }
            </div>
            <p class="cc-hint">默认自动：同名课程自动同色（「高等数学（上）」和「高等数学 上」算同一门）。</p>
            <div class="cc-preview cs-@autoColor" id="ccPreview">
                <span>@(string.IsNullOrWhiteSpace(Model.Name) ? "课程名" : Model.Name)</span>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
            <a class="btn secondary" href="/Courses">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>

    <hr class="rule" />
    <form method="post" asp-page-handler="Delete" data-confirm="确认删除" class="danger-row">
        <input type="hidden" name="id" value="@Model.Id" />
        <button class="btn danger" type="submit">@Html.Raw(Icons.Svg("trash-2", 16)) 删除课程</button>
    </form>
</div>

<script>
    // 选色即时反馈：点色块 → 选中态跟着走（纯 CSS 做不了，因为选中态要标在 label 上而不是 radio 上）
    (function () {
        var box = document.getElementById('ccSwatches');
        var prev = document.getElementById('ccPreview');
        if (!box) return;
        box.addEventListener('change', function (ev) {
            if (ev.target.name !== 'Color') return;
            var picked = ev.target.closest('.cc-swatch');
            [].forEach.call(box.querySelectorAll('.cc-swatch'), function (el) {
                el.classList.toggle('on', el === picked);
            });
            // 预览条换成实际会用的颜色：选了具体色就用它，选「自动」用服务端算好的默认色
            if (prev && picked) {
                var key = picked.dataset.key === 'auto' ? box.dataset.auto : picked.dataset.key;
                prev.className = 'cc-preview cs-' + key;
            }
        });
    })();
</script>
