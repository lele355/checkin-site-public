@page
@model CheckinApp.Pages.Courses.SettingsModel
@{
    ViewData["Title"] = "课表设置";
}

<div class="card" style="max-width:560px;margin:2vh auto 0;">
    <div class="page-head">
        <h2>课表设置</h2>
        <div class="head-actions">
            <a class="btn secondary" href="/Courses">@Html.Raw(Icons.Svg("arrow-left", 16)) 返回课表</a>
        </div>
    </div>

    @if (Model.Saved)
    {
        <div class="msg ok">已保存。</div>
    }

    <div class="cs-block">
        <div class="cs-block-head">
            <b>学期起始日</b>
        </div>
        <form method="post" asp-page-handler="Semester" class="cs-inline">
            <input type="date" asp-for="SemesterStartInput" />
            <button class="btn" type="submit">保存</button>
        </form>
        <p class="mini" style="margin-top:6px;">
            @if (Model.SemesterConfigured)
            {
                <text>当前：@Model.SemesterStart.ToString("yyyy年M月d日")（周一）· 今天在第 @Model.CurrentWeek 周</text>
            }
            else
            {
                <text>还没设置过</text>
            }
        </p>
    </div>

    <div class="cs-block">
        <div class="cs-block-head">
            <b>显示非本周课程</b>
        </div>
        <form method="post" asp-page-handler="ToggleOffWeek" class="cs-inline">
            <input type="hidden" name="show" value="@(Model.ShowOffWeek ? "0" : "1")" />
            <button class="tt-opt-toggle @(Model.ShowOffWeek ? "on" : "")" type="submit"
                    aria-pressed="@(Model.ShowOffWeek ? "true" : "false")">
                <span class="tt-opt-dot" aria-hidden="true"></span>
                @(Model.ShowOffWeek ? "显示" : "不显示")
            </button>
        </form>
    </div>

    <div class="cs-block">
        <div class="cs-block-head">
            <b>学期</b>
            <span class="mini">当前：@Model.SemesterName</span>
        </div>
        <a class="btn secondary" href="/Courses/Semesters">@Html.Raw(Icons.Svg("grid", 16)) 管理学期</a>
    </div>

    <div class="cs-block">
        <div class="cs-block-head">
            <b>节次与时间</b>
            <span class="mini">当前 @Model.PeriodCount 节</span>
        </div>
        <a class="btn secondary" href="/Courses/Periods">@Html.Raw(Icons.Svg("settings-2", 16)) 编辑节次时间</a>
    </div>
</div>
