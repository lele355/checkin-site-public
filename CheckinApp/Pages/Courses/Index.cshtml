@page
@model CheckinApp.Pages.Courses.IndexModel
@using CheckinApp.Services
@{
    ViewData["Title"] = "课程表";
    var dayNames = new[] { "周一", "周二", "周三", "周四", "周五", "周六", "周日" };
}

<div class="card tt-top">
    @* ---- 顶部：只有周次切换 + 设置 + 添加。学期起始/节次/非本周显示都收进「设置」二级页 ---- *@
    <div class="tt-head">
        <div class="tt-head-main">
            <a class="tt-arrow" href="/Courses?week=@(Model.Week - 1)" aria-label="上一周">‹</a>
            <div class="tt-week">
                <strong>第 @Model.Week 周</strong>
                <span class="mini">
                    @Model.WeekStart.ToString("MM-dd") ～ @Model.WeekStart.AddDays(6).ToString("MM-dd")
                    · <a class="tt-sem-link" href="/Courses/Semesters" title="切换或管理学期">@Model.CurrentSemester.Name ›</a>
                </span>
            </div>
            <a class="tt-arrow" href="/Courses?week=@(Model.Week + 1)" aria-label="下一周">›</a>
            @if (Model.Week != Model.CurrentWeek)
            {
                <a class="tt-back" href="/Courses">回到本周</a>
            }
        </div>
        <div class="tt-head-side">
            @* 截图导入：跳到 AI 页并带上提示，用户在那边选一张课表截图，AI 生成「导入 N 条」建议卡 *@
            <a class="tt-icon-btn" href="/Ai?hint=courses" title="从截图导入" aria-label="从截图导入">@Html.Raw(Icons.Svg("spark", 18))</a>
            <a class="tt-icon-btn" href="/Courses/Settings" title="课表设置" aria-label="课表设置">@Html.Raw(Icons.Svg("settings-2", 18))</a>
            @* 手机上右下角有浮动加号，顶部再放一个是重复入口；桌面没有 FAB，所以要留 *@
            <a class="tt-icon-btn primary tt-pc-only" href="/Courses/New" title="添加课程" aria-label="添加课程">@Html.Raw(Icons.Svg("plus", 18))</a>
        </div>
    </div>
</div>

<div class="card tt-board">
    @* 一张网格通吃桌面与手机：左侧节次（节号 + 起止时间）+ 七天列。
       以前桌面走「大节 × 星期」表格、手机走网格，两套渲染两套逻辑 ——
       表格那套把相邻两小节配成一大节来拼时段，作息一改时间就全错，和 App 对不上。 *@

    <div class="ttm">
      <div class="ttm-scroll">
        <div class="ttm-head">
            <div class="ttm-corner" aria-hidden="true"></div>
            @for (var d = 0; d < IndexModel.DayCount; d++)
            {
                var date = Model.WeekStart.AddDays(d);
                var isToday = date == Model.Today;
                <div class="ttm-dhead @(isToday ? "today" : "")">
                    <b>@dayNames[d]</b>
                    <span>@date.ToString("MM-dd")</span>
                </div>
            }
        </div>
        <div class="ttm-body">
            <div class="ttm-gutter">
                @for (var p = 0; p < Model.Periods.Count; p++)
                {
                    <div class="ttm-gcell">
                        <b>@(p + 1)</b>
                        <span>@Model.Periods[p].Start</span>
                        <span>@Model.Periods[p].End</span>
                    </div>
                }
            </div>
            @for (var d = 0; d < IndexModel.DayCount; d++)
            {
                var date = Model.WeekStart.AddDays(d);
                var isToday = date == Model.Today;
                <div class="ttm-day @(isToday ? "today" : "")">
                    @foreach (var g in Model.DayGrid[d])
                    {
                        <a class="ttm-card cs-@g.Color @(g.OffWeek ? "off-week" : "")"
                           style="top:calc(var(--ttm-row) * @g.Row + 2px);height:calc(var(--ttm-row) * @g.Span - 4px);left:@(g.Lane * 100.0 / g.Lanes)%;width:@(100.0 / g.Lanes)%"
                           href="/Courses/Edit/@g.Id" title="@g.Name@(g.OffWeek ? "（本周不上）" : "")">
                            <b>@g.Name</b>
                            @if (!string.IsNullOrWhiteSpace(g.Location))
                            {
                                <span>@g.Location</span>
                            }
                        </a>
                    }
                </div>
            }
        </div>
      </div>
    </div>

    @if (Model.ThisWeekCount == 0)
    {
        <div class="hint" style="margin-top:10px;">
            @(Model.Week == Model.CurrentWeek ? "本周没有课" : $"第 {Model.Week} 周没有课")
        </div>
    }
</div>

@* ---- 手机右下浮动添加（参考课程格子 APP） ---- *@
<a class="ttm-fab" href="/Courses/New" aria-label="添加课程">@Html.Raw(Icons.Svg("plus", 22))</a>

<script>
    // 打开课表就把「今天」那一列滚进视野。
    // 窄屏上 7 列是横滑的，默认停在周一 —— 周三有课也要先往右划两下才看得见，
    // 而「今天上什么」才是打开课表最想看的。节次列是吸左的，所以要扣掉它的宽度再留一点余量。
    (function () {
        var scroll = document.querySelector('.ttm-scroll');
        if (!scroll || scroll.scrollWidth <= scroll.clientWidth) return;
        var head = scroll.querySelector('.ttm-dhead.today');
        if (!head) return;
        var corner = scroll.querySelector('.ttm-corner');
        var gutter = corner ? corner.getBoundingClientRect().width : 0;
        var colW = head.getBoundingClientRect().width || 78;

        // 让今天那列停在「第二节次列」的位置：左边留出一列（通常是昨天），
        // 右边还能看到后面两天。贴死最左边的话周一的课会被推出视野，反而看不到「昨天上了什么」。
        function locate() {
            var sr = scroll.getBoundingClientRect();
            var hr = head.getBoundingClientRect();
            var delta = (hr.left - sr.left) - gutter - colW;
            if (Math.abs(delta) > 2) scroll.scrollLeft = Math.max(0, scroll.scrollLeft + delta);
        }
        locate();
        // web font / 异步布局会让宽度晚一步确定，再补一次；用户已经开始滑就不动他了
        setTimeout(locate, 120);
    })();
</script>
