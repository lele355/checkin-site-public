@page
@model CheckinApp.Pages.Courses.NewModel
@{
    ViewData["Title"] = "添加课程";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>添加课程</h2>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        <div class="field">
            <label>课程名称</label>
            <input asp-for="Name" required autocomplete="off" placeholder="如：机械 CAD" />
        </div>
        <div class="field">
            <label>老师</label>
            <input asp-for="Teacher" autocomplete="off" placeholder="可留空" />
        </div>
        <div class="field">
            <label>地点</label>
            <input asp-for="Location" autocomplete="off" placeholder="如：教 5-301" />
        </div>
        <div class="field">
            <label>星期</label>
            <select asp-for="Weekday">
                @for (var i = 1; i <= 7; i++)
                {
                    <option value="@i" selected="@(i == Model.Weekday ? "selected" : null)">周@("一二三四五六日"[i - 1])</option>
                }
            </select>
        </div>
        <div class="field">
            <label>开始节次</label>
            <select asp-for="StartPeriod">
                @for (var i = 1; i <= Model.PeriodCount; i++)
                {
                    <option value="@i" selected="@(i == Model.StartPeriod ? "selected" : null)">第 @i 节</option>
                }
            </select>
        </div>
        <div class="field">
            <label>结束节次</label>
            <select asp-for="EndPeriod">
                @for (var i = 1; i <= Model.PeriodCount; i++)
                {
                    <option value="@i" selected="@(i == Model.EndPeriod ? "selected" : null)">第 @i 节</option>
                }
            </select>
        </div>
        <div class="field">
            <label>上课周次</label>
            <input asp-for="WeeksText" autocomplete="off" placeholder="如 1-16 / 1-8,10-16 / 单周 / 双周" />
        </div>
        <div class="field">
            <label>课程类别</label>
            <select asp-for="Category">
                <option value="required" selected="@(Model.Category == "required" ? "selected" : null)">必修课</option>
                <option value="college" selected="@(Model.Category == "college" ? "selected" : null)">院级选修课</option>
                <option value="school" selected="@(Model.Category == "school" ? "selected" : null)">校级选修课</option>
                <option value="other" selected="@(Model.Category == "other" ? "selected" : null)">其它</option>
            </select>
        </div>
        @* 新建时默认「自动」：颜色跟着课程名走，同名课（周一理论 / 周三实验）自动同色，
           一门课加第二次不用再去挑一次颜色。 *@
        <div class="field">
            <label>卡片颜色</label>
            <div class="cc-swatches" id="ccSwatches" data-auto="violet">
                <label class="cc-swatch on" title="自动（按课程名分配）" data-key="auto">
                    <span class="cc-dot"></span>
                    <input type="radio" name="Color" value="" checked />
                </label>
                @foreach (var (key, label) in CoursePalette.All)
                {
                    <label class="cc-swatch cs-@key" title="@label" data-key="@key">
                        <span class="cc-dot"></span>
                        <input type="radio" name="Color" value="@key" />
                    </label>
                }
            </div>
            <p class="cc-hint">默认自动：同名课程自动同色，一门课加第二次不用重新挑颜色。</p>
            <div class="cc-preview cs-violet" id="ccPreview">
                <span>@(string.IsNullOrWhiteSpace(Model.Name) ? "课程名" : Model.Name)</span>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
            <a class="btn secondary" href="/Courses">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>
</div>

<script>
    // 选色即时反馈（与编辑页同一套逻辑）
    (function () {
        var box = document.getElementById('ccSwatches');
        var prev = document.getElementById('ccPreview');
        if (!box) return;
        box.addEventListener('change', function (ev) {
            if (ev.target.name !== 'Color') return;
            var picked = ev.target.closest('.cc-swatch');
            [].forEach.call(box.querySelectorAll('.cc-swatch'), function (el) {
                el.classList.toggle('on', el === picked);
            });
            if (prev && picked) {
                var key = picked.dataset.key === 'auto' ? box.dataset.auto : picked.dataset.key;
                prev.className = 'cc-preview cs-' + key;
            }
        });
    })();
</script>
