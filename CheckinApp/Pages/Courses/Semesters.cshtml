@page
@model CheckinApp.Pages.Courses.SemestersModel
@{
    ViewData["Title"] = "学期管理";
}

<div class="card" style="max-width:620px;margin:2vh auto 0;">
    <div class="page-head">
        <h2>学期管理</h2>
        <div class="head-actions">
            <a class="btn secondary" href="/Courses">@Html.Raw(Icons.Svg("arrow-left", 16)) 返回课表</a>
        </div>
    </div>
    <p class="hint" style="margin-top:6px;">
        每个学期各自有一份课表和起始日。切换学期只改「现在看哪一学期」，不会动数据；
        删除学期会<b>连带删掉它下面的课程</b>，删之前想清楚。
    </p>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <div class="sem-list">
        @foreach (var s in Model.Rows)
        {
            <div class="sem-row @(s.IsCurrent ? "on" : "")">
                <div class="sem-main">
                    <div class="sem-name">
                        @s.Name
                        @if (s.IsCurrent)
                        {
                            <span class="sem-badge">当前</span>
                        }
                    </div>
                    <div class="mini">
                        @s.StartDate.ToString("yyyy年M月d日") 起 · @s.CourseCount 门课
                    </div>
                </div>
                <div class="sem-acts">
                    @if (!s.IsCurrent)
                    {
                        <form method="post" asp-page-handler="Switch">
                            <input type="hidden" name="id" value="@s.Id" />
                            <button class="btn secondary" type="submit">切换</button>
                        </form>
                    }
                    <details class="sem-edit">
                        <summary class="btn secondary">改名</summary>
                        <form method="post" asp-page-handler="Rename" class="sem-edit-form">
                            <input type="hidden" name="id" value="@s.Id" />
                            <input name="name" value="@s.Name" maxlength="20" placeholder="学期名" />
                            <input type="date" name="start" value="@s.StartDate.ToString("yyyy-MM-dd")" />
                            <button class="btn" type="submit">保存</button>
                        </form>
                    </details>
                    <form method="post" asp-page-handler="Delete" data-confirm="确认删除这个学期">
                        <input type="hidden" name="id" value="@s.Id" />
                        <button class="btn danger" type="submit">删除</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="sem-new">
        <div class="cs-block-head" style="margin-bottom:8px;">
            <b>新建学期</b>
            <span class="mini">起始日填开学第一周任意一天，会自动对齐到那周的周一</span>
        </div>
        <form method="post" asp-page-handler="Create" class="cs-inline">
            <input name="name" placeholder="2027 春（留空自动命名）" maxlength="20" style="flex:1;min-width:120px;" />
            <input type="date" name="start" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("plus", 16)) 新建</button>
        </form>
    </div>
</div>
