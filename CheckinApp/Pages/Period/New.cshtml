@page
@model CheckinApp.Pages.Period.NewModel
@{
    ViewData["Title"] = "记录一次";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>记录一次</h2>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        @if (Model.Members.Count > 1)
        {
            <div class="field">
                <label>记录归属（情侣互见，可给对方记）</label>
                <select asp-for="OwnerUid">
                    @foreach (var m in Model.Members)
                    {
                        <option value="@m.Uid">@m.Name</option>
                    }
                </select>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="OwnerUid" />
        }
        <div class="field">
            <label>开始日期</label>
            <input asp-for="StartDate" type="date" required />
        </div>
        <div class="field">
            <label>结束日期（可后补）</label>
            <input asp-for="EndDate" type="date" />
        </div>
        <div class="field">
            <label>备注</label>
            <input asp-for="Note" autocomplete="off" placeholder="可留空" />
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
            <a class="btn secondary" href="/Period">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>
</div>
