@page "{id:int}"
@model CheckinApp.Pages.Period.EditModel
@{
    ViewData["Title"] = "编辑记录";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>编辑记录</h2>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label>开始日期</label>
            <input asp-for="StartDate" type="date" required />
        </div>
        <div class="field">
            <label>结束日期（可后补）</label>
            <input asp-for="EndDate" type="date" />
        </div>
        <div class="field">
            <label>备注</label>
            <input asp-for="Note" autocomplete="off" />
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
            <a class="btn secondary" href="/Period">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>

    <hr class="rule" />
    <form method="post" asp-page-handler="Delete" data-confirm="确认删除" class="danger-row">
        <input type="hidden" name="id" value="@Model.Id" />
        <button class="btn danger" type="submit">@Html.Raw(Icons.Svg("trash-2", 16)) 删除记录</button>
    </form>
</div>
