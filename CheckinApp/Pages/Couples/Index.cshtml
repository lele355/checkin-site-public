@page
@model CheckinApp.Pages.Couples.IndexModel
@inject CheckinApp.Services.CurrentUser Me
@{
    ViewData["Title"] = "情侣空间";
}
<div class="card couples-hero" style="padding:16px 16px 18px;">
    <div class="mini" style="letter-spacing:2px;">💕 @Model.Setting.Title</div>
    <div class="couples-days" style="margin:4px 0;">
        <span class="num" style="font-size:42px;">@Model.DaysTogether</span>
        <span class="unit">天</span>
    </div>
    <div class="hint">从 @Model.Setting.StartDate.ToString("yyyy年M月d日") 起，一直在一起。</div>
    @if (Model.NextAnniversary is var na && na is not null)
    {
        <div class="chip" style="margin-top:8px;background:var(--accent-soft);color:var(--accent-strong);">
            距「@na.Value.Title」还有 @na.Value.DaysLeft 天
        </div>
    }
</div>

@* 今日心情（2026-11-02 站主定：原小纸条位置） *@
<div class="card">
    <div class="group-head">今日心情 <a class="mini" style="float:right;text-decoration:none;" href="/Mood">日历 →</a></div>
    <div style="display:flex;gap:22px;align-items:center;">
        @foreach (var tm in Model.TodayMoods)
        {
            <div style="text-align:center;">
                @if (tm.Mood is int m)
                {
                    @Html.Raw(CheckinApp.Ui.MoodStickers.Svg(m, tm.Round, 52))
                }
                else
                {
                    <a href="/Mood" style="text-decoration:none;display:block;width:52px;height:52px;line-height:52px;border:2px dashed #EADFCB;border-radius:14px;color:#C9B08A;font-size:22px;">＋</a>
                }
                <div class="mini" style="margin-top:4px;">@tm.Name</div>
            </div>
        }
    </div>
</div>

@* 双方经期速览（情侣互见） *@
@if (Model.PeriodPeeks.Count > 0)
{
    <div class="card">
        <div class="group-head">经期速览</div>
        <div class="stack">
            @foreach (var pk in Model.PeriodPeeks)
            {
                <div class="row-item" style="display:flex;align-items:center;gap:12px;">
                    <div style="flex:1;">
                        <div style="font-weight:600;">@pk.Name</div>
                        <div class="mini">
                            @if (pk.Enough && pk.Next is DateTime pn)
                            {
                                <span>预计下次 @pn.ToString("M月d日")（@(pk.DaysLeft >= 0 ? $"还有 {pk.DaysLeft} 天" : $"已推迟 {-pk.DaysLeft} 天")）</span>
                            }
                            else
                            {
                                <span>记录满两次后显示预测</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* 小纸条已独立成页（2026-11-02 站主定），这里留快捷入口 *@
<div class="card" style="padding:12px 16px;">
    <a href="/LoveNotes" style="text-decoration:none;display:flex;align-items:center;gap:8px;">
        <span style="font-size:18px;">💌</span>
        <span style="font-weight:600;">小纸条</span>
        <span class="mini" style="margin-left:auto;">写一张 →</span>
    </a>
</div>

<div class="card">
    <h2>⚙️ 空间设置</h2>
    <form method="post" asp-page-handler="SaveSetting" style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
        <div class="field" style="flex:1;min-width:180px;margin:0;">
            <label>标题</label>
            <input asp-for="SettingTitle" required autocomplete="off" />
        </div>
        <div class="field" style="margin:0;">
            <label>在一起的日期</label>
            <input asp-for="SettingStartDate" type="date" required />
        </div>
        <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
    </form>
</div>
