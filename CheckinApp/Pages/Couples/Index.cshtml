@page
@model CheckinApp.Pages.Couples.IndexModel
@inject CheckinApp.Services.CurrentUser Me
@{
    ViewData["Title"] = "情侣空间";
}
<div class="card couples-hero">
    <div class="mini" style="letter-spacing:2px;">💕 @Model.Setting.Title</div>
    <div class="couples-days">
        <span class="num">@Model.DaysTogether</span>
        <span class="unit">天</span>
    </div>
    <div class="hint">从 @Model.Setting.StartDate.ToString("yyyy年M月d日") 起，一直在一起。</div>
    @if (Model.NextAnniversary is var na && na is not null)
    {
        <div class="chip" style="margin-top:10px;background:var(--accent-soft);color:var(--accent-strong);">
            距「@na.Value.Title」还有 @na.Value.DaysLeft 天
        </div>
    }
</div>

@* 情侣大类快捷入口（2026-11-02 站主规划） *@
<div class="card">
    <div class="group-head">情侣功能</div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a class="chip" style="text-decoration:none;padding:10px 16px;" href="/Period">🌸 经期</a>
        <span class="chip" style="padding:10px 16px;opacity:.5;">😊 心情（即将上线）</span>
        <span class="chip" style="padding:10px 16px;opacity:.5;">💩 排便（即将上线）</span>
        <span class="chip" style="padding:10px 16px;opacity:.5;">❓ 提问（即将上线）</span>
        <span class="chip" style="padding:10px 16px;opacity:.5;">📊 月度总结（即将上线）</span>
    </div>
</div>

@* 双方经期速览（情侣互见） *@
@if (Model.PeriodPeeks.Count > 0)
{
    <div class="card">
        <div class="group-head">经期速览</div>
        <div class="stack">
            @foreach (var pk in Model.PeriodPeeks)
            {
                <div class="row-item" style="display:flex;align-items:center;gap:12px;">
                    <div style="flex:1;">
                        <div style="font-weight:600;">@pk.Name</div>
                        <div class="mini">
                            @if (pk.Enough && pk.Next is DateTime pn)
                            {
                                <span>预计下次 @pn.ToString("M月d日")（@(pk.DaysLeft >= 0 ? $"还有 {pk.DaysLeft} 天" : $"已推迟 {-pk.DaysLeft} 天")）</span>
                            }
                            else
                            {
                                <span>记录满两次后显示预测</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="card">
    <div class="page-head">
        <h2>小纸条</h2>
    </div>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post" asp-page-handler="Note" class="inline-form">
        <input asp-for="NoteContent" placeholder="写点什么给对方…" autocomplete="off" />
        <button class="btn" type="submit">送出</button>
    </form>

    <div class="stack" style="margin-top:16px;">
        @foreach (var n in Model.Notes)
        {
            <div class="row-item" style="display:flex;align-items:flex-start;gap:10px;">
                <div style="flex-shrink:0;width:34px;height:34px;border-radius:50%;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:600;color:var(--accent-strong);">
                    @(string.IsNullOrEmpty(n.FromUser?.DisplayName) ? "?" : n.FromUser!.DisplayName.Substring(0, 1))
                </div>
                <div style="flex:1;min-width:0;">
                    <div class="mini">@n.FromUser?.DisplayName · @CheckinApp.Services.SiteClock.ToLocal(n.CreatedAt).ToString("M月d日 HH:mm")</div>
                    <div style="white-space:pre-wrap;margin-top:2px;">@n.Content</div>
                </div>
                @if (n.FromUserId == Me.UserId)
                {
                    <form method="post" asp-page-handler="DeleteNote">
                        <input type="hidden" name="id" value="@n.Id" />
                        <button class="mini" type="submit" style="border:none;background:none;cursor:pointer;color:var(--text-muted);">删除</button>
                    </form>
                }
            </div>
        }
        @if (Model.Notes.Count == 0)
        {
            <div class="empty"><span class="big">💌</span>还没有小纸条</div>
        }
    </div>
</div>

<div class="card">
    <h2>⚙️ 空间设置</h2>
    <form method="post" asp-page-handler="SaveSetting" style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
        <div class="field" style="flex:1;min-width:180px;margin:0;">
            <label>标题</label>
            <input asp-for="SettingTitle" required autocomplete="off" />
        </div>
        <div class="field" style="margin:0;">
            <label>在一起的日期</label>
            <input asp-for="SettingStartDate" type="date" required />
        </div>
        <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
    </form>
</div>
