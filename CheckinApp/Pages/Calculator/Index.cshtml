@page
@model CheckinApp.Pages.Calculator.IndexModel
@{
    ViewData["Title"] = "计算器";
}
<div class="card">
    <div class="page-head">
        <h2>计算器</h2>
        <div class="view-switch" data-viewkey="calc">
            <button type="button" class="vs-btn on" data-view="simple">简单</button>
            <button type="button" class="vs-btn" data-view="science">科学</button>
            <button type="button" class="vs-btn" data-view="matrix">矩阵</button>
        </div>
    </div>
</div>

<div class="card" id="calc-simple">
    <div style="text-align:right;font-size:1.1rem;color:var(--text-sub);min-height:1.4em;" id="s-expr"></div>
    <div style="text-align:right;font-size:2rem;font-weight:600;word-break:break-all;" id="s-display">0</div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px;">
        <button type="button" class="btn secondary" data-k="ac">AC</button>
        <button type="button" class="btn secondary" data-k="neg">±</button>
        <button type="button" class="btn secondary" data-k="pct">%</button>
        <button type="button" class="btn" data-op="÷">÷</button>
        <button type="button" class="btn secondary" data-d="7">7</button>
        <button type="button" class="btn secondary" data-d="8">8</button>
        <button type="button" class="btn secondary" data-d="9">9</button>
        <button type="button" class="btn" data-op="×">×</button>
        <button type="button" class="btn secondary" data-d="4">4</button>
        <button type="button" class="btn secondary" data-d="5">5</button>
        <button type="button" class="btn secondary" data-d="6">6</button>
        <button type="button" class="btn" data-op="-">−</button>
        <button type="button" class="btn secondary" data-d="1">1</button>
        <button type="button" class="btn secondary" data-d="2">2</button>
        <button type="button" class="btn secondary" data-d="3">3</button>
        <button type="button" class="btn" data-op="+">+</button>
        <button type="button" class="btn secondary" data-d="0" style="grid-column:span 2;">0</button>
        <button type="button" class="btn secondary" data-d=".">.</button>
        <button type="button" class="btn" data-k="eq">=</button>
    </div>
</div>

<div class="card" id="calc-science" style="display:none;">
    <div style="display:flex;align-items:center;gap:8px;">
        <button type="button" class="btn secondary" id="e-deg" style="padding:4px 10px;font-size:.75rem;">DEG</button>
        <span class="hint" id="e-ans" style="margin:0;">Ans = 0</span>
    </div>
    <input id="e-expr" class="field" style="width:100%;font-size:1.15rem;text-align:right;margin-top:8px;" placeholder="输入表达式，如 2×sin(30)+3^2" autocomplete="off" />
    <div id="e-result" style="text-align:right;font-size:1.6rem;font-weight:600;color:var(--accent);min-height:1.7em;word-break:break-all;"></div>
    <div id="e-error" style="text-align:right;font-size:.8rem;color:var(--text-weak);min-height:1.1em;"></div>
    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-top:8px;" id="e-keys"></div>
</div>

<div class="card" id="calc-matrix" style="display:none;">
    <div class="page-head" style="margin-bottom:8px;">
        <h2 style="font-size:1rem;">阶数</h2>
        <div>
            <button type="button" class="btn secondary m-n on" data-n="2">2×2</button>
            <button type="button" class="btn secondary m-n" data-n="3">3×3</button>
            <button type="button" class="btn secondary m-n" data-n="4">4×4</button>
        </div>
    </div>
    <p class="hint" style="margin:4px 0;">矩阵 A</p>
    <div id="m-a"></div>
    <p class="hint" style="margin:10px 0 4px;">矩阵 B</p>
    <div id="m-b"></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;">
        <button type="button" class="btn secondary" data-m="add">A+B</button>
        <button type="button" class="btn secondary" data-m="sub">A−B</button>
        <button type="button" class="btn secondary" data-m="mul">A×B</button>
        <button type="button" class="btn secondary" data-m="det">det(A)</button>
        <button type="button" class="btn secondary" data-m="inv">A⁻¹</button>
        <button type="button" class="btn secondary" data-m="tr">Aᵀ</button>
    </div>
    <div id="m-out"></div>
</div>

<script>
(function () {
    'use strict';

    // ---------- 视图切换 ----------
    document.querySelectorAll('.view-switch[data-viewkey="calc"] .vs-btn').forEach(function (b) {
        b.addEventListener('click', function () {
            document.querySelectorAll('.view-switch[data-viewkey="calc"] .vs-btn').forEach(function (x) { x.classList.remove('on'); });
            b.classList.add('on');
            ['simple', 'science', 'matrix'].forEach(function (v) {
                document.getElementById('calc-' + v).style.display = v === b.dataset.view ? '' : 'none';
            });
        });
    });

    // ---------- 简单计算器（手机式立即计算） ----------
    var sDisp = '0', sAcc = null, sOp = null, sWait = true, sExpr = '';
    function sRender() {
        document.getElementById('s-display').textContent = sDisp;
        document.getElementById('s-expr').textContent = sExpr;
    }
    function sFmt(v) {
        if (!isFinite(v)) return '不能除以 0';
        if (Math.floor(v) === v && Math.abs(v) < 1e15) return String(v);
        return String(parseFloat(v.toFixed(10)));
    }
    function sApply(op, a, b) {
        return op === '+' ? a + b : op === '-' ? a - b : op === '×' ? a * b : (b === 0 ? NaN : a / b);
    }
    function sDigit(d) {
        if (sWait) { sDisp = d === '.' ? '0.' : d; sWait = false; }
        else {
            if (d === '.' && sDisp.indexOf('.') >= 0) return;
            sDisp = (sDisp === '0' && d !== '.') ? d : sDisp + d;
        }
        sRender();
    }
    function sOperator(o) {
        var cur = parseFloat(sDisp) || 0;
        if (sOp !== null && !sWait) { sAcc = sApply(sOp, sAcc || 0, cur); sDisp = sFmt(sAcc); }
        else sAcc = cur;
        sOp = o; sWait = true; sExpr = sFmt(sAcc) + ' ' + o;
        sRender();
    }
    function sEquals() {
        if (sOp === null) return;
        var cur = parseFloat(sDisp) || 0;
        sExpr = sFmt(sAcc) + ' ' + sOp + ' ' + sFmt(cur) + ' =';
        var r = sApply(sOp, sAcc || 0, cur);
        sDisp = sFmt(r); sAcc = r; sOp = null; sWait = true;
        sRender();
    }
    document.querySelectorAll('#calc-simple [data-d]').forEach(function (b) {
        b.addEventListener('click', function () { sDigit(b.dataset.d); });
    });
    document.querySelectorAll('#calc-simple [data-op]').forEach(function (b) {
        b.addEventListener('click', function () { sOperator(b.dataset.op); });
    });
    document.querySelector('#calc-simple [data-k="ac"]').addEventListener('click', function () {
        sDisp = '0'; sAcc = null; sOp = null; sWait = true; sExpr = ''; sRender();
    });
    document.querySelector('#calc-simple [data-k="neg"]').addEventListener('click', function () {
        if (sDisp !== '0') sDisp = sDisp.charAt(0) === '-' ? sDisp.slice(1) : '-' + sDisp;
        sRender();
    });
    document.querySelector('#calc-simple [data-k="pct"]').addEventListener('click', function () {
        sDisp = sFmt((parseFloat(sDisp) || 0) / 100); sWait = true; sRender();
    });
    document.querySelector('#calc-simple [data-k="eq"]').addEventListener('click', sEquals);

    // ---------- 科学计算器（对齐 App 端 CalcEngine：分词 → 调度场 → RPN） ----------
    var FUNCS = {
        sin: 1, cos: 1, tan: 1, asin: 1, acos: 1, atan: 1,
        sinh: 1, cosh: 1, tanh: 1, asinh: 1, acosh: 1, atanh: 1,
        ln: 1, log: 1, sqrt: 1, cbrt: 1, abs: 1, floor: 1, ceil: 1, exp: 1
    };
    var eDeg = true, eAns = 0;

    function tokenize(s, ans) {
        s = s.replace(/×/g, '*').replace(/÷/g, '/').replace(/−/g, '-');
        var out = [], i = 0;
        while (i < s.length) {
            var c = s[i];
            if (/\s/.test(c)) { i++; continue; }
            if (c === '(') { out.push({ t: 'lp' }); i++; continue; }
            if (c === ')') { out.push({ t: 'rp' }); i++; continue; }
            if (c === '+' || c === '-') {
                var last = out.length ? out[out.length - 1] : null;
                var unary = !last || last.t === 'lp' || last.t === 'op';
                out.push(unary ? { t: 'un', c: c } : { t: 'op', c: c });
                i++; continue;
            }
            if (c === '*' || c === '/' || c === '^') { out.push({ t: 'op', c: c }); i++; continue; }
            if (c === 'V' || c === 'P' || c === 'C') { out.push({ t: 'op', c: c }); i++; continue; }
            if (c === '%' || c === '!') { out.push({ t: 'post', c: c }); i++; continue; }
            if (c === '\u207B') { out.push({ t: 'post', c: 'r' }); i++; if (s[i] === '\u00B9') i++; continue; }
            if (/[0-9.]/.test(c)) {
                var start = i;
                while (i < s.length && /[0-9.eE]/.test(s[i])) {
                    if ((s[i] === 'e' || s[i] === 'E') && i + 1 < s.length && /[0-9+\-]/.test(s[i + 1])) i++;
                    else if (s[i] === 'e' || s[i] === 'E') break;
                    else i++;
                }
                var v = parseFloat(s.substring(start, i));
                if (isNaN(v)) throw new Error('数字格式不对');
                out.push({ t: 'num', v: v });
                continue;
            }
            if (/[a-z\u207B\u00B9]/i.test(c)) {
                var st = i;
                while (i < s.length && (/[a-z]/i.test(s[i]) || s[i] === '\u207B' || s[i] === '\u00B9')) i++;
                var raw = s.substring(st, i);
                var inv = /\u207B/.test(raw);
                var name = raw.replace(/\u207B\u00B9?$/, '').toLowerCase();
                if (name === 'pi' || name === 'p') { out.push({ t: 'num', v: Math.PI }); continue; }
                if (name === 'e') { out.push({ t: 'num', v: Math.E }); continue; }
                if (name === 'ans') { out.push({ t: 'num', v: ans }); continue; }
                if (inv && (name === 'sin' || name === 'cos' || name === 'tan')) {
                    out.push({ t: 'fn', n: 'a' + name });
                    continue;
                }
                if (inv || !(name in FUNCS)) throw new Error('不认识的函数：' + raw);
                out.push({ t: 'fn', n: name });
                continue;
            }
            throw new Error('不能识别「' + c + '」');
        }
        return out;
    }
    function prec(x) {
        if (x.t === 'un') return 4;
        if (x.t === 'op') return (x.c === '^' || x.c === 'V' || x.c === 'P' || x.c === 'C') ? 3 : 2;
        if (x.t === 'post') return 5;
        return 0;
    }
    function evalExpr(expr, ans, deg) {
        var ts = tokenize(expr, ans), out = [], st = [];
        function pop() { if (!st.length) throw new Error('表达式不完整'); return st.pop(); }
        ts.forEach(function (t) {
            if (t.t === 'num') out.push(t);
            else if (t.t === 'fn' || t.t === 'un') st.push(t);
            else if (t.t === 'post') out.push(t);
            else if (t.t === 'op') {
                while (st.length && (prec(st[st.length - 1]) > prec(t) || (prec(st[st.length - 1]) === prec(t) && t.c !== '^'))) out.push(st.pop());
                st.push(t);
            } else if (t.t === 'lp') st.push(t);
            else {
                while (st.length && st[st.length - 1].t !== 'lp') out.push(st.pop());
                if (!st.length) throw new Error('括号不配对');
                st.pop();
                if (st.length && st[st.length - 1].t === 'fn') out.push(st.pop());
            }
        });
        while (st.length) {
            if (st[st.length - 1].t === 'lp') throw new Error('括号不配对');
            out.push(st.pop());
        }
        function toRad(v) { return deg ? v * Math.PI / 180 : v; }
        function fromRad(v) { return deg ? v * 180 / Math.PI : v; }
        function nthRoot(a, b) {
            if (b === 0) throw new Error('根次不能为 0');
            if (a >= 0) return Math.pow(a, 1 / b);
            if (Math.floor(b) === b && b % 2 !== 0) return -Math.pow(-a, 1 / b);
            throw new Error('负数的偶次方根没有实数解');
        }
        function perm(n, r) {
            if (n < 0 || r < 0 || Math.floor(n) !== n || Math.floor(r) !== r) throw new Error('排列只要非负整数');
            if (r > n) throw new Error('排列 r 不能大于 n');
            var res = 1;
            for (var k = 0; k < r; k++) res *= n - k;
            return res;
        }
        function comb(n, r) {
            if (n < 0 || r < 0 || Math.floor(n) !== n || Math.floor(r) !== r) throw new Error('组合只要非负整数');
            if (r > n) throw new Error('组合 r 不能大于 n');
            var k = Math.min(r, n - r), res = 1;
            for (var i = 1; i <= k; i++) res = res * (n - k + i) / i;
            return res;
        }
        var rs = [];
        out.forEach(function (t) {
            if (t.t === 'num') rs.push(t.v);
            else if (t.t === 'un') { var v = rs.pop(); rs.push(t.c === '-' ? -v : v); }
            else if (t.t === 'post') {
                var v2 = rs.pop();
                if (t.c === '%') rs.push(v2 / 100);
                else if (t.c === 'r') { if (v2 === 0) throw new Error('0 不能取倒数'); rs.push(1 / v2); }
                else {
                    if (v2 < 0 || Math.floor(v2) !== v2) throw new Error('阶乘只要非负整数');
                    if (v2 > 170) throw new Error('阶乘太大了');
                    var r2 = 1;
                    for (var k2 = 2; k2 <= v2; k2++) r2 *= k2;
                    rs.push(r2);
                }
            } else if (t.t === 'op') {
                var b = rs.pop(), a = rs.pop();
                if (t.c === '+') rs.push(a + b);
                else if (t.c === '-') rs.push(a - b);
                else if (t.c === '*') rs.push(a * b);
                else if (t.c === '/') { if (b === 0) throw new Error('不能除以 0'); rs.push(a / b); }
                else if (t.c === '^') rs.push(Math.pow(a, b));
                else if (t.c === 'V') rs.push(nthRoot(a, b));
                else if (t.c === 'P') rs.push(perm(a, b));
                else rs.push(comb(a, b));
            } else {
                var x = rs.pop(), r3;
                switch (t.n) {
                    case 'sin': r3 = Math.sin(toRad(x)); break;
                    case 'cos': r3 = Math.cos(toRad(x)); break;
                    case 'tan': r3 = Math.tan(toRad(x)); break;
                    case 'asin': if (x < -1 || x > 1) throw new Error('asin 定义域 [-1,1]'); r3 = fromRad(Math.asin(x)); break;
                    case 'acos': if (x < -1 || x > 1) throw new Error('acos 定义域 [-1,1]'); r3 = fromRad(Math.acos(x)); break;
                    case 'atan': r3 = fromRad(Math.atan(x)); break;
                    case 'sinh': r3 = Math.sinh(x); break;
                    case 'cosh': r3 = Math.cosh(x); break;
                    case 'tanh': r3 = Math.tanh(x); break;
                    case 'asinh': r3 = Math.log(x + Math.sqrt(x * x + 1)); break;
                    case 'acosh': if (x < 1) throw new Error('acosh 要求 ≥ 1'); r3 = Math.log(x + Math.sqrt(x * x - 1)); break;
                    case 'atanh': if (x <= -1 || x >= 1) throw new Error('atanh 定义域 (-1,1)'); r3 = 0.5 * Math.log((1 + x) / (1 - x)); break;
                    case 'ln': if (x <= 0) throw new Error('ln 要求大于 0'); r3 = Math.log(x); break;
                    case 'log': if (x <= 0) throw new Error('log 要求大于 0'); r3 = Math.log10(x); break;
                    case 'sqrt': if (x < 0) throw new Error('负数没有实平方根'); r3 = Math.sqrt(x); break;
                    case 'cbrt': r3 = Math.cbrt(x); break;
                    case 'abs': r3 = Math.abs(x); break;
                    case 'floor': r3 = Math.floor(x); break;
                    case 'ceil': r3 = Math.ceil(x); break;
                    case 'exp': r3 = Math.exp(x); break;
                    default: throw new Error('内部错误');
                }
                rs.push(r3);
            }
        });
        if (rs.length !== 1) throw new Error('表达式不完整');
        return rs[0];
    }
    function eFmt(v) {
        if (!isFinite(v)) throw new Error('结果无意义');
        if (Math.floor(v) === v && Math.abs(v) < 1e15) return String(v);
        return String(parseFloat(v.toFixed(10)));
    }
    // 按键区（5 列 × 10 行，对齐 App 端 82MS 键位）
    var eKeys = [
        ['DEG', 'deg'], ['Ans', 'txt:Ans'], ['π', 'txt:pi'], ['e', 'txt:e'], ['AC', 'ac'],
        ['sin', 'fn:sin('], ['cos', 'fn:cos('], ['tan', 'fn:tan('], ['(', 'txt:('], [')', 'txt:)'],
        ['sin\u207B\u00B9', 'fn:asin('], ['cos\u207B\u00B9', 'fn:acos('], ['tan\u207B\u00B9', 'fn:atan('], ['ln', 'fn:ln('], ['log', 'fn:log('],
        ['sinh', 'fn:sinh('], ['cosh', 'fn:cosh('], ['tanh', 'fn:tanh('], ['e\u02E3', 'fn:exp('], ['10\u02E3', 'txt:10^('],
        ['x\u00B2', 'txt:^2'], ['x\u00B3', 'txt:^3'], ['x\u02B8', 'txt:^'], ['\u221A', 'fn:sqrt('], ['\u221B', 'fn:cbrt('],
        ['\u207F\u221Ax', 'txt: V '], ['1/x', 'txt:\u207B\u00B9'], ['n!', 'txt:!'], ['nPr', 'txt: P '], ['nCr', 'txt: C '],
        ['7', 'txt:7'], ['8', 'txt:8'], ['9', 'txt:9'], ['\u00F7', 'txt:/'], ['DEL', 'back'],
        ['4', 'txt:4'], ['5', 'txt:5'], ['6', 'txt:6'], ['\u00D7', 'txt:*'], ['AC', 'ac'],
        ['1', 'txt:1'], ['2', 'txt:2'], ['3', 'txt:3'], ['\u2212', 'txt:-'], ['%', 'txt:%'],
        ['0', 'txt:0'], ['.', 'txt:.'], ['+', 'txt:+'], ['EXP', 'txt:\u00D710^'], ['=', 'eq']
    ];
    var eHtml = '';
    eKeys.forEach(function (k) {
        var isOp = k[0] === '=' || k[0] === '\u00F7' || k[0] === '\u00D7' || k[0] === '\u2212' || k[0] === '+';
        eHtml += '<button type="button" class="btn' + (isOp ? '' : ' secondary') + '" data-act="' + k[1] + '">' + k[0] + '</button>';
    });
    document.getElementById('e-keys').innerHTML = eHtml;
    var eInput = document.getElementById('e-expr');
    function eRenderAns() { document.getElementById('e-ans').textContent = 'Ans = ' + eFmt(eAns); }
    document.getElementById('e-deg').addEventListener('click', function () {
        eDeg = !eDeg;
        this.textContent = eDeg ? 'DEG' : 'RAD';
    });
    document.getElementById('e-keys').addEventListener('click', function (ev) {
        var b = ev.target.closest('[data-act]');
        if (!b) return;
        var act = b.dataset.act;
        if (act === 'ac') { eInput.value = ''; }
        else if (act === 'deg') {
            eDeg = !eDeg;
            document.getElementById('e-deg').textContent = eDeg ? 'DEG' : 'RAD';
        }
        else if (act === 'back') { eInput.value = eInput.value.slice(0, -1); }
        else if (act === 'eq') {
            try {
                var v = evalExpr(eInput.value, eAns, eDeg);
                eAns = v;
                document.getElementById('e-result').textContent = '= ' + eFmt(v);
                document.getElementById('e-error').textContent = '';
                eRenderAns();
            } catch (err) {
                document.getElementById('e-result').textContent = '';
                document.getElementById('e-error').textContent = err.message || '算不出来';
            }
        } else {
            eInput.value += act.indexOf('fn:') === 0 ? act.slice(3) : act.slice(4);
            document.getElementById('e-result').textContent = '';
            document.getElementById('e-error').textContent = '';
        }
    });

    // ---------- 矩阵计算器 ----------
    var mN = 2;
    function mGrid(id) {
        var html = '<div style="display:grid;grid-template-columns:repeat(' + mN + ',1fr);gap:6px;">';
        for (var i = 0; i < mN * mN; i++) {
            html += '<input class="field" style="width:100%;text-align:center;padding:6px;" value="0" data-cell="' + id + '-' + i + '" />';
        }
        return html + '</div>';
    }
    function mRender() {
        document.getElementById('m-a').innerHTML = mGrid('a');
        document.getElementById('m-b').innerHTML = mGrid('b');
    }
    function mRead(id) {
        var m = [];
        for (var i = 0; i < mN; i++) {
            var row = [];
            for (var j = 0; j < mN; j++) {
                var el = document.querySelector('[data-cell="' + id + '-' + (i * mN + j) + '"]');
                var v = parseFloat(el.value);
                if (isNaN(v)) throw new Error('第 ' + (i + 1) + ' 行第 ' + (j + 1) + ' 列不是数字');
                row.push(v);
            }
            m.push(row);
        }
        return m;
    }
    function mFmt(v) {
        if (Math.abs(v) < 1e-10) return '0';
        if (Math.floor(v) === v && Math.abs(v) < 1e15) return String(v);
        return String(parseFloat(v.toFixed(6)));
    }
    function mDet(a) {
        var n = a.length, m = a.map(function (r) { return r.slice(); }), sign = 1;
        for (var col = 0; col < n; col++) {
            var piv = col;
            for (var r = col; r < n; r++) if (Math.abs(m[r][col]) > Math.abs(m[piv][col])) piv = r;
            if (Math.abs(m[piv][col]) < 1e-12) return 0;
            if (piv !== col) { var t = m[col]; m[col] = m[piv]; m[piv] = t; sign = -sign; }
            for (var r2 = col + 1; r2 < n; r2++) {
                var f = m[r2][col] / m[col][col];
                for (var c = col; c < n; c++) m[r2][c] -= f * m[col][c];
            }
        }
        var d = sign;
        for (var i = 0; i < n; i++) d *= m[i][i];
        return d;
    }
    function mInv(a) {
        var n = a.length, m = a.map(function (r) { return r.slice(); }), id = [];
        for (var i = 0; i < n; i++) { id.push([]); for (var j = 0; j < n; j++) id[i].push(i === j ? 1 : 0); }
        for (var col = 0; col < n; col++) {
            var piv = col;
            for (var r = col; r < n; r++) if (Math.abs(m[r][col]) > Math.abs(m[piv][col])) piv = r;
            if (Math.abs(m[piv][col]) < 1e-12) throw new Error('矩阵不可逆（行列式为 0）');
            if (piv !== col) {
                var t = m[col]; m[col] = m[piv]; m[piv] = t;
                var ti = id[col]; id[col] = id[piv]; id[piv] = ti;
            }
            var div = m[col][col];
            for (var c = 0; c < n; c++) { m[col][c] /= div; id[col][c] /= div; }
            for (var r2 = 0; r2 < n; r2++) {
                if (r2 === col) continue;
                var f = m[r2][col];
                if (Math.abs(f) < 1e-15) continue;
                for (var c2 = 0; c2 < n; c2++) { m[r2][c2] -= f * m[col][c2]; id[r2][c2] -= f * id[col][c2]; }
            }
        }
        return id;
    }
    function mShow(label, mat) {
        var html = '<p class="hint" style="margin:12px 0 4px;">' + label + '</p><div style="display:grid;grid-template-columns:repeat(' + mN + ',1fr);gap:6px;">';
        mat.forEach(function (row) {
            row.forEach(function (v) {
                html += '<div style="text-align:center;padding:8px 4px;background:var(--card-soft,#f2f2f2);border-radius:8px;word-break:break-all;">' + mFmt(v) + '</div>';
            });
        });
        document.getElementById('m-out').innerHTML = html + '</div>';
    }
    document.querySelectorAll('.m-n').forEach(function (b) {
        b.addEventListener('click', function () {
            document.querySelectorAll('.m-n').forEach(function (x) { x.classList.remove('on'); });
            b.classList.add('on');
            mN = parseInt(b.dataset.n, 10);
            mRender();
            document.getElementById('m-out').innerHTML = '';
        });
    });
    document.querySelectorAll('[data-m]').forEach(function (b) {
        b.addEventListener('click', function () {
            try {
                var op = b.dataset.m, A = mRead('a');
                if (op === 'det') { mShow('det(A) =', [[mDet(A)]]); return; }
                if (op === 'inv') { mShow('A⁻¹ =', mInv(A)); return; }
                if (op === 'tr') {
                    var T = [];
                    for (var i = 0; i < mN; i++) { T.push([]); for (var j = 0; j < mN; j++) T[i].push(A[j][i]); }
                    mShow('Aᵀ =', T);
                    return;
                }
                var B = mRead('b'), R = [];
                for (var i2 = 0; i2 < mN; i2++) {
                    R.push([]);
                    for (var j2 = 0; j2 < mN; j2++) {
                        if (op === 'add') R[i2].push(A[i2][j2] + B[i2][j2]);
                        else if (op === 'sub') R[i2].push(A[i2][j2] - B[i2][j2]);
                        else {
                            var s = 0;
                            for (var k = 0; k < mN; k++) s += A[i2][k] * B[k][j2];
                            R[i2].push(s);
                        }
                    }
                }
                mShow(op === 'add' ? 'A + B =' : op === 'sub' ? 'A − B =' : 'A × B =', R);
            } catch (err) {
                document.getElementById('m-out').innerHTML = '<p class="hint" style="color:#c0392b;">' + (err.message || '算不出来') + '</p>';
            }
        });
    });
    mRender();
})();
</script>
