@page
@model CheckinApp.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "设置专属密码";
}
<div class="card" style="max-width:420px;margin:6vh auto 0;">
    <h2>设置你的专属密码</h2>
    <p class="hint">这是首次登录或管理员重置后的强制步骤，改完就能正常用了喵。</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="msg error">@string.Join(" · ", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Where(s => !string.IsNullOrEmpty(s)))</div>
    }

    <form method="post">
        <div class="field">
            <label>临时密码</label>
            <input type="password" asp-for="OldPassword" autocomplete="current-password" required />
        </div>
        <div class="field">
            <label>新密码</label>
            <input type="password" asp-for="NewPassword" autocomplete="new-password" required />
            <small class="hint" style="display:block;margin-top:4px;">至少 8 位，须同时含字母与数字</small>
        </div>
        <div class="field">
            <label>确认新密码</label>
            <input type="password" asp-for="ConfirmPassword" autocomplete="new-password" required />
        </div>
        <button class="btn block" type="submit">设置并进入</button>
    </form>
</div>
