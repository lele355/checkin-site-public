@page
@model CheckinApp.Pages.Stats.IndexModel
@{
    ViewData["Title"] = "统计";
}
<div class="card">
    <div class="page-head">
        <h2>统计</h2>
    </div>

    <div class="stat-chips">
        <span class="chip">日程 @Model.ScheduleCount</span>
        <span class="chip">备忘 @Model.MemoCount</span>
        <span class="chip">课程 @Model.CourseCount</span>
        <span class="chip">留言 @Model.BoardCount</span>
        <span class="chip">累计打卡 @Model.CheckinTotal 次</span>
    </div>
</div>

<div class="card">
    <h2>🔥 打卡热力图（近 90 天）</h2>
    <div class="heatmap" role="img" aria-label="近 90 天打卡热力图">
        @foreach (var (date, count) in Model.Heat)
        {
            var level = count == 0 ? 0 : count == 1 ? 1 : count == 2 ? 2 : count <= 4 ? 3 : 4;
            <span class="heat-cell lv@(level)" title="@date.ToString("M月d日")：@count 次"></span>
        }
    </div>
    <div class="hm-legend">
        少 <span class="heat-cell lv0"></span><span class="heat-cell lv1"></span><span class="heat-cell lv2"></span><span class="heat-cell lv3"></span><span class="heat-cell lv4"></span> 多
    </div>
</div>

<div class="card">
    <h2>🏆 打卡排行</h2>
    @if (Model.TopHabits.Count == 0)
    {
        <p class="hint">还没有打卡数据。</p>
    }
    else
    {
        <div class="bar-list">
            @{ var max = Model.TopHabits[0].Total; }
            @foreach (var (name, icon, total) in Model.TopHabits)
            {
                <div class="bar-row">
                    <div class="bar-head">
                        <span class="bar-label">@icon @name</span><span class="bar-val">@total 次</span>
                    </div>
                    <div class="bar-track"><div class="bar-fill" style="width:@(max == 0 ? 0 : total * 100 / max)%;"></div></div>
                </div>
            }
        </div>
    }
</div>

<div class="card">
    <h2>💸 月度支出（近 6 个月）</h2>
    @if (Model.MaxMonthOut == 0)
    {
        <p class="hint">还没有记账数据。</p>
    }
    else
    {
        <div class="month-bars">
            @foreach (var (month, outSum) in Model.MonthExpense)
            {
                var h = outSum == 0 ? 3 : (int)Math.Max(6, (double)(outSum / Model.MaxMonthOut) * 120);
                <div class="month-bar-col">
                    <div class="mb-val">¥@outSum.ToString("0")</div>
                    <div class="month-bar" style="height:@(h)px;"></div>
                    <div class="mb-name">@month</div>
                </div>
            }
        </div>
    }
</div>
