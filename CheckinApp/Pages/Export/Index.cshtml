@page
@model CheckinApp.Pages.Export.IndexModel
@{
    ViewData["Title"] = "数据导出";
}
<div class="card">
    <div class="page-head">
        <h2>数据导出</h2>
    </div>
    <p class="hint" style="margin-top:6px;">把你的数据打包成 JSON 文件带走。导出文件不含密码信息，可以放心保存。</p>

    <div class="stack" style="margin-top:16px;">
        <div class="row-item" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
            <div style="flex:1;min-width:200px;">
                <div style="font-weight:600;">导出我的数据</div>
                <div class="mini">日程、备忘、打卡、课程、纪念日、记账、经期、留言、小纸条</div>
            </div>
            <a class="btn" href="/Export?handler=Mine">下载 JSON</a>
        </div>
        @if (Model.IsAdmin)
        {
            <div class="row-item" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <div style="flex:1;min-width:200px;">
                    <div style="font-weight:600;">全站备份（管理员）</div>
                    <div class="mini">所有用户的所有数据 + 角色配置（不含密码哈希）</div>
                </div>
                <a class="btn" href="/Export?handler=All">下载 JSON</a>
            </div>
        }
    </div>
</div>
