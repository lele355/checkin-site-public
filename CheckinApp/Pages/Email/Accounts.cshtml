@page
@model CheckinApp.Pages.Email.AccountsModel
@{
    ViewData["Title"] = "邮箱账号";
}
<div class="card">
    <div class="page-head">
        <h2>邮箱账号</h2>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <form method="post" asp-page-handler="Sync">
                <button class="btn secondary" type="submit">@Html.Raw(Icons.Svg("rotate-ccw", 16)) 同步全部</button>
            </form>
            <a class="btn" href="/Email/New">@Html.Raw(Icons.Svg("plus", 16)) 绑定新邮箱</a>
        </div>
    </div>
    <p class="hint" style="margin-top:8px;">授权码（不是登录密码！）在邮箱设置里开启 IMAP 后生成，本站只存加密后的密文。</p>
</div>

@if (!string.IsNullOrEmpty(Model.Note))
{
    <div class="msg">@Model.Note</div>
}

@if (Model.Accounts.Count == 0)
{
    <div class="card"><div class="empty"><span class="big">🔐</span>还没有绑定邮箱。QQ / 163 / Gmail / Outlook 都支持，点右上角「绑定新邮箱」开始吧。</div></div>
}
else
{
    <div class="card" style="padding:0;overflow:hidden;">
        <div class="stack">
            @foreach (var a in Model.Accounts)
            {
                <div class="row-item" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                    <div style="width:36px;height:36px;border-radius:10px;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;flex-shrink:0;">@Html.Raw(Icons.Svg("mail", 18))</div>
                    <div style="flex:1;min-width:180px;">
                        <div style="font-weight:600;">@a.DisplayName <span class="chip">@Services.EmailProviders.LabelOf(a.Provider)</span></div>
                        <div class="mini">@a.Address · @a.ImapHost:@a.ImapPort</div>
                    </div>
                    <div style="flex:1;min-width:160px;">
                        @if (a.LastSyncAt is DateTime t)
                        {
                            <div class="mini">上次同步：@t.ToLocalTime().ToString("MM-dd HH:mm")</div>
                        }
                        else
                        {
                            <div class="mini">还没同步过</div>
                        }
                        @if (!string.IsNullOrEmpty(a.LastSyncError))
                        {
                            <div class="mini" style="color:var(--danger);">⚠ @a.LastSyncError</div>
                        }
                    </div>
                    <div style="display:flex;gap:8px;align-items:center;">
                        <form method="post" asp-page-handler="Sync">
                            <input type="hidden" name="id" value="@a.Id" />
                            <button class="btn secondary" type="submit">同步</button>
                        </form>
                        <a class="mini" href="/Email/Edit/@a.Id">@Html.Raw(Icons.Svg("pencil", 14)) 编辑</a>
                    </div>
                </div>
            }
        </div>
    </div>
}
