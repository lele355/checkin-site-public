@page
@model CheckinApp.Pages.Email.NewModel
@{
    ViewData["Title"] = "绑定邮箱";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>绑定新邮箱</h2>
    <p class="hint">选平台会自动填好服务器地址。授权码在邮箱网页设置里开启 IMAP/SMTP 后生成（不是登录密码）。</p>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        <div class="field">
            <label>显示名称</label>
            <input asp-for="DisplayName" required autocomplete="off" placeholder="比如：QQ 主邮箱" />
        </div>
        <div class="field">
            <label>邮箱地址</label>
            <input asp-for="Address" required type="email" autocomplete="off" placeholder="you@example.com" />
        </div>
        <div class="field">
            <label>平台</label>
            <select asp-for="Provider" id="providerSel">
                @foreach (var p in Model.Presets)
                {
                    <option value="@p.Key" data-imap="@p.ImapHost" data-iport="@p.ImapPort" data-smtp="@p.SmtpHost" data-sport="@p.SmtpPort">@p.Label</option>
                }
            </select>
        </div>
        <div class="field">
            <label>授权码</label>
            <input asp-for="AuthCode" type="password" required autocomplete="off" placeholder="IMAP 服务的授权码（不是登录密码）" />
        </div>
        <div class="field-row">
            <div class="field">
                <label>IMAP 服务器（收信）</label>
                <input asp-for="ImapHost" id="imapHost" autocomplete="off" placeholder="imap.example.com" />
            </div>
            <div class="field">
                <label>IMAP 端口</label>
                <input asp-for="ImapPort" id="imapPort" type="number" />
            </div>
        </div>
        <div class="field-row">
            <div class="field">
                <label>SMTP 服务器（发信，第二期用）</label>
                <input asp-for="SmtpHost" id="smtpHost" autocomplete="off" />
            </div>
            <div class="field">
                <label>SMTP 端口</label>
                <input asp-for="SmtpPort" id="smtpPort" type="number" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
            <a class="btn secondary" href="/Email/Accounts">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    // 选平台 → 自动填服务器；填完仍可手改
    (function () {
        var sel = document.getElementById('providerSel');
        if (!sel) return;
        sel.addEventListener('change', function () {
            var o = sel.options[sel.selectedIndex];
            document.getElementById('imapHost').value = o.dataset.imap || '';
            document.getElementById('imapPort').value = o.dataset.iport || '993';
            document.getElementById('smtpHost').value = o.dataset.smtp || '';
            document.getElementById('smtpPort').value = o.dataset.sport || '465';
        });
    })();
</script>
}
