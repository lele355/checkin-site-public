@page "{id:int}"
@model CheckinApp.Pages.Email.ReadModel
@{
    ViewData["Title"] = "读邮件";
    var m = Model.Msg!;
}
<div class="card">
    <div class="page-head">
        <h2 class="mail-subject">@m.Subject</h2>
        <div style="display:flex;gap:10px;align-items:center;flex-shrink:0;">
            <a class="btn secondary" href="/Email">@Html.Raw(Icons.Svg("arrow-left", 16)) 返回收件箱</a>
            <form method="post" asp-page-handler="Unread">
                <input type="hidden" name="id" value="@m.Id" />
                <button class="btn secondary" type="submit">@Html.Raw(Icons.Svg("mail", 16)) 标记未读</button>
            </form>
        </div>
    </div>

    <div class="mail-meta">
        <div><span class="mini">发件人</span> <b>@(string.IsNullOrWhiteSpace(m.FromName) ? m.FromAddress : m.FromName)</b> <span class="mini">@m.FromAddress</span></div>
        <div><span class="mini">收件人</span> @m.ToAddress</div>
        <div><span class="mini">时间</span> @CheckinApp.Services.SiteClock.ToLocal(m.SentAt).ToString("yyyy-MM-dd HH:mm")</div>
        <div style="display:flex;gap:8px;align-items:center;">
            <span class="chip">@Model.AccountLabel</span>
            @if (m.HasAttachment)
            {
                <span class="chip">@Html.Raw(Icons.Svg("paperclip", 12)) 带附件</span>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.FetchError))
{
    <div class="msg error">正文拉取失败：@Model.FetchError（信头和摘要已在下方）</div>
}

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Body))
    {
        <div class="mail-body">@Model.Body</div>
    }
    else if (!string.IsNullOrWhiteSpace(m.Snippet))
    {
        <div class="mail-body">@m.Snippet</div>
        <p class="hint" style="margin-top:10px;">以上是摘要。正文还没拉到，点「同步」或稍后重试。</p>
    }
    else
    {
        <div class="empty"><span class="big">✉️</span>这封信没有可显示的正文。</div>
    }
</div>
