@page
@model CheckinApp.Pages.IndexModel
@inject CheckinApp.Services.CurrentUser Me
@using CheckinApp.Security
@using CheckinApp.Services
@{
    ViewData["Title"] = "工作台";
    var now = SiteClock.Now;
}
@* 卡片布局配置（dashboard.js 消费：pinned/order/hidden 三组卡片 id） *@
<script type="application/json" id="dashData">@Html.Raw(string.IsNullOrWhiteSpace(Model.DashboardJson) ? "{}" : Model.DashboardJson)</script>

@* 工作台上的操作结果（删除测试数据等）：modal.js 会把它转成 Toast *@
@if (TempData["Ok"] is string okMsg)
{
    <div class="msg ok">@okMsg</div>
}
@if (TempData["Err"] is string errMsg)
{
    <div class="msg error">@errMsg</div>
}

@* 自定义入口放进问候卡右上角（原来它单独占首屏一整行，
   一个「设置」按钮不该比当天的日程更显眼） *@

@* 测试数据提示：只在「有【测试】记录 且 从没点过删除」时出现；点一次删除后永久消失 *@
@if (Model.ShowSampleBanner)
{
    <section class="card sample-banner">
        <div class="sample-banner-text">
            <h2>这个账号有 @Model.SampleRows 条样例数据</h2>
            <p class="hint">建号时自动生成的，都以「@SampleData.Mark」开头。清掉只删这些，你自己的数据不动。</p>
        </div>
        <form method="post" asp-page-handler="ClearSample" data-confirm="确认清掉">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("trash-2", 16)) 清掉样例</button>
        </form>
    </section>
}

@* 自定义面板：显示/隐藏 + 排序（置顶区/普通区两段） *@
<div class="card" id="dashCustom" hidden>
    <h2>自定义工作台</h2>
    <p class="hint">置顶区的卡片永远排在最上面；去掉勾选即隐藏（数据不丢，随时可勾回）。排序用每行的 ↑↓。</p>
    <div id="dashCustomList"></div>
    <div class="form-actions">
        <button class="btn" type="button" id="dashSave">保存</button>
        <button class="btn secondary" type="button" id="dashReset">恢复默认</button>
    </div>
</div>

<div class="grid-cards dash-grid" id="dashGrid">
    @* ---------- 问候 ---------- *@
    <div class="card dash-span" data-card="hello">
        <button type="button" class="card-pin" data-pin="hello" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
        <button type="button" class="card-gear" id="dashCustomBtn" aria-expanded="false"
                title="自定义工作台" aria-label="自定义工作台">@Html.Raw(Icons.Svg("settings-2", 15))</button>
        <h2>你好，@Me.DisplayName</h2>
        <p class="hint">@now.ToString("M月d日") @SiteClock.WeekdayCn(now) · @now.ToString("HH:mm") ｜ @Me.RoleName</p>
    </div>

    @* ---------- 提醒横幅（有要事才出现） ---------- *@
    @if (Me.Has("reminders.use") && Model.ReminderCount > 0)
    {
        <div class="card dash-span" data-card="reminders" style="border-left:3px solid var(--accent-strong, #0F6E56);">
            <button type="button" class="card-pin" data-pin="reminders" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                <span style="font-weight:600;">🔔 近期有 @Model.ReminderCount 件事需要留意</span>
                <a class="mini" href="/Reminders">查看 →</a>
            </div>
        </div>
    }

    @* ---------- 今日打卡 ---------- *@
    @if (Me.Has("habits.use"))
    {
        <div class="card" data-card="habits">
            <button type="button" class="card-pin" data-pin="habits" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <h2>✅ 今日打卡</h2>
            @if (Model.TodayHabits.Count == 0)
            {
                <p class="hint">还没有习惯 · <a href="/Habits">去新建</a></p>
            }
            else
            {
                <div class="stack" style="margin-top:8px;">
                    @foreach (var (h, checkedToday) in Model.TodayHabits)
                    {
                        <div class="list-line" style="display:flex;align-items:center;gap:10px;">
                            <span style="font-size:18px;">@h.Icon</span>
                            <div style="flex:1;min-width:0;font-weight:600;">@h.Name</div>
                            @if (checkedToday)
                            {
                                <span class="chip" style="background:var(--accent-soft);color:var(--accent-strong);">已打卡</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Checkin" data-ajax="checkin">
                                    <input type="hidden" name="id" value="@h.Id" />
                                    <button class="btn" type="submit">打卡</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
            <p class="hint hint-foot"><a href="/Habits">全部习惯 →</a></p>
        </div>
    }

    @* ---------- 今日课程 ---------- *@
    @if (Me.Has("courses.use"))
    {
        <div class="card" data-card="courses">
            <button type="button" class="card-pin" data-pin="courses" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <h2>📚 今日课程</h2>
            @if (!Model.SemesterConfigured)
            {
                <p class="hint">未设置学期起始，周次无法计算 · <a href="/Courses">去设置</a></p>
            }
            else if (Model.TodayCourses.Count == 0)
            {
                <p class="hint">今天没有课 · <a href="/Courses">本周课表</a></p>
            }
            else
            {
                <div class="stack" style="margin-top:8px;">
                    @foreach (var (c, hours) in Model.TodayCourses)
                    {
                        <div class="list-line">
                            <div class="meta" style="flex-shrink:0;min-width:82px;">@hours</div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:600;">@c.Name</div>
                                <div class="hint" style="margin-top:2px;">
                                    @if (!string.IsNullOrWhiteSpace(c.Location)) { <span>@c.Location ｜ </span> }
                                    @(c.Category switch { "required" => "必修", "college" => "院选", "school" => "校选", _ => "其它" }) · @Weeks.Display(c.WeeksText)
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <p class="hint hint-foot">第 @Model.CurrentWeek 教学周 · <a href="/Courses">完整课程表 →</a></p>
            }
        </div>
    }

    @* ---------- 未来 7 天日程 ---------- *@
    @if (Me.Has("schedule.use"))
    {
        <div class="card" data-card="schedule">
            <button type="button" class="card-pin" data-pin="schedule" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <h2>📅 未来 7 天日程</h2>
            @if (Model.Upcoming.Count == 0)
            {
                <p class="hint">未来 7 天没有安排 · <a href="/Schedule">新建日程</a></p>
            }
            else
            {
                <div class="stack">
                    @foreach (var s in Model.Upcoming)
                    {
                        <div class="list-line">
                            <div class="meta" style="flex-shrink:0;min-width:72px;">
                                @(s.AllDay ? s.StartAt.ToString("M月d日 全天") : s.StartAt.ToString("M月d日 HH:mm"))
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:600;">@s.Title</div>
                                @if (!string.IsNullOrWhiteSpace(s.Description))
                                {
                                    <div class="hint" style="margin-top:2px;">@s.Description</div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <p class="hint hint-foot"><a href="/Schedule">查看全部日程 →</a></p>
            }
        </div>
    }

    @* ---------- 置顶便签 ---------- *@
    @if (Me.Has("memo.use"))
    {
        <div class="card" data-card="memo">
            <button type="button" class="card-pin" data-pin="memo" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <h2>✎ 置顶备忘</h2>
            @if (Model.PinnedMemos.Count == 0)
            {
                <p class="hint">还没有置顶备忘 · <a href="/Memo">去备忘</a></p>
            }
            else
            {
                <div class="stack">
                    @foreach (var m in Model.PinnedMemos)
                    {
                        <div class="list-line" style="display:block;">
                            <div style="font-weight:600;">@m.Title</div>
                            @if (!string.IsNullOrWhiteSpace(m.Content))
                            {
                                <div class="hint" style="margin-top:2px;white-space:pre-wrap;">@(m.Content.Length > 80 ? m.Content.Substring(0, 80) + "…" : m.Content)</div>
                            }
                        </div>
                    }
                </div>
                <p class="hint hint-foot"><a href="/Memo">查看全部便签 →</a></p>
            }
        </div>
    }

    @* ---------- 最近的纪念日 ---------- *@
    @if (Me.Has("anniversary.use"))
    {
        <div class="card" data-card="anniversary">
            <button type="button" class="card-pin" data-pin="anniversary" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <h2>💛 最近的纪念日</h2>
            @if (Model.NextAnniv is var na && na is not null)
            {
                <div style="margin-top:8px;">
                    <div style="font-weight:600;">@na.Value.Title</div>
                    @if (na.Value.DaysLeft == 0)
                    {
                        <div style="font-weight:700;color:var(--accent-strong);font-size:20px;margin-top:4px;">就是今天！</div>
                    }
                    else
                    {
                        <div style="font-weight:700;color:var(--accent-strong);font-size:20px;margin-top:4px;">
                            还有 @na.Value.DaysLeft <span class="mini">天</span>
                        </div>
                    }
                </div>
                <p class="hint hint-foot"><a href="/Anniversaries">全部纪念日 →</a></p>
            }
            else
            {
                <p class="hint">还没有纪念日 · <a href="/Anniversaries">去添加</a></p>
            }
        </div>
    }

    @* ---------- 邮件 ---------- *@
    @if (Me.Has("email.use"))
    {
        <div class="card" data-card="email">
            <button type="button" class="card-pin" data-pin="email" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <h2>📬 邮件</h2>
            @if (!Model.HasMailAccounts)
            {
                <p class="hint">还没有绑定邮箱 · <a href="/Email/Accounts">去绑定</a></p>
            }
            else
            {
                <div style="display:flex;align-items:center;gap:10px;margin:6px 0 8px;">
                    <span class="chip">未读 @Model.UnreadMails</span>
                    <a class="mini" href="/Email">去收件箱 →</a>
                </div>
                @if (Model.RecentMails.Count == 0)
                {
                    <p class="hint">还没有收到邮件</p>
                }
                else
                {
                    <div class="stack">
                        @foreach (var m in Model.RecentMails)
                        {
                            <div class="list-line">
                                <div style="flex:1;min-width:0;">
                                    <div style="font-weight:600;@(m.IsRead ? "" : "font-weight:700;")">
                                        @(string.IsNullOrWhiteSpace(m.FromName) ? m.FromAddress : m.FromName)
                                        <span class="mini" style="font-weight:400;">@CheckinApp.Services.SiteClock.ToLocal(m.SentAt).ToString("MM-dd HH:mm")</span>
                                    </div>
                                    <div class="hint" style="margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@m.Subject</div>
                                </div>
                                @if (!m.IsRead)
                                {
                                    <span class="chip">未读</span>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }

    @* ---------- 留言板 ---------- *@
    @if (Me.Has("board.use"))
    {
        <div class="card" data-card="board">
            <button type="button" class="card-pin" data-pin="board" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <h2>💬 留言板</h2>
            @if (Model.RecentBoard.Count == 0)
            {
                <p class="hint">还没有留言 · <a href="/Board">去写第一条</a></p>
            }
            else
            {
                <div class="stack">
                    @foreach (var b in Model.RecentBoard)
                    {
                        <div class="list-line" style="display:block;">
                            <div style="font-weight:600;">
                                @(b.User?.DisplayName ?? "某人")
                                <span class="mini" style="font-weight:400;">@CheckinApp.Services.SiteClock.ToLocal(b.CreatedAt).ToString("MM-dd HH:mm")</span>
                            </div>
                            <div class="hint" style="margin-top:2px;">@(b.Content.Length > 60 ? b.Content.Substring(0, 60) + "…" : b.Content)</div>
                        </div>
                    }
                </div>
                <p class="hint hint-foot"><a href="/Board">去留言板 →</a></p>
            }
        </div>
    }

    @* ---------- 本月记账 ---------- *@
    @if (Me.Has("expense.use"))
    {
        <div class="card" data-card="expense">
            <button type="button" class="card-pin" data-pin="expense" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <h2>💰 本月记账</h2>
            <div class="stat-row">
                <div class="stat-box">
                    <div class="mini">支出</div>
                    <div class="stat-num">¥@Model.MonthOut.ToString("0.##")</div>
                </div>
                <div class="stat-box">
                    <div class="mini">收入</div>
                    <div class="stat-num">¥@Model.MonthIn.ToString("0.##")</div>
                </div>
                <div class="stat-box">
                    <div class="mini">笔数</div>
                    <div class="stat-num">@Model.MonthEntries</div>
                </div>
            </div>
            <p class="hint hint-foot"><a href="/Expenses">记账本 →</a></p>
        </div>
    }

    @* ---------- 情侣空间（敏感权限，仅授权可见） ---------- *@
    @if (Me.Has("couples.view"))
    {
        <div class="card" data-card="couples">
            <button type="button" class="card-pin" data-pin="couples" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <h2>💛 情侣空间</h2>
            @if (Model.Couple is var cp && cp is not null)
            {
                <div style="margin:6px 0;">
                    <span style="font-weight:700;color:var(--accent-strong);font-size:22px;">@cp.Value.Days</span>
                    <span class="mini">天 · @cp.Value.Title</span>
                </div>
            }
            else
            {
                <p class="hint">未设置在一起的日期 · <a href="/Couples">去设置</a></p>
            }
            @if (Model.LastNote is var ln && ln is not null)
            {
                <div class="hint" style="white-space:pre-wrap;">
                    「@(ln.Content.Length > 50 ? ln.Content.Substring(0, 50) + "…" : ln.Content)」
                    —— @(ln.FromUser?.DisplayName ?? "TA")
                </div>
            }
            <p class="hint hint-foot"><a href="/Couples">进入情侣空间 →</a></p>
        </div>
    }

    @* ---------- 经期助手（敏感权限，仅本人数据） ---------- *@
    @if (Me.Has("period.use"))
    {
        <div class="card" data-card="period">
            <button type="button" class="card-pin" data-pin="period" title="置顶到最上面">@Html.Raw(Icons.Svg("pin", 14))</button>
            <h2>🌸 经期助手</h2>
            @if (Model.LastPeriod is var lp && lp is not null)
            {
                <div style="font-weight:600;margin:6px 0 2px;">
                    最近记录：@lp.Value.StartDate.ToString("M月d日")@(lp.Value.EndDate is DateTime e ? " ~ " + e.ToString("M月d日") : " 起")
                </div>
                <p class="hint">距今 @((DateTime.Today - lp.Value.StartDate.Date).Days) 天</p>
            }
            else
            {
                <p class="hint">还没有记录 · <a href="/Period">去记录</a></p>
            }
            <p class="hint hint-foot"><a href="/Period">打开经期助手 →</a></p>
        </div>
    }

    @* ---------- 建设进展与管理后台自述卡已删除：那是开发期的记录，
       用户每天打开工作台不需要看「哪些模块已上线」；侧栏本来就有管理入口。 *@
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
