@page
@model CheckinApp.Pages.Me.EditModel
@{
    ViewData["Title"] = "编辑资料";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>编辑资料</h2>

    <form method="post" asp-page="/Me" asp-page-handler="Profile">
        <div class="field">
            <label>登录名（不可改）</label>
            <input value="@Model.Username" disabled />
        </div>
        <div class="field">
            <label asp-for="DisplayName">昵称</label>
            <input asp-for="DisplayName" maxlength="20" required placeholder="最多 20 个字" />
        </div>
        <div class="field">
            <label asp-for="Email">联系邮箱（选填）</label>
            <input asp-for="Email" maxlength="100" placeholder="you@example.com" />
        </div>
        <div class="field">
            <label asp-for="Signature">个性签名（选填）</label>
            <textarea asp-for="Signature" rows="3" maxlength="60" placeholder="一句话介绍自己，最多 60 字"></textarea>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">保存资料</button>
            <a class="btn secondary" href="/Me">取消</a>
        </div>
    </form>
</div>
