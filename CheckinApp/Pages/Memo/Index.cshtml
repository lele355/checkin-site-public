@page
@model CheckinApp.Pages.Memo.IndexModel
@{
    ViewData["Title"] = "备忘";
}
<div class="card">
    <div class="page-head">
        <h2>备忘便签</h2>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <div class="view-switch" data-viewkey="memo">
                <button type="button" class="vs-btn@(Model.View == "grid" ? " on" : "")" data-view="grid" title="卡片视图">@Html.Raw(Icons.Svg("grid", 15))<span>卡片</span></button>
                <button type="button" class="vs-btn@(Model.View == "list" ? " on" : "")" data-view="list" title="列表视图">@Html.Raw(Icons.Svg("list", 15))<span>列表</span></button>
            </div>
            <input id="memoSearch" class="filter-input" type="search" placeholder="搜索标题或正文…" aria-label="搜索便签" />
            <a class="btn" href="/Memo/New">@Html.Raw(Icons.Svg("plus", 16)) 新建便签</a>
        </div>
    </div>
    <p class="hint" style="margin-top:8px;">置顶的便签会出现在工作台首页。</p>
</div>

@if (Model.Memos.Count == 0)
{
    <div class="card"><div class="empty"><span class="big">✎</span>还没有备忘录</div></div>
}
else
{
    <div id="memoEmpty" class="card" hidden><div class="empty"><span class="big">🔍</span>没有匹配的便签。</div></div>
}

@if (Model.View == "list")
{
    <div class="card" style="padding:0;overflow:hidden;">
        <div class="memo-rows" id="memoRows">
            @foreach (var m in Model.Memos)
            {
                <div class="memo-row" data-search="@((m.Title + " " + m.Content).ToLowerInvariant())">
                    <form method="post" asp-page-handler="TogglePin" class="pin-form" data-ajax="pin">
                        <input type="hidden" name="id" value="@m.Id" />
                        <input type="hidden" name="view" value="list" />
                        <button type="submit" class="pin-btn@(m.Pinned ? " on" : "")" title="@(m.Pinned ? "取消置顶" : "置顶")" aria-label="@(m.Pinned ? "取消置顶" : "置顶")">@Html.Raw(Icons.Svg("pin", 15))</button>
                    </form>
                    <a class="mr-link" href="/Memo/Edit/@m.Id">
                        <div class="mr-title">@m.Title</div>
                        @if (!string.IsNullOrWhiteSpace(m.Content))
                        {
                            <div class="mr-snippet">@(m.Content.Length > 80 ? m.Content.Substring(0, 80) + "…" : m.Content)</div>
                        }
                        <span class="mini mr-time">@m.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>
                    </a>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="grid-cards" id="memoGrid">
        @foreach (var m in Model.Memos)
        {
            <div class="card memo-card" data-search="@((m.Title + " " + m.Content).ToLowerInvariant())" style="margin-bottom:0;display:flex;flex-direction:column;gap:8px;">
                <div class="memo-card-head">
                    <div class="mc-title">@m.Title</div>
                    <form method="post" asp-page-handler="TogglePin" class="pin-form" data-ajax="pin">
                        <input type="hidden" name="id" value="@m.Id" />
                        <input type="hidden" name="view" value="grid" />
                        <button type="submit" class="pin-btn@(m.Pinned ? " on" : "")" title="@(m.Pinned ? "取消置顶" : "置顶")" aria-label="@(m.Pinned ? "取消置顶" : "置顶")">@Html.Raw(Icons.Svg("pin", 15))</button>
                    </form>
                </div>
                @if (!string.IsNullOrWhiteSpace(m.Content))
                {
                    <div class="hint" style="white-space:pre-wrap;flex:1;">@(m.Content.Length > 200 ? m.Content.Substring(0, 200) + "…" : m.Content)</div>
                }
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span class="mini">@m.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>
                    <a href="/Memo/Edit/@m.Id">@Html.Raw(Icons.Svg("pencil", 14)) 编辑</a>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
    // 便签即时过滤：卡片/列表两视图通用，标题+正文不区分大小写包含匹配
    (function () {
        var input = document.getElementById('memoSearch');
        if (!input) return;
        var items = document.querySelectorAll('.memo-card, .memo-row');
        var empty = document.getElementById('memoEmpty');
        input.addEventListener('input', function () {
            var q = input.value.trim().toLowerCase();
            var shown = 0;
            items.forEach(function (c) {
                var hit = !q || (c.dataset.search || '').indexOf(q) !== -1;
                c.style.display = hit ? '' : 'none';
                if (hit) shown++;
            });
            if (empty) empty.hidden = shown > 0;
        });
    })();
</script>
}
