@page
@model CheckinApp.Pages.Games.IndexModel
@using CheckinApp.Ui
@{
    ViewData["Title"] = "小游戏";
}

<div class="card">
    <div class="page-head">
        <h2>小游戏</h2>
        <div class="head-actions">
            <a class="btn secondary" asp-page="/Games/Settings">@Html.Raw(Icons.Svg("settings-2", 16)) 设置</a>
        </div>
    </div>

    <div class="gm-list">
        @foreach (var g in Model.Games)
        {
            var href = g.Available ? (g.Solo ? $"/Games/{g.Key}/Solo" : $"/Games/{g.Key}") : null;
            @if (href is null)
            {
                <div class="gm-item">
                    <div class="gm-item-icon">@Html.Raw(Icons.Svg("gamepad", 22))</div>
                    <div class="gm-item-body">
                        <div class="gm-item-name">@g.Name</div>
                        <div class="gm-item-sub">@g.Sub</div>
                    </div>
                    <span class="gm-badge mute">敬请期待</span>
                </div>
            }
            else
            {
                <a class="gm-item" href="@href">
                    <div class="gm-item-icon">@Html.Raw(Icons.Svg("gamepad", 22))</div>
                    <div class="gm-item-body">
                        <div class="gm-item-name">@g.Name</div>
                        <div class="gm-item-sub">@g.Sub</div>
                    </div>
                    @Html.Raw(Icons.Svg("chevron-right", 18))
                </a>
            }
        }
    </div>
</div>
