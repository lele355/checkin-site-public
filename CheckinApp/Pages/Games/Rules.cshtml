@page "/Games/{gameKey}/Rules"
@model CheckinApp.Pages.Games.RulesModel
@using CheckinApp.Ui
@{
    ViewData["Title"] = Model.GameName + "规则";
}
<div class="card" style="max-width:640px;">
    <div class="page-head">
        <h2>@Model.GameName · 规则</h2>
        <a class="btn secondary" href="/Games/@Model.GameKey">@Html.Raw(Icons.Svg("chevron-left", 16)) 返回</a>
    </div>

    @foreach (var s in Model.Sections)
    {
        <div style="margin-bottom:18px;">
            <h3 style="margin-bottom:8px;">@s.Title</h3>
            @foreach (var p in s.Paras)
            {
                <p style="margin:4px 0;line-height:1.7;">@p</p>
            }
        </div>
    }
</div>
