@page
@model CheckinApp.Pages.Games.SettingsModel
@using CheckinApp.Ui
@{
    ViewData["Title"] = "游戏设置";
    var s = Model.Display;
}

<div class="card">
    <div class="page-head">
        <h2>游戏设置</h2>
        <a class="btn secondary" href="/Games">@Html.Raw(Icons.Svg("chevron-left", 16)) 返回</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Ok))
    {
        <div class="msg ok">@Model.Ok</div>
    }
    @if (!string.IsNullOrEmpty(Model.Err))
    {
        <div class="msg error">@Model.Err</div>
    }

    <form method="post" asp-page-handler="Save">

        <div class="field">
            <label>
                <input type="checkbox" class="switch" name="tapConfirm" value="1" checked="@s.TapConfirm" />
                落子二次确认
            </label>
        </div>

        <div class="field">
            <label>
                <input type="checkbox" class="switch" name="showCoord" value="1" checked="@s.ShowCoord" />
                显示坐标
            </label>
        </div>

        <div class="field">
            <label>
                <input type="checkbox" class="switch" name="lastMark" value="1" checked="@s.LastMark" />
                标记最后一手
            </label>
        </div>

        <div class="field">
            <label>
                <input type="checkbox" class="switch" name="vibrate" value="1" checked="@s.Vibrate" />
                落子震动
            </label>
        </div>

        <div class="form-actions" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px;">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存设置</button>
        </div>
    </form>

    <form method="post" asp-page-handler="Reset" data-confirm="恢复成默认设置？"
          style="margin-top:8px;">
        <div class="form-actions" style="display:flex;gap:10px;flex-wrap:wrap;">
            <button class="btn secondary" type="submit">@Html.Raw(Icons.Svg("rotate-ccw", 16)) 恢复默认</button>
        </div>
    </form>
</div>
