@page "{id:int}"
@model CheckinApp.Pages.Games.Gomoku.PlayModel
@using System.Globalization
@using CheckinApp.Services
@{
    ViewData["Title"] = "五子棋";
    // Load() 保证进到这里时房间一定存在（不存在已经 RedirectToPage 回大厅了）
    var room = Model.Room!;
    var size = Model.Size;
    var settings = Model.Settings;

    // 坐标要占一圈边距，所以开了坐标就把留白放大
    var pad = settings.ShowCoord ? 40 : 20;
    var step = (640.0 - pad * 2) / (size - 1);
    string Px(int i) => (pad + i * step).ToString("0.##", CultureInfo.InvariantCulture);
    string R(double k) => (step * k).ToString("0.##", CultureInfo.InvariantCulture);

    var sideName = Model.MySide == 1 ? "黑棋" : "白棋";
    var winnerText = room.Winner switch
    {
        3 => "和棋",
        1 => "黑棋胜",
        2 => "白棋胜",
        _ => ""
    };
    var reasonText = room.ResultReason switch
    {
        "resign" => "（认输）",
        "draw" => "（棋盘下满）",
        "overline" => "（黑方长连判负）",
        "timeout" => "（超时）",
        _ => ""
    };
}
<div class="card gm-card">
    <div class="page-head">
        <h2>五子棋</h2>
        <span class="gm-code" title="把这个码发给朋友">房间 @room.Code</span>
    </div>

    <div class="gm-rules">
        <span class="chip">@size×@size</span>
        <span class="chip">@(room.Forbidden ? "标准规则" : "自由规则")</span>
        @if (room.MoveTimeoutSec > 0)
        {
            <span class="chip">单步 @(room.MoveTimeoutSec < 60 ? $"{room.MoveTimeoutSec} 秒" : $"{room.MoveTimeoutSec / 60} 分钟")</span>
        }
        @if (room.TotalTimeoutSec > 0)
        {
            <span class="chip">总用时 @(room.TotalTimeoutSec / 60) 分钟</span>
        }
    </div>

    <div class="gm-players">
        @{
            var hostIsBlack = room.HostSide == 1;
            var hostName = room.Host?.DisplayName ?? "";
            var guestName = room.Guest?.DisplayName ?? "";
        }
        <div class="gm-player @(Model.MySide != 0 && ((Model.IsHost && hostIsBlack) || (!Model.IsHost && !hostIsBlack)) ? "me" : "")">
            <span class="gm-stone-dot @(hostIsBlack ? "b" : "w")"></span>
            <span>@hostName</span>
            <span class="gm-tag">@(hostIsBlack ? "黑先" : "白")</span>
        </div>
        <div class="gm-vs">vs</div>
        <div class="gm-player @(Model.MySide != 0 && ((Model.IsHost && !hostIsBlack) || (!Model.IsHost && hostIsBlack)) ? "me" : "")">
            <span class="gm-stone-dot @(hostIsBlack ? "w" : "b")"></span>
            <span>@(string.IsNullOrEmpty(guestName) ? "（等朋友）" : guestName)</span>
            <span class="gm-tag">@(hostIsBlack ? "白" : "黑先")</span>
        </div>
    </div>

    <div class="gm-status" id="gmStatus" data-status="@room.Status">
        @* 文案单独一个 span：games.js 的 statusText() 会整块覆盖，计时条必须放在它外面 *@
        <span id="gmStatusText">@if (room.Status == "waiting")
            {
                <span>等人进来 —— 把房间码 <b>@room.Code</b> 发给朋友</span>
            }
            else if (room.Status == "finished")
            {
                <span>@winnerText@reasonText · 共 @Model.Moves.Count 手</span>
            }
            else if (Model.MySide == 0)
            {
                <span>你在旁观这一局</span>
            }
            else if (room.Turn == Model.MySide)
            {
                <span>轮到你（@sideName）</span>
            }
            else
            {
                <span>等 @Model.OppName 落子</span>
            }</span>
        @* 计时条：JS 每 250ms 刷一次数字；不限时就不显示 *@
        @if (room.MoveTimeoutSec > 0 || room.TotalTimeoutSec > 0)
        {
            <span class="gm-clock" id="gmClock" hidden></span>
        }
    </div>

    <div class="gm-board-wrap">
        <svg id="gmBoard" class="gm-board" viewBox="0 0 640 640" role="img"
             aria-label="五子棋棋盘"
             data-myside="@Model.MySide"
             data-size="@size"
             data-tapconfirm="@(settings.TapConfirm ? "1" : "0")"
             data-lastmark="@(settings.LastMark ? "1" : "0")"
             data-status="@room.Status">
            <rect x="0" y="0" width="640" height="640" class="gm-board-bg" rx="10" />
            <g class="gm-grid">
                @for (var i = 0; i < size; i++)
                {
                    <line x1="@Px(0)" y1="@Px(i)" x2="@Px(size - 1)" y2="@Px(i)" />
                    <line x1="@Px(i)" y1="@Px(0)" x2="@Px(i)" y2="@Px(size - 1)" />
                }
            </g>
            <g class="gm-stars">
                @foreach (var (sx, sy) in GomokuRules.StarPoints(size))
                {
                    <circle cx="@Px(sx)" cy="@Px(sy)" r="@R(0.09)" />
                }
            </g>
            @if (settings.ShowCoord)
            {
                @* SVG 的 <text> 在 Razor 里是保留标签（不能带属性），所以用 Raw 输出 *@
                <g class="gm-coord">
                    @for (var i = 0; i < size; i++)
                    {
                        @Html.Raw($"<text x=\"{Px(i)}\" y=\"24\" text-anchor=\"middle\">{(char)('A' + i)}</text>")
                        @Html.Raw($"<text x=\"18\" y=\"{Px(i)}\" text-anchor=\"middle\" dominant-baseline=\"middle\">{i + 1}</text>")
                    }
                </g>
            }
            <g id="gmStones">
                @foreach (var m in Model.Moves)
                {
                    <circle cx="@Px(m.x)" cy="@Px(m.y)" r="@R(0.42)" class="gm-stone @(m.s == 1 ? "b" : "w")" />
                }
                @if (Model.Last is not null && settings.LastMark)
                {
                    <circle cx="@Px(Model.Last.x)" cy="@Px(Model.Last.y)" r="@R(0.16)" class="gm-last @(Model.Last.s == 1 ? "b" : "w")" />
                }
            </g>
            @* 二次确认时的预览圈，由 JS 挪位置 *@
            <circle id="gmGhost" class="gm-ghost" cx="@Px(size / 2)" cy="@Px(size / 2)" r="@R(0.42)" hidden />
        </svg>
    </div>

    <div class="gm-actions">
        @if (Model.CanJoin)
        {
            <form method="post" asp-page-handler="Join">
                <input type="hidden" name="id" value="@room.Id" />
                <button class="btn" type="submit">加入这一局</button>
            </form>
        }
        @if (Model.MySide != 0 && room.Status == "playing")
        {
            <form method="post" asp-page-handler="Leave" data-confirm="确认认输">
                <input type="hidden" name="id" value="@room.Id" />
                <button class="btn secondary" type="submit">认输</button>
            </form>
        }
        @if (Model.MySide != 0 && room.Status == "finished")
        {
            <form method="post" asp-page-handler="Rematch">
                <input type="hidden" name="id" value="@room.Id" />
                <button class="btn" type="submit">再来一局</button>
            </form>
            <form method="post" asp-page-handler="Leave">
                <input type="hidden" name="id" value="@room.Id" />
                <button class="btn secondary" type="submit">收摊</button>
            </form>
        }
        @if (room.Status == "waiting" && Model.IsHost)
        {
            <form method="post" asp-page-handler="Leave" data-confirm="确认解散">
                <input type="hidden" name="id" value="@room.Id" />
                <button class="btn secondary" type="submit">解散</button>
            </form>
        }
        <a class="btn secondary" asp-page="/Games/Gomoku">回大厅</a>
        <a class="btn secondary" asp-page="/Games/Gomoku/Settings">设置</a>
    </div>
</div>

<script type="application/json" id="gmState">@Html.Raw(Model.StateJson)</script>

@section Scripts {
    <script src="~/js/games.js" asp-append-version="true"></script>
}
