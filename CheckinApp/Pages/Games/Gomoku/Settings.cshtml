@page
@model CheckinApp.Pages.Games.Gomoku.SettingsModel
@using CheckinApp.Ui
@{
    ViewData["Title"] = "五子棋设置";
    var s = Model.Rules;

    string SizeText(int n) => $"{n} × {n}";
    string TimeText(int sec) => sec <= 0 ? "不限" : (sec < 60 ? $"{sec} 秒" : $"{sec / 60} 分钟");
}

<div class="card">
    <div class="page-head">
        <h2>五子棋设置</h2>
        <a class="btn secondary" href="/Games/Gomoku">@Html.Raw(Icons.Svg("chevron-left", 16)) 返回</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Ok))
    {
        <div class="msg ok">@Model.Ok</div>
    }
    @if (!string.IsNullOrEmpty(Model.Err))
    {
        <div class="msg error">@Model.Err</div>
    }

    <form method="post" asp-page-handler="Save">

        @* 显式包 .field-row：site.js 会把「连续且短」的 .field 自动并成一行，
           四个下拉并排会挤成一行 150px 的小格子，规则名直接被截断。 *@

        <div class="field-row">
            <div class="field">
                <label for="size">盘面大小</label>
                <select id="size" name="size">
                    @foreach (var n in SettingsModel.Sizes)
                    {
                        if (n == s.Size)
                        {
                            <option value="@n" selected>@SizeText(n)</option>
                        }
                        else
                        {
                            <option value="@n">@SizeText(n)</option>
                        }
                    }
                </select>
            </div>
            <div class="field">
                <label for="forbidden">规则</label>
                <select id="forbidden" name="forbidden">
                    @if (s.Forbidden)
                    {
                        <option value="0">自由规则 —— 长连也算赢</option>
                        <option value="1" selected>标准规则 —— 黑方长连判负</option>
                    }
                    else
                    {
                        <option value="0" selected>自由规则 —— 长连也算赢</option>
                        <option value="1">标准规则 —— 黑方长连判负</option>
                    }
                </select>
            </div>
        </div>

        <div class="field-row">
            <div class="field">
                <label for="moveTimeoutSec">单步限时</label>
                <select id="moveTimeoutSec" name="moveTimeoutSec">
                    @foreach (var t in SettingsModel.MoveOptions)
                    {
                        if (t == s.MoveTimeoutSec)
                        {
                            <option value="@t" selected>@TimeText(t)</option>
                        }
                        else
                        {
                            <option value="@t">@TimeText(t)</option>
                        }
                    }
                </select>
            </div>
            <div class="field">
                <label for="totalTimeoutSec">每方总用时</label>
                <select id="totalTimeoutSec" name="totalTimeoutSec">
                    @foreach (var t in SettingsModel.TotalOptions)
                    {
                        if (t == s.TotalTimeoutSec)
                        {
                            <option value="@t" selected>@TimeText(t)</option>
                        }
                        else
                        {
                            <option value="@t">@TimeText(t)</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="form-actions" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px;">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存设置</button>
        </div>
    </form>

    <form method="post" asp-page-handler="Reset" data-confirm="恢复成默认设置？"
          style="margin-top:8px;">
        <div class="form-actions" style="display:flex;gap:10px;flex-wrap:wrap;">
            <button class="btn secondary" type="submit">@Html.Raw(Icons.Svg("rotate-ccw", 16)) 恢复默认</button>
        </div>
    </form>
</div>
