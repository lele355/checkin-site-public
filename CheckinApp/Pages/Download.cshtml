@page
@model CheckinApp.Pages.DownloadModel
@{
    ViewData["Title"] = "下载客户端";
}
<div class="card">
    <div class="page-head">
        <h2>安卓客户端</h2>
        <span class="chip">v@(Model.Version)</span>
    </div>
    <p class="hint" style="margin-top:6px;">@Model.Notes</p>

    <div class="stack" style="margin-top:14px;">
        @if (Model.ApkExists)
        {
            <p class="hint">安装包：app-release.apk · @Model.SizeText · 更新于 @Model.UpdatedText</p>
            <div class="form-actions">
                <a class="btn" href="@Model.ApkUrl" download>下载 APK</a>
            </div>
        }
        else
        {
            <div class="note">
                安装包还没放出。等签名打包上传后，这里会自动出现「下载 APK」按钮，无需改代码。
            </div>
        }

        <div>
            <h3>安装说明</h3>
            <div class="hint" style="margin-top:6px;">
                1. 下载后用手机打开，系统提示"未知来源"时选择允许（这是侧载安装的正常提示）。<br />
                2. 以后升级直接覆盖安装，<b>不要先卸载</b>——卸载会清除本地登录态。<br />
                3. 客户端只是一个壳，页面仍是 example.com 的网页，所以<b>服务端更新后无需重新下载 App</b>。
            </div>
        </div>

        <div>
            <h3>没有安卓？</h3>
            <div class="hint" style="margin-top:6px;">
                用手机浏览器打开 <a href="https://example.com" target="_blank" rel="noopener">example.com</a>，在菜单里选「安装应用 / 添加到主屏幕」即可获得接近 App 的全屏体验。
            </div>
        </div>
    </div>
</div>
