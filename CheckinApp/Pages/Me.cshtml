@page
@model CheckinApp.Pages.MeModel
@{
    ViewData["Title"] = "个人主页";
}

@if (TempData["Ok"] is string ok)
{
    <div class="msg ok">@ok</div>
}
@if (TempData["Err"] is string err)
{
    <div class="msg error">@err</div>
}

@* ---------- 名片：头像 + 名字 + 角色 + 签名 + 加入/登录时间 ---------- *@
<section class="card me-hero">
    <div class="me-avatar" aria-hidden="true">@Model.Avatar</div>
    <div class="me-hero-text">
        <h1 class="me-name">@Model.DisplayName</h1>
        <div class="me-tags">
            <span class="chip">@Model.RoleName</span>
            <span class="mini">@("@" + Model.Username)</span>
        </div>
        @if (string.IsNullOrWhiteSpace(Model.Signature))
        {
            <p class="me-sign me-sign-empty">还没有个性签名</p>
        }
        else
        {
            <p class="me-sign">@Model.Signature</p>
        }
    </div>
    <div class="me-hero-meta mini">
        <span>加入于 @Model.CreatedAt.ToString("yyyy-MM-dd")</span>
        @if (Model.LastLoginAt is DateTime last)
        {
            <span>上次登录 @last.ToString("MM-dd HH:mm")</span>
        }
    </div>
</section>

@* ---------- 数据概览：有权限的模块才出现 ---------- *@
<section class="card">
    <div class="page-head">
        <h2>我的数据</h2>
        <span class="mini">点格子直接进模块</span>
    </div>
    @if (Model.Stats.Count == 0)
    {
        <div class="empty">
            <span class="big">◎</span>
            当前角色还没有任何模块权限，请联系管理员开通。
        </div>
    }
    else
    {
        <div class="me-stats">
            @foreach (var s in Model.Stats)
            {
                <a class="me-stat" href="@s.Url">
                    <span class="me-stat-ico">@Html.Raw(Icons.Svg(s.Icon, 17))</span>
                    <span class="me-stat-num">@s.Count</span>
                    <span class="me-stat-label">@s.Label</span>
                </a>
            }
        </div>
    }
</section>

@* ---------- 安卓客户端下载：侧栏底部和页脚也有入口，这里再放一个，从「我的」找设置的人能撞见 ---------- *@
<section class="card">
    <div class="page-head">
        <h2>安卓客户端</h2>
        <a class="btn secondary" href="/Download">@Html.Raw(Icons.Svg("download", 16)) 去下载</a>
    </div>
    <p class="hint" style="margin-top:6px;">装到手机上更好用：全屏无地址栏，日程到点能弹通知。客户端只是个壳，服务端更新后不用重装。</p>
</section>

<div class="me-grid">
    @* ---------- 基本资料 ---------- *@
    <section class="card">
        <h2>基本资料</h2>
        <p class="hint">昵称会显示在导航、留言和打卡记录里；邮箱只有你自己和管理员看得到。</p>
        <form method="post" asp-page-handler="Profile">
            <div class="field">
                <label>登录名</label>
                <input value="@Model.Username" disabled />
                <p class="field-note">登录名不可自行修改，需要改请联系管理员。</p>
            </div>
            <div class="field">
                <label asp-for="DisplayName">昵称</label>
                <input asp-for="DisplayName" maxlength="20" required placeholder="最多 20 个字" />
            </div>
            <div class="field">
                <label asp-for="Email">联系邮箱（选填）</label>
                <input asp-for="Email" maxlength="100" placeholder="you@example.com" />
            </div>
            <div class="field">
                <label asp-for="Signature">个性签名（选填）</label>
                <textarea asp-for="Signature" rows="3" maxlength="60" placeholder="一句话介绍自己，最多 60 字"></textarea>
            </div>
            <button class="btn" type="submit">保存资料</button>
        </form>
    </section>

    @* ---------- 修改密码 ---------- *@
    <section class="card">
        <h2>修改密码</h2>
        <p class="hint">至少 8 位，须同时包含字母和数字。改完立即生效，下次登录请用新密码。</p>
        <form method="post" asp-page-handler="Password">
            <div class="field">
                <label asp-for="OldPassword">当前密码</label>
                <input asp-for="OldPassword" type="password" autocomplete="current-password" required />
            </div>
            <div class="field">
                <label asp-for="NewPassword">新密码</label>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword">确认新密码</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
            </div>
            <button class="btn" type="submit">修改密码</button>
        </form>
    </section>
</div>

@* ---------- 测试数据：一键生成 / 一键清除 ---------- *@
<section class="card me-sample">
    <div class="page-head">
        <h2>测试数据</h2>
        <span class="chip">当前 @Model.SampleRows 条</span>
    </div>
    <p class="hint">
        每个模块生成 3 条样例，方便新账号一眼看清各功能长什么样。
        所有记录都以「@CheckinApp.Services.SampleData.Mark」开头、备注里写着「示例数据，可删除」，
        清除时只删这些带标记的行，你自己的真实数据一条都不会动。
    </p>
    <div class="me-actions">
        <form method="post" asp-page-handler="Sample">
            <button class="btn" type="submit">生成测试数据</button>
        </form>
        @if (Model.SampleRows > 0)
        {
            <form method="post" asp-page-handler="ClearSample"
                  onsubmit="return confirm('确定清除全部测试数据？只会删掉带「【测试】」标记的记录，真实数据不受影响。');">
                <button class="btn secondary" type="submit">清除测试数据</button>
            </form>
        }
    </div>
</section>
