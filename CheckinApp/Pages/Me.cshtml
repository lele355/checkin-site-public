@page
@model CheckinApp.Pages.MeModel
@{
    ViewData["Title"] = "个人主页";
}

@if (TempData["Ok"] is string ok)
{
    <div class="msg ok">@ok</div>
}
@if (TempData["Err"] is string err)
{
    <div class="msg error">@err</div>
}

@* ---------- 名片：头像 + 名字 + 角色 + 签名 + 加入/登录时间 ---------- *@
<section class="card me-hero">
    <div class="me-avatar" aria-hidden="true">@Model.Avatar</div>
    <div class="me-hero-text">
        <h1 class="me-name">@Model.DisplayName</h1>
        <div class="me-tags">
            <span class="chip">@Model.RoleName</span>
            <span class="mini">@("@" + Model.Username)</span>
        </div>
        @if (string.IsNullOrWhiteSpace(Model.Signature))
        {
            <p class="me-sign me-sign-empty">还没有个性签名</p>
        }
        else
        {
            <p class="me-sign">@Model.Signature</p>
        }
    </div>
    <div class="me-hero-meta mini">
        <span>加入于 @Model.CreatedAt.ToString("yyyy-MM-dd")</span>
        @if (Model.LastLoginAt is DateTime last)
        {
            <span>上次登录 @last.ToString("MM-dd HH:mm")</span>
        }
    </div>
</section>

@* ---------- 数据概览：有权限的模块才出现 ---------- *@
<section class="card">
    <div class="page-head">
        <h2>我的数据</h2>
    </div>
    @if (Model.Stats.Count == 0)
    {
        <div class="empty">
            <span class="big">◎</span>
            当前角色还没有任何模块权限，请联系管理员开通。
        </div>
    }
    else
    {
        <div class="me-stats">
            @foreach (var s in Model.Stats)
            {
                <a class="me-stat" href="@s.Url">
                    <span class="me-stat-ico">@Html.Raw(Icons.Svg(s.Icon, 17))</span>
                    <span class="me-stat-num">@s.Count</span>
                    <span class="me-stat-label">@s.Label</span>
                </a>
            }
        </div>
    }
</section>

@* ---------- 账户：只读行 + 二级编辑入口（弹窗表单） ---------- *@
<section class="card">
    <h2>账户</h2>
    <div class="stack" style="margin-top:12px;">
        <div class="row-item" style="display:flex;align-items:center;gap:12px;">
            <span class="mini" style="flex-shrink:0;">登录名</span>
            <span style="flex:1;min-width:0;text-align:right;">@Model.Username</span>
        </div>
        <div class="row-item" style="display:flex;align-items:center;gap:12px;">
            <span class="mini" style="flex-shrink:0;">昵称</span>
            <span style="flex:1;min-width:0;text-align:right;">@Model.DisplayName</span>
        </div>
        <div class="row-item" style="display:flex;align-items:center;gap:12px;">
            <span class="mini" style="flex-shrink:0;">联系邮箱</span>
            <span style="flex:1;min-width:0;text-align:right;word-break:break-all;">@(string.IsNullOrWhiteSpace(Model.Email) ? "未填写" : Model.Email)</span>
        </div>
        <div class="row-item" style="display:flex;align-items:center;gap:12px;">
            <span class="mini" style="flex-shrink:0;">个性签名</span>
            <span style="flex:1;min-width:0;text-align:right;">@(string.IsNullOrWhiteSpace(Model.Signature) ? "未填写" : Model.Signature)</span>
        </div>
    </div>
    <div class="me-actions">
        <a class="btn" href="/Me/Edit">编辑资料</a>
        <a class="btn secondary" href="/Me/Password" data-modal="open">修改密码</a>
    </div>
</section>

@* ---------- 更多：低频工具收进行内入口 ---------- *@
<section class="card">
    <h2>更多</h2>
    <div class="stack" style="margin-top:12px;">
        <a class="row-item" href="/Me/Sample" data-modal="open" style="display:flex;align-items:center;gap:12px;">
            <span style="flex:1;min-width:0;">测试数据</span>
            <span class="chip">当前 @Model.SampleRows 条</span>
        </a>
        <a class="row-item" href="/Download" style="display:flex;align-items:center;gap:12px;">
            <span style="flex:1;min-width:0;">下载 App</span>
        </a>
    </div>
</section>
