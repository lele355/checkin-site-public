@page
@model CheckinApp.Pages.Ai.IndexModel
@{
    ViewData["Title"] = "AI 助手";
}

<div class="card">
    <div class="page-head">
        <h2>AI 助手</h2>
        <form method="post" asp-page-handler="Clear" data-confirm="确认清空">
            <button class="btn secondary" type="submit">清空历史</button>
        </form>
    </div>
    <p class="hint" style="margin-top:8px;">
        可以问问题，也可以直接说「明天下午三点开会」「记一笔午饭 15 元」——
        AI 会给出建议单，<strong>你点了确认才会真正写入</strong>。
    </p>
    <p class="hint" style="margin-top:4px;">
        今日已用 <strong>@Model.TodayTokens.ToString("N0")</strong> / @Model.TokenLimit.ToString("N0") tokens
    </p>
</div>

@if (Model.Notice is string notice)
{
    <div class="msg @(Model.NoticeIsError ? "error" : "ok")">@notice</div>
}

@if (Model.History.Count == 0)
{
    <div class="card"><div class="empty"><span class="big">✨</span>和 AI 助手打个招呼吧，比如「今天有什么安排？」</div></div>
}

<div class="ai-chat">
    @foreach (var item in Model.History)
    {
        var m = item.Msg;
        <div class="ai-row @(m.Role == "user" ? "me" : "")">
            <div class="ai-bubble">
                @if (!string.IsNullOrWhiteSpace(m.ImageMime))
                {
                    <a class="ai-shot" href="/Ai?handler=Image&id=@m.Id" target="_blank" rel="noopener">
                        <img src="/Ai?handler=Image&id=@m.Id" alt="随消息图片" loading="lazy" />
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(m.Content))
                {
                    <div style="white-space:pre-wrap;">@m.Content</div>
                }

                @if (item.Cards.Count > 0)
                {
                    <div class="ai-suggest">
                        <div class="ai-suggest-title">建议单（确认后才会写入）</div>
                        @foreach (var c in item.Cards)
                        {
                            <div class="ai-act">
                                <div class="ai-act-body">
                                    <span class="chip">@c.Label</span>
                                    <span class="ai-act-sum">@c.Summary</span>
                                </div>
                                <div class="ai-act-btns">
                                    <form method="post" asp-page-handler="Execute">
                                        <input type="hidden" name="msgId" value="@m.Id" />
                                        <input type="hidden" name="actIndex" value="@c.Index" />
                                        <button class="btn" type="submit" style="padding:6px 14px;font-size:.85rem;">确认执行</button>
                                    </form>
                                    <form method="post" asp-page-handler="Dismiss">
                                        <input type="hidden" name="msgId" value="@m.Id" />
                                        <button class="btn secondary" type="submit" style="padding:6px 14px;font-size:.85rem;">忽略</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="mini" style="margin-top:6px;">@m.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</div>
            </div>
        </div>
    }
</div>

<div class="card ai-input-card">
    <form method="post" asp-page-handler="Send" id="aiForm" data-autopick="@(Model.AutoPickImage ? "1" : "0")">
        @* 待发送图片预览（选图后由前端压缩成 data URL 塞进隐藏字段） *@
        <div class="ai-preview" id="aiPreview" hidden>
            <img id="aiPreviewImg" alt="待发送图片" />
            <button type="button" class="ai-preview-del" id="aiPreviewDel" aria-label="移除图片">✕</button>
        </div>
        <div class="ai-input-row">
            <button type="button" class="ai-attach" id="aiAttach" aria-label="添加图片" title="添加图片">@Html.Raw(Icons.Svg("paperclip", 18))</button>
            <input type="file" id="aiFile" accept="image/*" hidden />
            <input type="hidden" name="image" id="aiImageData" />
            <textarea name="text" rows="2" maxlength="2000" placeholder="问点什么，或让我帮你记日程/备忘/账…">@Model.DraftText</textarea>
            <button class="btn" type="submit" id="aiSend">发送</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    (function () {
        var chat = document.querySelector('.ai-chat');

        // 新消息滚进视野（无历史时 .ai-chat 是空的，直接跳过）
        function scrollToLast() {
            if (!chat) return;
            var rows = chat.querySelectorAll('.ai-row');
            if (rows.length) rows[rows.length - 1].scrollIntoView({ block: 'nearest' });
        }

        var form = document.getElementById('aiForm');
        if (!form) return;
        var btn = document.getElementById('aiSend');
        var ta = form.querySelector('textarea');

        // ---------- 图片：选图 → 压缩 → 预览（只随这一轮发送） ----------
        var fileInput = document.getElementById('aiFile');
        var attach = document.getElementById('aiAttach');
        var imgData = document.getElementById('aiImageData');
        var preview = document.getElementById('aiPreview');
        var previewImg = document.getElementById('aiPreviewImg');
        var previewDel = document.getElementById('aiPreviewDel');

        // 最长边压到 1600px、JPEG 0.82：手机原图 3-5MB → 约 100-400KB（官方上限 5MB 有余量）
        function compress(file) {
            return new Promise(function (resolve, reject) {
                var url = URL.createObjectURL(file);
                var img = new Image();
                img.onload = function () {
                    URL.revokeObjectURL(url);
                    var max = 1600;
                    var w = img.naturalWidth || img.width;
                    var h = img.naturalHeight || img.height;
                    var scale = Math.min(1, max / Math.max(w, h));
                    var cw = Math.max(1, Math.round(w * scale));
                    var ch = Math.max(1, Math.round(h * scale));
                    var cv = document.createElement('canvas');
                    cv.width = cw; cv.height = ch;
                    var ctx = cv.getContext('2d');
                    ctx.fillStyle = '#fff';                  // PNG 透明底转 JPEG 补白
                    ctx.fillRect(0, 0, cw, ch);
                    ctx.drawImage(img, 0, 0, cw, ch);
                    resolve(cv.toDataURL('image/jpeg', 0.82));
                };
                img.onerror = function () { URL.revokeObjectURL(url); reject(new Error('decode')); };
                img.src = url;
            });
        }

        if (attach && fileInput) {
            attach.addEventListener('click', function () { fileInput.click(); attach.classList.remove('pulse'); });
            fileInput.addEventListener('change', function () {
                var f = fileInput.files && fileInput.files[0];
                fileInput.value = '';                        // 允许重复选同一张
                if (!f || !/^image\//.test(f.type)) return;
                compress(f).then(function (dataUrl) {
                    imgData.value = dataUrl;
                    previewImg.src = dataUrl;
                    preview.hidden = false;
                    attach.classList.remove('pulse');
                }).catch(function () {
                    alert('这张图片读不出来，换一张试试。');
                });
            });
        }
        if (previewDel) {
            previewDel.addEventListener('click', function () {
                imgData.value = '';
                previewImg.removeAttribute('src');
                preview.hidden = true;
            });
        }

        // 从课程表页「从截图导入」跳过来：浏览器的安全策略不允许在没有用户手势的情况下
        // 直接弹出文件选择框，所以这里先试一次，打不开就把附件按钮打成呼吸灯引导用户点。
        if (form.dataset.autopick === '1' && attach) {
            attach.classList.add('pulse');
            try { fileInput.click(); } catch (e) { /* 被拦就靠呼吸灯 */ }
        }

        // ---------- 发送等待：本地回显 + 分段文案 ----------
        // 这轮请求后端要 17~40 秒（整张课表截图更久），整页 POST 期间浏览器一直停在
        // 当前页面，什么也不给就会让人以为没按上 → 连点几次就是几条重复消息 + 几倍 token。
        // 所以：按下就把「我发的这条」画进列表，再挂一条带秒数的状态行。
        var pending = null;      // { row, wait, timer, secs }
        var sent = false;        // 已提交，等新页面到达

        // 与 App 侧同一套分段（App: waited &lt; 3 / &lt; 10 / &lt; 25 / else）
        function stageText(secs) {
            if (secs < 3) return '已发送，正在等 AI 回应…';
            if (secs < 10) return 'AI 正在读你的问题…';
            if (secs < 25) return '正在生成回复，这一步稍慢…';
            return '还在算，网络或长截图会让它更久…';
        }
        // 提示要跟着「这条到底带没带图」走：纯文字说「带图片要 20~40 秒」纯属误导
        function tipText(secs, hasImg) {
            if (secs >= 45) return '已经比较久了，可以继续等，也可以刷新页面放弃后换个问法。';
            if (secs >= 8 && hasImg) return '带图片的请求要逐行识别，通常 20~40 秒。';
            if (secs >= 20 && !hasImg) return '纯文字一般十几秒，这会儿可能是服务器在排队。';
            return '';
        }

        function drawPending(text, imgUrl) {
            var wrap = document.createElement('div');
            wrap.className = 'ai-row me';
            var bubble = document.createElement('div');
            bubble.className = 'ai-bubble';

            if (imgUrl) {
                var shot = document.createElement('a');
                shot.className = 'ai-shot';
                shot.href = imgUrl;                      // data URL，新标签里直接能看
                var im = document.createElement('img');
                im.src = imgUrl;
                im.alt = '随消息图片';
                shot.appendChild(im);
                bubble.appendChild(shot);
            }
            if (text) {
                var body = document.createElement('div');
                body.style.whiteSpace = 'pre-wrap';
                body.textContent = text;                 // 保住换行，不解析 HTML
                bubble.appendChild(body);
            }
            var tag = document.createElement('div');
            tag.className = 'ai-sent-tag';
            tag.textContent = '已发出，等回复…';
            bubble.appendChild(tag);
            wrap.appendChild(bubble);            // 气泡必须挂进行里，否则行是空的

            var wait = document.createElement('div');
            wait.className = 'ai-row';
            wait.innerHTML =
                '<div class="ai-bubble">' +
                  '<div class="ai-wait">' +
                    '<div class="ai-wait-top">' +
                      '<span class="ai-spin"></span>' +
                      '<span class="ai-wait-text"></span>' +
                      '<span class="ai-wait-sec"></span>' +
                    '</div>' +
                    '<div class="ai-wait-tip" hidden></div>' +
                  '</div>' +
                '</div>';

            if (!chat) {                                  // 无历史时页面里没有 .ai-chat 容器
                chat = document.createElement('div');
                chat.className = 'ai-chat';
                var anchor = document.querySelector('.ai-input-card');
                anchor.parentNode.insertBefore(chat, anchor);
            }
            chat.appendChild(wrap);
            chat.appendChild(wait);

// 空状态卡（「和 AI 助手打个招呼吧」）在回显出现后就该收起来。
            // 站点 CSS 会盖掉 [hidden]（.card 有 display 规则），所以直接写 style。
            var empty = chat.parentNode.querySelector('.empty');
            if (empty) empty.closest('.card').style.display = 'none';

            pending = {
                row: wrap, wait: wait, secs: 0, hasImg: !!imgUrl,
                textEl: wait.querySelector('.ai-wait-text'),
                secEl: wait.querySelector('.ai-wait-sec'),
                tipEl: wait.querySelector('.ai-wait-tip'),
                tagEl: tag,
            };
            tick();
            pending.timer = setInterval(tick, 1000);
            wrap.scrollIntoView({ block: 'nearest' });
        }

        function tick() {
            if (!pending) return;
            var s = pending.secs++;
            pending.textEl.textContent = stageText(s);
            pending.secEl.textContent = s + 's';
            var tip = tipText(s, pending.hasImg);
            if (tip) {
                pending.tipEl.textContent = tip;
                pending.tipEl.hidden = false;
            }
        }

        function cancelPending() {
            if (!pending) return;
            clearInterval(pending.timer);
            if (pending.row.parentNode) pending.row.parentNode.removeChild(pending.row);
            if (pending.wait.parentNode) pending.wait.parentNode.removeChild(pending.wait);
            pending = null;
        }

        function resetButton() {
            btn.disabled = false;
            btn.classList.remove('is-loading');
            btn.textContent = '发送';
        }

        form.addEventListener('submit', function (e) {
            var text = ta.value.trim();
            if (!text && !imgData.value) {
                e.preventDefault();
                ta.focus();
                return;
            }
            if (sent) {                                  // 已经提交过，连点直接忽略
                e.preventDefault();
                return;
            }
            sent = true;

            drawPending(text, imgData.value || '');

            btn.disabled = true;
            btn.classList.add('is-loading');             // 复用全站的按钮转圈（::after 圆环）
            btn.textContent = '发送';

            // 输入框先清空，但保留在变量里：万一用户用浏览器「返回」回到这一页，
            // 缓存的页面会把输入框恢复成清空态，不会重复发一遍。
            ta.value = '';
            imgData.value = '';
            previewImg.removeAttribute('src');
            preview.hidden = true;
        });

        // Ctrl+Enter 发送（手机上直接点按钮）
        ta.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                e.preventDefault();
                form.requestSubmit();
            }
        });

        // 从 bfcache 返回（点了浏览器后退 / 页面被缓存恢复）：这一页的请求早已结束，
        // 等待行和禁用状态都得撤掉，否则看起来像永远卡住。
        window.addEventListener('pageshow', function (ev) {
            if (!ev.persisted && !sent) return;
            sent = false;
            cancelPending();
            resetButton();
        });

        scrollToLast();
    })();
</script>
}
