@page
@model CheckinApp.Pages.PyLabModel
@{
    ViewData["Title"] = "Python 教学平台";
}

<div id="pyToken" hidden>@Html.AntiForgeryToken()</div>

<style>
    /* 站点全局给按钮/容器设了 display，会盖掉 UA 的 [hidden]{display:none}，
       导致 runBtn.hidden = true 之后元素还看得见。本页显式兜回来。 */
    .py-panel [hidden], .card [hidden] { display: none !important; }

    /* ═══════════════════════════════════════════════════════════════
       表单控件统一皮肤
       站点的皮肤只写在 .field 里，本页这些筛选/输入控件是裸的 <select>/<input>，
       会露出浏览器原生的圆角、凸起边框和蓝色聚焦圈，跟卡片完全两套语言。
       这里先给一套跟 .field 同源的皮肤，再逐主题对齐（含暗底 macos）：
       editorial 底线式 / neumorphism 凹陷 / natural 胶囊 / macos 半透边框 / clay 软糖。
       刻意全部写在本页 <style> 里，拆模块时随页面一起删，不动全局 CSS。
       ═══════════════════════════════════════════════════════════════ */
    .py-panel input:not([type="hidden"]):not([type="file"]),
    .py-panel select,
    .py-panel textarea {
        min-height: 44px; padding: 9px 13px;
        border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
        background-color: var(--card-soft); color: var(--text);
        font: inherit; font-size: .9rem; line-height: 1.45;
        transition: border-color var(--dur) var(--easing),
                    background-color var(--dur) var(--easing),
                    box-shadow var(--dur) var(--easing);
    }
    .py-panel input::placeholder, .py-panel textarea::placeholder { color: var(--text-weak); }

    /* 聚焦：跟 .field 一样只换边框色，另外加一圈很淡的 accent 光晕，
       让「输入中」这件事在浅色系里也看得出来 */
    .py-panel input:focus, .py-panel select:focus, .py-panel textarea:focus {
        outline: none; border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
    }

    /* 下拉框：去掉系统箭头，自己用两道渐变画一个随文字色走的折角箭头
       （不写死颜色，换主题/换底色时自动跟着变） */
    .py-panel select {
        -webkit-appearance: none; appearance: none;
        padding-right: 34px; cursor: pointer;
        background-image:
            linear-gradient(45deg, transparent 50%, var(--text-weak) 50%),
            linear-gradient(135deg, var(--text-weak) 50%, transparent 50%);
        background-position: calc(100% - 18px) center, calc(100% - 13px) center;
        background-size: 5px 5px, 5px 5px;
        background-repeat: no-repeat;
    }
    /* 数字框去掉上下小箭头：那是操作系统画的，跟页面任何主题都不搭 */
    .py-panel input[type="number"]::-webkit-outer-spin-button,
    .py-panel input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .py-panel input[type="number"] { -moz-appearance: textfield; }

    .py-panel textarea { resize: vertical; line-height: 1.65; }
    /* 名单是「一行一个人」，等宽字体更好对齐 */
    #pyRosterText { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; }

    /* ── 主题 1：editorial —— 底线式输入，直角，无阴影 ── */
    [data-theme="editorial"] .py-panel input:not([type="hidden"]):not([type="file"]),
    [data-theme="editorial"] .py-panel select,
    [data-theme="editorial"] .py-panel textarea {
        border: none; border-bottom: 1px solid rgba(28, 28, 28, .20);
        border-radius: 0; background-color: transparent;
        padding-left: 0; padding-right: 0;
    }
    [data-theme="editorial"] .py-panel select { padding-right: 26px; }
    [data-theme="editorial"] .py-panel input:focus,
    [data-theme="editorial"] .py-panel select:focus,
    [data-theme="editorial"] .py-panel textarea:focus {
        border-bottom: 1px solid #1C1C1C; box-shadow: none;
    }

    /* ── 主题 2：neumorphism —— 无边框，内阴影成「凹槽」，聚焦变浅 ── */
    [data-theme="neumorphism"] .py-panel input:not([type="hidden"]):not([type="file"]),
    [data-theme="neumorphism"] .py-panel select,
    [data-theme="neumorphism"] .py-panel textarea {
        border: none; background-color: var(--card-soft);
        box-shadow: var(--shadow-inset);
    }
    [data-theme="neumorphism"] .py-panel input:focus,
    [data-theme="neumorphism"] .py-panel select:focus,
    [data-theme="neumorphism"] .py-panel textarea:focus {
        border-color: transparent; box-shadow: var(--shadow-inset-sm);
    }

    /* ── 主题 3：natural —— 胶囊 + 白底 ── */
    [data-theme="natural"] .py-panel input:not([type="hidden"]):not([type="file"]),
    [data-theme="natural"] .py-panel select {
        border-radius: 999px; background-color: #ffffff; padding-left: 18px;
    }
    [data-theme="natural"] .py-panel select { padding-right: 36px; }
    [data-theme="natural"] .py-panel textarea { border-radius: 22px; background-color: #ffffff; }

    /* ── 主题 4：macos —— 深色，半透边框，底色比卡片再深一档 ── */
    [data-theme="macos"] .py-panel input:not([type="hidden"]):not([type="file"]),
    [data-theme="macos"] .py-panel select,
    [data-theme="macos"] .py-panel textarea {
        background-color: var(--bg); border-color: rgba(255, 255, 255, .10);
        /* 没有这句，下拉展开的弹层会按浅色渲染：白底 + 浅色字，等于看不见 */
        color-scheme: dark;
    }
    [data-theme="macos"] .py-panel input:focus,
    [data-theme="macos"] .py-panel select:focus,
    [data-theme="macos"] .py-panel textarea:focus {
        border-color: rgba(255, 255, 255, .28); box-shadow: 0 0 0 3px rgba(10, 132, 255, .20);
    }

    /* ── 主题 5：clay —— 软糖质感，大圆角 + 内阴影 ──
       注意 --clay-in 是个渐变（不是颜色），必须走 background-image，
       写成 background-color 会变成无效声明被浏览器静默丢掉。
       下拉框的折角箭头也是 background-image，所以这里叠成多层背景：箭头在上、渐变铺底。 */
    [data-theme="clay"] .py-panel input:not([type="hidden"]):not([type="file"]),
    [data-theme="clay"] .py-panel textarea {
        border: none; border-radius: 20px;
        background-color: #fdf0f5; background-image: var(--clay-in);
        box-shadow: var(--shadow-inset);
    }
    [data-theme="clay"] .py-panel select {
        border: none; border-radius: 20px;
        background-color: #fdf0f5;
        background-image:
            linear-gradient(45deg, transparent 50%, var(--text-weak) 50%),
            linear-gradient(135deg, var(--text-weak) 50%, transparent 50%),
            var(--clay-in);
        background-position: calc(100% - 18px) center, calc(100% - 13px) center, 0 0;
        background-size: 5px 5px, 5px 5px, 100% 100%;
        background-repeat: no-repeat;
        box-shadow: var(--shadow-inset);
    }
    [data-theme="clay"] .py-panel input:focus,
    [data-theme="clay"] .py-panel select:focus,
    [data-theme="clay"] .py-panel textarea:focus {
        border-color: transparent; box-shadow: var(--shadow-inset-sm);
    }

    /* 播放控制条里的控件比按钮矮一档，单独收一下高度，免得一排放不下 */
    .py-slidebar .btn { min-height: 36px; height: 36px; padding: 0 14px; }
    .py-slidebar .py-num { min-height: 36px; padding: 4px 10px; }
    /* 课件卡片里的「移分类」下拉 */
    .py-deck select { min-height: 32px; padding: 4px 28px 4px 9px; font-size: 12px; }


    .py-badge {
        font-size: 12px; padding: 4px 10px; border-radius: 999px; white-space: nowrap;
        background: var(--ok-soft); color: var(--ok);
    }
    .py-badge.bad { background: var(--danger-soft); color: var(--danger); }

    .py-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 16px 0 4px; }
    .py-tab {
        padding: 9px 15px; border-radius: var(--radius-sm); border: 1px solid var(--border);
        background: var(--card); color: var(--text-sub); cursor: pointer; font-size: 14px;
        font-family: inherit; transition: background var(--dur) var(--easing),
        color var(--dur) var(--easing), border-color var(--dur) var(--easing);
    }
    .py-tab:hover { border-color: var(--border-strong); color: var(--text); }
    .py-tab.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 600; }

    .py-panel { display: none; }
    .py-panel.on { display: block; }

    /* 分段控件（播放 / 课件库） */
    .py-seg {
        display: inline-flex; gap: 2px; padding: 3px; margin: 12px 0 8px;
        background: var(--card-soft); border: 1px solid var(--border); border-radius: 999px;
    }
    .py-segbtn {
        padding: 6px 16px; font-size: 13px; border: 0; border-radius: 999px; cursor: pointer;
        background: transparent; color: var(--text-sub); font-family: inherit;
    }
    .py-segbtn.on { background: var(--card); color: var(--text); font-weight: 600; box-shadow: 0 1px 3px rgba(0,0,0,.08); }

    .py-stage {
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
        min-height: 200px; padding: 20px; margin: 4px 0 16px; text-align: center;
        border: 1px dashed var(--border-strong); border-radius: var(--radius-lg); background: var(--card-soft);
    }
    .py-name {
        font-family: var(--font-head); font-size: 46px; font-weight: var(--head-weight);
        color: var(--text); letter-spacing: .05em; line-height: 1.3; word-break: break-all;
    }
    .py-name.multi { font-size: 30px; }
    .py-meta { color: var(--text-weak); font-size: 13px; }

    .py-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 10px; min-width: 0; }
    .py-num { width: 90px; text-align: center; }

    /* 工具栏：不换行的紧凑一排，窄屏自动折行 */
    .py-toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; min-width: 0; }
    .py-toolbar label { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-sub); min-width: 0; }
    .py-toolbar select, .py-toolbar input { max-width: 100%; }

    .py-pre {
        background: var(--card-soft); border: 1px solid var(--border); border-radius: var(--radius);
        padding: 13px 15px; overflow: auto; margin: 10px 0 0; max-height: 320px; white-space: pre;
        font-family: ui-monospace, "Cascadia Code", Consolas, monospace; font-size: 13px;
        line-height: 1.7; color: var(--text); tab-size: 4;
    }
    /* 代码/输出并排容器：窄屏一列（就是原来的上下堆叠），宽屏两列对照 */
    .py-code2 { display: grid; gap: 12px; grid-template-columns: 1fr; margin-top: 10px; }
    .py-code2 .py-codecol { min-width: 0; }
    .py-code2 .py-pre { min-height: 120px; }
    .py-out { border-left: 3px solid var(--ok); }
    .py-out.bad { border-left-color: var(--danger); }
    .py-out-head {
        display: flex; justify-content: space-between; align-items: baseline; gap: 10px;
        font-size: 13px; color: var(--text-weak); margin-top: 12px;
    }

    .py-split { display: flex; gap: 14px; align-items: flex-start; }
    .py-split > .py-left { flex: 1 1 60%; min-width: 0; }
    .py-split > .py-right { flex: 1 1 36%; min-width: 0; }
    @@media (max-width: 1100px) {
        .py-split { flex-direction: column; }
        .py-split > .py-left, .py-split > .py-right { flex: 1 1 auto; width: 100%; }
    }

    /* ---------- 播放器 ---------- */
    .py-slide {
        position: relative; display: flex; align-items: center; justify-content: center;
        width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: var(--radius);
        overflow: hidden; margin-top: 10px;
    }
    .py-slide img { width: 100%; height: 100%; object-fit: contain; display: block; }
    /* 矢量模式：PDF.js 把当前页画到 canvas 上。位图按物理像素出，CSS 只负责等比缩到容器里，
       max-* 而不是固定 100% —— 否则 4:3 的课件会被拉成 16:9 变形 */
    .py-slide canvas { max-width: 100%; max-height: 100%; display: block; }
    /* 翻页过渡：新页淡入，不再是硬切（reduce-motion 时 JS 会跳过，这里自然也不会有观感变化） */
    .py-slide img, .py-slide canvas { transition: opacity .18s var(--easing); }
    .py-slide .py-empty { color: #bbb; padding: 0 24px; }
    /* 图片还在下载时的一句话提示：居中浮在黑底上，不抢点击 */
    .py-slide .py-loading {
        position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        color: #9aa0a6; font-size: 14px; letter-spacing: .12em; pointer-events: none;
    }

    /* 播放模式切换（矢量 / 图片）：比顶部分段控件小一档，挤在工具栏里不抢戏 */
    .py-modes {
        display: inline-flex; gap: 2px; padding: 2px; flex: 0 0 auto;
        background: var(--card-soft); border: 1px solid var(--border); border-radius: 999px;
    }
    .py-modebtn {
        padding: 4px 10px; font-size: 12px; border: 0; border-radius: 999px; cursor: pointer;
        background: transparent; color: var(--text-sub); font-family: inherit; white-space: nowrap;
    }
    .py-modebtn.on { background: var(--card); color: var(--text); font-weight: 600; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .py-slidebar {
        display: flex; gap: 10px; align-items: center; justify-content: space-between;
        margin-top: 10px; font-size: 13px; color: var(--text-weak); min-width: 0; flex-wrap: wrap;
    }
    .py-slidebar .py-grp { display: flex; gap: 8px; align-items: center; min-width: 0; flex-wrap: wrap; }
    /* 播放控制按钮：别让文字折成两行，「全屏播放」曾被挤成「全屏播/放」 */
    .py-slidebar .btn { white-space: nowrap; font-size: 13px; }
    .py-slidebar input.py-num { width: 78px; }

    /* 全屏：投屏场景，刻意用纯黑底 + 浅色字，不跟站点主题走 */
    .py-slide:fullscreen {
        aspect-ratio: auto; width: 100vw; height: 100vh; border-radius: 0; margin: 0;
    }
    .py-slide .py-fsbar { display: none; }
    .py-slide:fullscreen .py-fsbar {
        display: flex; position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%);
        gap: 10px; align-items: center; padding: 8px 14px; border-radius: 999px;
        background: rgba(0,0,0,.55); color: #fff; backdrop-filter: blur(6px); font-size: 13px;
    }
    .py-slide:fullscreen .py-fsbar button {
        border: 1px solid rgba(255,255,255,.35); background: rgba(255,255,255,.12); color: #fff;
        border-radius: 999px; padding: 5px 12px; cursor: pointer; font-family: inherit; font-size: 13px;
    }
    .py-slide:fullscreen .py-fsbar button:hover { background: rgba(255,255,255,.24); }
    .py-fade { position: absolute; inset: auto 0 0 0; height: 90px;
        background: linear-gradient(transparent, rgba(0,0,0,.45)); pointer-events: none; }

    /* 缩略图条 */
    .py-thumbs { display: flex; gap: 6px; overflow-x: auto; padding: 10px 2px 2px; scrollbar-width: thin; }
    .py-thumbs img {
        flex: 0 0 auto; width: 92px; height: 52px; object-fit: contain; background: #000;
        border: 2px solid transparent; border-radius: 5px; cursor: pointer; opacity: .65;
        transition: opacity var(--dur) var(--easing), border-color var(--dur) var(--easing);
    }
    .py-thumbs img:hover { opacity: 1; }
    .py-thumbs img.on { border-color: var(--accent); opacity: 1; }

    /* ---------- 课件库 ---------- */
    .py-decks { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; margin-top: 12px; }
    .py-deck {
        border: 1px solid var(--border); border-radius: var(--radius); background: var(--card-soft);
        overflow: hidden; display: flex; flex-direction: column; min-width: 0;
    }
    .py-deck .cover {
        aspect-ratio: 16 / 9; background: #000; display: flex; align-items: center; justify-content: center;
        color: #888; font-size: 12px; overflow: hidden;
    }
    .py-deck .cover img { width: 100%; height: 100%; object-fit: contain; }
    .py-deck .body { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .py-deck .body h4 { margin: 0; font-size: 14px; font-family: var(--font-head); color: var(--text);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .py-deck .sub { font-size: 12px; color: var(--text-weak); display: flex; gap: 8px; flex-wrap: wrap; }
    .py-deck .acts { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 2px; }
    .py-deck .acts .btn { padding: 5px 10px; font-size: 12px; }

    .py-cats { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 4px; }
    .py-cat {
        display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; font-size: 12px;
        border: 1px solid var(--border); border-radius: 999px; background: var(--card);
        color: var(--text-sub); max-width: 100%;
    }
    .py-cat b { font-weight: 600; color: var(--text); }
    .py-cat button { border: 0; background: transparent; cursor: pointer; color: var(--text-weak);
        font-size: 12px; padding: 0 2px; font-family: inherit; }
    .py-cat button:hover { color: var(--danger); }

    .py-drop {
        border: 1px dashed var(--border-strong); border-radius: var(--radius); background: var(--card-soft);
        padding: 18px; text-align: center; margin-top: 10px;
    }
    .py-drop.over { border-color: var(--accent); background: var(--accent-soft); }
    .py-drop .big { font-size: 14px; color: var(--text); margin-bottom: 6px; }

    .py-uploadbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 10px; }
    .py-uploadbar input[type="text"] { flex: 1 1 200px; min-width: 0; }

    .py-prog { height: 6px; border-radius: 999px; background: var(--border); overflow: hidden; margin-top: 10px; }
    .py-prog > i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .2s linear; }
    .py-status { font-size: 13px; color: var(--text-sub); margin-top: 8px; }

    /* ---------- 名单 ---------- */
    .py-import textarea { width: 100%; margin-top: 10px; }
    .py-scroll { max-height: 320px; overflow: auto; margin-top: 6px; }
    .py-del { border: 0; background: transparent; color: var(--text-weak); cursor: pointer; font-size: 12px; font-family: inherit; }
    .py-del:hover { color: var(--danger); }

    .py-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 10px; }
    .py-table th, .py-table td { padding: 7px 8px; border-bottom: 1px solid var(--border); text-align: left; }
    .py-table th { color: var(--text-weak); font-weight: 500; position: sticky; top: 0; background: var(--card); }
    .py-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .py-table tr.me td { color: var(--accent); }

    .py-empty { color: var(--text-weak); font-size: 13px; padding: 16px 0; text-align: center; }
    .py-err { color: var(--danger); font-size: 13px; white-space: pre-wrap; margin-top: 8px; }
    .py-hint-line { font-size: 13px; color: var(--text-weak); }
    .py-tag {
        font-size: 11px; color: var(--accent); background: var(--accent-soft);
        padding: 2px 8px; border-radius: 999px; align-self: flex-start;
    }
    .py-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-top: 12px; }

    /* ---------- 宽屏填充（内容区不再锁 1200px 之后） ----------
       ① 说明卡：四个功能并排，窄屏自动回落成单列；
       ② 点名舞台：投屏场景，屏越大姓名越醒目（手机上不动，保持原尺寸）；
       ③ 播放页：宽屏多给播放区一点，代码块跟着长高，右列不再半屏空着。 */
    .py-feats {
        display: grid; gap: 10px; margin-top: 12px;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    }
    .py-feat {
        display: flex; gap: 10px; align-items: flex-start; min-width: 0;
        padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius);
        background: var(--card-soft);
    }
    .py-feat .n {
        flex: 0 0 auto; font-family: var(--font-head);
        font-size: 18px; line-height: 1.2; color: var(--accent);
    }
    .py-feat b { display: block; font-size: 13.5px; color: var(--text); margin-bottom: 2px; }
    .py-feat .d { display: block; font-size: 12.5px; color: var(--text-sub); line-height: 1.5; }

    .py-stage { min-height: clamp(200px, 26vh, 340px); }

    /* 全站给 .card > p 设了 92ch 的可读上限（防超宽屏长段落串行），
       但本页的 .py-hint-line 是一句「一行到底」的功能说明，
       被截断后会在句子中间折行，反而更难看——这里放行。 */
    .card > p.py-hint-line { max-width: none; }

    @@media (min-width: 1024px) {
        .py-name { font-size: clamp(46px, 3.2vw, 76px); }
        .py-name.multi { font-size: clamp(28px, 2.1vw, 46px); }
    }
    @@media (min-width: 1500px) {
        .py-split { gap: 16px; }
        .py-split > .py-left { flex: 1 1 64%; }
        .py-split > .py-right { flex: 1 1 34%; }
