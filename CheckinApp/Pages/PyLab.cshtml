@section Scripts {
<script>
(function () {
    // pjax 会把本脚本重跑一遍：状态挂在 window 上复用同一个对象，
    // 这样「只装一次」的 document 级监听也能一直看到最新状态。
    var P = window.__pyLab || (window.__pyLab = {});
    var ver = (P.ver || 0) + 1;
    P.ver = ver;
    P.boot = null;
    P.roster = { students: [], classes: [] };
    P.decks = { categories: [], decks: [], engines: {} };
    P.deckId = null;
    P.page = 1;
    P.snippetId = '';
    P.calledIds = [];
    P.lastPick = null;
    P.className = '';
    P.deckView = 'play';
    P.snippetLoaded = '';

    // 播放模式（矢量 / 图片）：用户选过就记住；没选过默认矢量 —— 有 PDF 的课件一律优先清晰。
    // 老课件没有 PDF，paintModes 会把开关藏掉、自动走图片模式，所以默认矢量不会踩空。
    if (P.slideMode !== 'vector' && P.slideMode !== 'image') {
        var savedMode = '';
        try { savedMode = localStorage.getItem('pylab.slideMode') || ''; } catch (e) { }
        P.slideMode = savedMode === 'image' ? 'image' : 'vector';
    }
    P.pdf = null;                 // 当前缓存的 PDF 文档（换课件就换掉）
    P.pdfErrDeck = null;          // 哪份课件的矢量版已经报过错（同一份只提醒一次）
    P.paintKey = '';              // 上一次画的是「哪份课件的第几页」，用来判断要不要淡入
    P.resizeTimer = 0;
    P.vecTimer = 0;               // 矢量升级的防抖计时器（连点课件时别白下好几份 PDF）

    function $(id) { return document.getElementById(id); }

    function token() {
        var el = document.querySelector('#pyToken input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    function enc(v) { return encodeURIComponent(v == null ? '' : String(v)); }

    /* ---------- HTTP：Python 桥 / 普通 JSON 处理器 ---------- */
    async function call(action, payload) {
        var body = { action: action, payload: Object.assign({ state: P.pythonState }, payload || {}) };
        var res = await fetch('/PyLab?handler=Call', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        var j = await res.json();
        if (!j.ok) throw new Error(j.error || '调用失败');
        if (j.data && j.data.state) P.pythonState = j.data.state;
        return j.data;
    }

    async function jget(handler, params) {
        var u = location.origin + '/PyLab?handler=' + handler;
        if (params) for (var k in params) u += '&' + enc(k) + '=' + enc(params[k]);
        var res = await fetch(u, { headers: { 'X-Requested-With': 'fetch' } });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        var j = await res.json();
        if (!j.ok) throw new Error(j.error || '请求失败');
        return j.data;
    }

    async function jpost(handler, fields) {
        var body = new URLSearchParams();
        for (var k in (fields || {})) body.append(k, fields[k] == null ? '' : fields[k]);
        var res = await fetch(location.origin + '/PyLab?handler=' + handler, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token() },
            body: body.toString()
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        var j = await res.json();
        if (!j.ok) throw new Error(j.error || '请求失败');
        return j.data;
    }

    function jpostForm(handler, fd) {
        // 上传要进度条，单独走 XMLHttpRequest
        return new Promise(function (resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', location.origin + '/PyLab?handler=' + handler);
            xhr.setRequestHeader('RequestVerificationToken', token());
            xhr.upload.onprogress = function (e) {
                if (e.lengthComputable) setProgress(e.loaded / e.total * 0.9);
            };
            xhr.onload = function () {
                // 反代层（nginx client_max_body_size）拦下来的大文件是没有 JSON 的 HTML，
                // 直接报 "HTTP 413" 谁也看不懂，这里翻成人话。
                if (xhr.status === 413) {
                    reject(new Error('课件太大，被服务器拒收（单份上限 60MB）。压缩后再传，或按章节拆开。'));
                    return;
                }
                var j = null;
                try { j = JSON.parse(xhr.responseText); } catch (err) { }
                if (!j) { reject(new Error('HTTP ' + xhr.status)); return; }
                if (!j.ok) { reject(new Error(j.error || '上传失败')); return; }
                resolve(j.data);
            };
            xhr.onerror = function () { reject(new Error('网络中断')); };
            xhr.send(fd);
        });
    }

    function showErr(msg) {
        var el = $('pyErr');
        if (el) el.textContent = msg ? '⚠ ' + msg : '';
    }

    function paintOut(preOut, titleEl, timeEl, run, okText, badText) {
        preOut.classList.toggle('bad', !run.ok);
        var text = '';
        if (run.output) text += run.output;
        if (run.error) text += (text ? '\n\n' : '') + run.error;
        if (!text) text = '（没有任何输出，可能忘了写 print）';
        preOut.textContent = text;
        if (titleEl && okText) titleEl.textContent = run.ok ? okText : badText;
        if (timeEl) timeEl.textContent = run.durationMs + ' ms';
    }

    /* ---------- tab ---------- */
    function switchTab(name) {
        var tabs = document.querySelectorAll('.py-tab');
        for (var i = 0; i < tabs.length; i++)
            tabs[i].classList.toggle('on', tabs[i].getAttribute('data-tab') === name);
        var panels = document.querySelectorAll('.py-panel');
        for (var j = 0; j < panels.length; j++)
            panels[j].classList.toggle('on', panels[j].getAttribute('data-panel') === name);
    }

    /* ═════════════ ① 点名 ═════════════ */
    function classFilter() { return P.className || ''; }

    function paintClasses() {
        var sel = $('pyClass');
        if (!sel) return;
        var classes = P.roster.classes || [];
        var html = '<option value="">全部（' + P.roster.students.length + ' 人）</option>';
        classes.forEach(function (c) {
            if (!c.raw) return;      // 未分班的 value 是空串，会和「全部」撞车，只在「全部」里出现
            html += '<option value="' + esc(c.raw) + '">' + esc(c.name) + '（' + c.count + '）</option>';
        });
        sel.innerHTML = html;
        sel.value = P.className;
        if (sel.value !== P.className) { sel.value = ''; P.className = ''; }
        var info = $('pyRollInfo');
        if (info) {
            info.textContent = '名单 ' + P.roster.students.length + ' 人'
                + (classes.length ? ' · ' + classes.length + ' 个班级' : '');
        }
        var cc = $('pyRosterCount');
        if (cc) cc.textContent = P.roster.students.length + ' 人';
    }

    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function studentsInClass() {
        var all = P.roster.students || [];
        if (!P.className) return all;
        return all.filter(function (s) { return s.className === P.className; });
    }

    function paintRosterTable() {
        var tbl = $('pyRosterTable');
        if (!tbl) return;
        var rows = studentsInClass();
        var html = '<thead><tr><th style="width:110px;">学号</th><th>姓名</th><th style="width:120px;">班级</th>' +
            '<th style="width:60px;"></th></tr></thead><tbody>';
        if (!rows.length) {
            html += '<tr><td colspan="4" class="py-empty">还没有学生。用上面的按钮导入一份名单吧。</td></tr>';
        } else {
            rows.forEach(function (s) {
                html += '<tr><td>' + esc(s.studentNo || '—') + '</td><td>' + esc(s.name) + '</td>' +
                    '<td>' + esc(s.className || '未分班') + '</td>' +
                    '<td><button class="py-del" data-del-student="' + s.id + '">删除</button></td></tr>';
            });
        }
        tbl.innerHTML = html + '</tbody>';
    }

    async function loadRoster() {
        var d = await jget('Roster');
        P.roster = d;
        paintClasses();
        paintRosterTable();
    }

    async function doPick() {
        showErr('');
        var n = parseInt($('pyCount').value, 10) || 1;
        var d = await jpost('Pick', {
            count: n,
            className: classFilter(),
            called: JSON.stringify(P.calledIds)
        });

        if (!d.picked || !d.picked.length) {
            $('pyName').textContent = '名单是空的';
            $('pyName').classList.remove('multi');
            $('pyMeta').textContent = d.message || '先导入学生名单';
            $('pyMarkRow').hidden = true;
            return;
        }

        P.calledIds = d.calledIds || [];
        P.lastPick = d.picked[0];

        var nameEl = $('pyName');
        nameEl.textContent = d.picked.map(function (p) { return p.name; }).join('  ·  ');
        nameEl.classList.toggle('multi', d.picked.length > 1);
        $('pyMeta').textContent = '本轮剩余 ' + d.remaining + ' / ' + d.total + ' 人'
            + (d.wrapped ? '（上一轮已抽完，自动进入新一轮）' : '');
        $('pyMarkName').textContent = d.picked.map(function (p) { return p.name; }).join('、');
        $('pyMarkRow').hidden = false;
    }

    async function doMark(status) {
        if (!P.lastPick) return;
        showErr('');
        await jpost('Mark', { studentId: P.lastPick.id, status: status });
        var label = { present: '出勤', late: '迟到', absent: '缺勤' }[status] || status;
        $('pyMeta').textContent = '已记录：' + P.lastPick.name + ' → ' + label;
        if ($('pyAttendance').innerHTML) await loadAttendance();
    }

    async function loadAttendance() {
        var d = await jget('Attendance');
        var html = '<div class="card"><div class="page-head">' +
            '<h2 style="font-size:16px;flex:1 1 auto;">考勤统计</h2>' +
            '<span class="py-hint-line">' +
            (d.avgRate == null ? '暂无记录' : '平均出勤率 ' + d.avgRate + '%') +
            '</span></div><table class="py-table"><thead><tr>' +
            '<th>姓名</th><th class="num">出勤</th><th class="num">迟到</th>' +
            '<th class="num">缺勤</th><th class="num">出勤率</th></tr></thead><tbody>';
        var any = false;
        d.rows.forEach(function (r) {
            if (!r.total) return;
            any = true;
            html += '<tr><td>' + esc(r.name) + '</td><td class="num">' + r.present +
                '</td><td class="num">' + r.late + '</td><td class="num">' + r.absent +
                '</td><td class="num">' + (r.rate == null ? '—' : r.rate + '%') + '</td></tr>';
        });
        if (!any) html += '<tr><td colspan="5" class="py-empty">还没有任何考勤记录</td></tr>';
        html += '</tbody></table></div>';
        $('pyAttendance').innerHTML = html;
    }

    async function doImport(replace, fromText) {
        showErr('');
        var input = $('pyClassInput');
        var cls = (input && input.value || '').trim();
        var fileInput = $('pyRosterFile');
        var file = (!fromText && fileInput && fileInput.files) ? fileInput.files[0] : null;
        var text = ($('pyRosterText') || {}).value || '';

        try {
            var d;
            if (file) {
                if (replace && !cls) {
                    // 覆盖导入必须指定班级，否则会把「全部名单」清掉，太危险
                    throw new Error('覆盖导入要先填班级名（只清这个班，不动别的班）。');
                }
                var fd = new FormData();
                fd.append('file', file);
                fd.append('className', cls);
                if (replace) fd.append('replace', 'true');
                d = await jpostForm('Import', fd);
            } else if (text.trim()) {
                if (replace && !cls) throw new Error('覆盖导入要先填班级名。');
                d = await jpost('Import', { text: text, className: cls, replace: replace ? 'true' : 'false' });
            } else {
                throw new Error('先选一个名单文件，或者把名单粘贴到下面的框里。');
            }

            $('pyRosterText').value = '';
            if (fileInput) fileInput.value = '';
            $('pyFileName').textContent = '未选择文件';
            if (cls) P.className = cls;      // 导入后自动切到刚导入的班级
            await loadRoster();
            $('pyMeta').textContent = '导入完成：新增 ' + d.added + ' 人'
                + (d.skipped ? '，跳过重复 ' + d.skipped + ' 人' : '') + '。';
        } catch (e) {
            showErr(e.message);
        }
    }

    /* ═════════════ ② 课件库 ═════════════ */

    function deckById(id) {
        var list = P.decks.decks || [];
        for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i];
        return null;
    }

    function currentDeck() {
        return P.deckId == null ? null : deckById(P.deckId);
    }

    function paintEngineInfo() {
        var el = $('pyEngineInfo');
        if (!el) return;
        var e = P.decks.engines || {};
        if (e.powerpoint) el.textContent = '转换引擎：PowerPoint（保真度最高）';
        else if (e.libreoffice) el.textContent = '转换引擎：LibreOffice（版式基本一致，复杂动效会丢）';
        else el.textContent = '⚠ 这台机器没有 PPT 转换引擎，上传后无法解析';
        el.style.color = (e.powerpoint || e.libreoffice) ? '' : 'var(--danger)';
    }

    function paintDeckSelect() {
        var sel = $('pyDeckSel');
        if (!sel) return;
        var decks = (P.decks.decks || []).filter(function (d) { return d.status === 'ready'; });
        var html = '';
        if (!decks.length) html = '<option value="">（还没有可播放的课件）</option>';
        else {
            var byCat = {};
            decks.forEach(function (d) {
                var key = d.categoryName || '未分类';
                (byCat[key] = byCat[key] || []).push(d);
            });
            Object.keys(byCat).forEach(function (cat) {
                html += '<optgroup label="' + esc(cat) + '">';
                byCat[cat].forEach(function (d) {
                    html += '<option value="' + d.id + '">' + esc(d.title) + '（' + d.pageCount + ' 页）</option>';
                });
                html += '</optgroup>';
            });
        }
        sel.innerHTML = html;
        if (P.deckId != null && deckById(P.deckId)) sel.value = String(P.deckId);
        else if (decks.length) { P.deckId = decks[0].id; sel.value = String(P.deckId); }
        else P.deckId = null;
    }

    function paintDeckCatSelects() {
        var cats = P.decks.categories || [];
        function opts(includeAll) {
            var s = includeAll ? '<option value="">全部分类</option>' : '<option value="">未分类</option>';
            cats.forEach(function (c) { s += '<option value="' + c.id + '">' + esc(c.name) + '</option>'; });
            return s;
        }
        var a = $('pyDeckCat');
        if (a) { var keep = a.value; a.innerHTML = opts(false); a.value = keep; }
        var b = $('pyFilterCat');
        if (b) { var keep2 = b.value; b.innerHTML = opts(true); b.value = keep2; }
    }

    function paintCats() {
        var box = $('pyCats');
        if (!box) return;
        var cats = P.decks.categories || [];
        if (!cats.length) { box.innerHTML = '<span class="py-hint-line">还没有分类。上面输入名字就能建。</span>'; return; }
        box.innerHTML = cats.map(function (c) {
            return '<span class="py-cat"><b>' + esc(c.name) + '</b>（' + c.count + '）' +
                '<button data-cat-rename="' + c.id + '" title="重命名">✎</button>' +
                '<button data-cat-del="' + c.id + '" title="删除（课件会回到未分类）">×</button></span>';
        }).join('');
    }

    function paintDeckGrid() {
        var grid = $('pyDeckGrid');
        if (!grid) return;
        var filter = $('pyFilterCat') ? $('pyFilterCat').value : '';
        var decks = P.decks.decks || [];
        if (filter !== '') decks = decks.filter(function (d) { return String(d.categoryId || '') === filter; });

        var info = $('pyDeckFilterInfo');
        if (info) info.textContent = '共 ' + decks.length + ' 份';
        var dc = $('pyDeckCount');
        if (dc) dc.textContent = (P.decks.total || 0) + ' 份 · 未分类 ' + (P.decks.uncategorizedCount || 0) + ' 份';

        if (!decks.length) {
            grid.innerHTML = '<div class="py-empty">这里还没有课件。上面传一份 PPT 试试。</div>';
            return;
        }

        grid.innerHTML = decks.map(function (d) {
            var cover = d.status === 'ready'
                ? '<img loading="lazy" src="/PyLab?handler=Image&deckId=' + d.id + '&pageNo=1" alt="" />'
                : '<span>' + (d.status === 'failed' ? '转换失败' : '转换中…') + '</span>';
            var statusTag = d.status === 'ready' ? ''
                : '<span class="py-tag" style="background:var(--danger-soft);color:var(--danger);">' +
                  (d.status === 'failed' ? '失败' : '未完成') + '</span>';
            var catOpts = '<option value="">未分类</option>' +
                (P.decks.categories || []).map(function (c) {
                    return '<option value="' + c.id + '"' + (c.id === d.categoryId ? ' selected' : '') + '>' +
                        esc(c.name) + '</option>';
                }).join('');
            return '<div class="py-deck">' +
                '<div class="cover">' + cover + '</div>' +
                '<div class="body">' +
                '<h4 title="' + esc(d.title) + '">' + esc(d.title) + '</h4>' +
                '<div class="sub"><span>' + (d.status === 'ready' ? d.pageCount + ' 页' : '—') + '</span>' +
                '<span>' + d.sizeMb + ' MB</span>' +
                (d.hasPdf ? '<span title="另有 PDF 版，可切矢量模式">PDF ' + d.pdfMb + ' MB</span>' : '') +
                '<span>' + esc(d.createdAt) + '</span>' + statusTag + '</div>' +
                '<select data-move="' + d.id + '" style="font-size:12px;">' + catOpts + '</select>' +
                (d.error ? '<div class="py-err" style="margin-top:0;font-size:12px;">' + esc(d.error) + '</div>' : '') +
                '<div class="acts">' +
                (d.status === 'ready' ? '<button class="btn" data-play="' + d.id + '">播放</button>' : '') +
                '<button class="btn secondary" data-rename="' + d.id + '">改名</button>' +
                '<button class="btn secondary" data-retry="' + d.id + '">重新转换</button>' +
                '<button class="btn secondary" data-deck-del="' + d.id + '">删除</button>' +
                '</div></div></div>';
        }).join('');
    }

    async function loadDecks() {
        var d = await jget('Decks');
        P.decks = d;
        paintEngineInfo();
        paintDeckCatSelects();
        paintCats();
        paintDeckSelect();
        paintDeckGrid();
        paintPlayer();
    }

    /* ---------- 播放器 ---------- */
    function imageUrl(deckId, pageNo, thumb) {
        return '/PyLab?handler=Image&deckId=' + deckId + '&pageNo=' + pageNo + (thumb ? '&thumb=1' : '');
    }
    function pdfUrl(deckId) {
        return '/PyLab?handler=Pdf&deckId=' + deckId;
    }

    function prefersReduce() {
        return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    }

    /* PDF.js 只在第一次真的用到矢量模式时才下载（320KB + 1MB worker），
       全程用图片模式的人一个字节都不花。pjax 重进本页时 window.pdfjsLib 还在，不会重复下。
       注意：脚本本身也要有超时兜底 —— 线上遇到过「请求已发出、却迟迟不回包」的情况，
       没有兜底的话 pdfJsTask 会永远 pending，矢量模式永久哑掉且一条报错都没有。 */
    var pdfJsTask = null;
    function loadPdfJs() {
        if (window.pdfjsLib) return Promise.resolve(window.pdfjsLib);
        if (pdfJsTask) return pdfJsTask;
        pdfJsTask = new Promise(function (resolve, reject) {
            var s = document.createElement('script');
            var done = false;
            var timer = setTimeout(function () {
                if (done) return;
                done = true;
                pdfJsTask = null;              // 清掉缓存的任务，下次翻页还能重试
                reject(new Error('PDF 渲染组件加载超时'));
            }, 15000);
            s.src = '/lib/pdfjs/pdf.min.js?v=3.11.174';
            s.onload = function () {
                if (done) return;
                done = true; clearTimeout(timer);
                try {
                    window.pdfjsLib.GlobalWorkerOptions.workerSrc = '/lib/pdfjs/pdf.worker.min.js?v=3.11.174';
                    resolve(window.pdfjsLib);
                } catch (e) { pdfJsTask = null; reject(e); }
            };
            s.onerror = function () {
                if (done) return;
                done = true; clearTimeout(timer);
                pdfJsTask = null;
                reject(new Error('PDF 渲染组件加载失败'));
            };
            document.head.appendChild(s);
        });
        return pdfJsTask;
    }

    /* 同一份 PDF 只解析一次；换课件就把上一份丢掉（文档对象常驻内存，没必要留两份） */
    function getPdfDoc(deckId) {
        if (P.pdf && P.pdf.deckId === deckId && P.pdf.task) return P.pdf.task;
        var box = { deckId: deckId, doc: null, timer: 0 };
        P.pdf = box;

        var chain = loadPdfJs().then(function (pdfjsLib) {
            return pdfjsLib.getDocument({ url: pdfUrl(deckId), withCredentials: true }).promise;
        }).then(function (doc) {
            box.doc = doc;
            // PDF 到手了：如果当前这页还停在图片上，补一次重画把它换成矢量。
            // 有了这一钩，就不依赖「当初那次 renderVector 有没有被后来的请求顶掉」—— 一定会收敛。
            if (P.pdf === box && P.slideMode === 'vector') paintPlayer();
            return doc;
        });

        // 下载超时兜底：网太差时「正在加载」不能变成永远等下去（此时页面上已经是图片，不会黑屏）
        box.task = Promise.race([chain, new Promise(function (_, reject) {
            box.timer = setTimeout(function () { reject(new Error('PDF 下载超时')); }, 30000);
        })]).catch(function (e) {
            clearTimeout(box.timer);
            if (P.pdf === box) P.pdf = null;    // 失败不缓存，下次还能重试
            throw e;
        });
        return box.task;
    }

    /* 把第 N 页画到 canvas 上。比 PNG 强的地方在于「出图分辨率跟着容器和屏幕走」：
       容器多大、屏幕几倍像素密度，就按多少物理像素重画一次，放大不糊。
       返回值：true = 确实画完了且没被后来的请求顶掉；false = 被顶掉了，别拿去顶替图片。 */
    var renderSeq = 0;
    function renderVector(deck, pageNo, seq) {
        var cv = $('pySlideCanvas');
        if (!cv || !deck) return Promise.resolve(false);
        if (!seq) seq = ++renderSeq; else renderSeq = seq;
        return getPdfDoc(deck.id).then(function (doc) {
            if (seq !== renderSeq) return null;
            return doc.getPage(pageNo);
        }).then(function (page) {
            if (!page || seq !== renderSeq) return false;

            var stage = $('pyFsBox');
            var bw = stage.clientWidth || 960;
            var bh = stage.clientHeight || Math.round(bw * 9 / 16);
            var base = page.getViewport({ scale: 1 });
            var dpr = Math.min(window.devicePixelRatio || 1, 2);
            var vp = page.getViewport({ scale: Math.min(bw / base.width, bh / base.height) * dpr });

            cv.width = Math.max(1, Math.round(vp.width));
            cv.height = Math.max(1, Math.round(vp.height));
            var ctx = cv.getContext('2d');
            ctx.clearRect(0, 0, cv.width, cv.height);

            return page.render({ canvasContext: ctx, viewport: vp }).promise.then(function () {
                if (seq !== renderSeq) return false;
                cv.style.opacity = '1';
                return true;
            });
        });
    }

    /* 矢量版失败（PDF 被删 / worker 被拦 / 网太差）时的统一兜底：
       留在图片模式，别留一块黑屏；同一份课件只提醒一次，免得每翻一页弹一次 */
    function onVectorFail(deck) {
        return function (e) {
            P.slideMode = 'image';
            paintModes(deck);
            if (P.pdfErrDeck !== deck.id) {
                P.pdfErrDeck = deck.id;
                showErr('矢量版加载失败（' + ((e && e.message) || e) + '），已切成图片模式。');
            }
        };
    }

    /* 把这一页换成矢量：画好了才顶替图片。画不出来就继续用图片 —— 任何一刻都不留黑屏。 */
    function showVector(deck, pageNo) {
        var docReady = !!(P.pdf && P.pdf.deckId === deck.id && P.pdf.doc);
        clearTimeout(P.vecTimer);

        function go() {
            // 等待期间用户可能已经换了课件：那份 PDF 就白下了，别下
            var dk = currentDeck();
            if (!dk || dk.id !== deck.id) return Promise.resolve(false);
            var seq = ++renderSeq;
            return renderVector(deck, pageNo, seq).then(function (drawn) {
                if (!drawn) return false;
                var cv = $('pySlideCanvas'), img = $('pySlideImg');
                if (!cv || cv.width < 64) return false;    // 没真画出像素，就别拿它顶替已经好好的图
                cv.hidden = false;
                if (img) { img.hidden = true; img.removeAttribute('src'); }
                var ld = $('pySlideLoading');
                if (ld) ld.hidden = true;      // 矢量顶上来了，「载入中」也该退场
                return true;
            }).catch(onVectorFail(deck));
        }

        // 文档已在内存里 → 立刻画；还没开始下 → 缓 300ms，让「连点两份课件/快速翻页」只下最后那一份
        if (docReady) return go();
        P.vecTimer = setTimeout(go, 300);
    }

    /* 尺寸变了（全屏 / 缩放窗口）重画一次：只在 canvas 真正在显示时才值得画 */
    function redrawVector() {
        var cv = $('pySlideCanvas');
        if (!cv || cv.hidden) return;
        var dk = currentDeck();
        if (dk) renderVector(dk, P.page).catch(function () { });
    }

    /* 矢量/图片开关：只有目录里真有 deck.pdf 的课件才放出来（老课件只有 PNG） */
    function paintModes(deck) {
        var box = $('pyModes');
        if (!box) return;
        var hasPdf = !!(deck && deck.hasPdf);
        box.hidden = !hasPdf;
        var active = (hasPdf && P.slideMode === 'vector') ? 'vector' : 'image';
        var btns = box.querySelectorAll('[data-slide-mode]');
        for (var i = 0; i < btns.length; i++)
            btns[i].classList.toggle('on', btns[i].getAttribute('data-slide-mode') === active);
    }

    function setSlideMode(m) {
        P.slideMode = (m === 'image') ? 'image' : 'vector';
        try { localStorage.setItem('pylab.slideMode', P.slideMode); } catch (e) { }
        P.paintKey = '';        // 换模式必须重画，别被「同一页不淡入」的判重挡住
        paintPlayer();
    }

    /* 逐页图片：铺一张 PNG。所有模式都先走它 —— 几百 KB、多半已在缓存里，立刻有画面 */
    function paintImage(deck, pageNo, fade) {
        var img = $('pySlideImg');
        if (!img) return;
        var load = $('pySlideLoading');
        var url = imageUrl(deck.id, pageNo);
        if (img.getAttribute('src') !== url) {
            if (fade) img.style.opacity = '0';
            if (load) load.hidden = false;      // 图没到之前给句话，别让人对着黑底猜
            img.onload = function () {
                img.style.opacity = '1';
                if (load) load.hidden = true;
            };
            img.onerror = function () {          // 图都挂了（课件被删/断网）：别一直转「载入中」
                if (load) load.hidden = true;
            };
            img.setAttribute('src', url);
        } else {
            img.style.opacity = '1';
            // 同一张 src 重入（PDF 就绪后会补一次重画）：图还没下完就别把提示撤了
            if (load) load.hidden = img.complete && img.naturalWidth > 0;
        }
        img.hidden = false;
    }

    function paintPlayer() {
        var deck = currentDeck();
        var img = $('pySlideImg');
        var cv = $('pySlideCanvas');
        var empty = $('pySlideEmpty');
        if (!img || !cv || !empty) return;

        var ready = deck && deck.status === 'ready' && deck.pageCount >= 1;
        paintModes(ready ? deck : null);

        if (!ready) {
            img.hidden = true;
            img.removeAttribute('src');
            cv.hidden = true;
            empty.hidden = false;
            var ld0 = $('pySlideLoading');
            if (ld0) ld0.hidden = true;
            P.paintKey = '';
            $('pyPageNo').textContent = '—';
            $('pyFsPage').textContent = '— / —';
            $('pyThumbs').innerHTML = '';
            paintPageSnippet();
            return;
        }

        if (P.page < 1) P.page = 1;
        if (P.page > deck.pageCount) P.page = deck.pageCount;

        empty.hidden = true;

        var key = deck.id + ':' + P.page;
        var fade = P.paintKey !== key && !prefersReduce();
        P.paintKey = key;

        if (P.slideMode === 'vector' && deck.hasPdf) {
            // 渐进式：图片先铺上去（几百 KB、多半已在缓存里，立刻有画面），
            // 矢量图在后台画，画好了再无声顶替。
            // 之前是「PDF 齐了才画第一笔」，教材那种 1.4~3.5MB 的 PDF 在慢网下要 4~5 秒，
            // 这段时间播放区就是一整块黑屏 —— 看着像卡死。
            cv.hidden = true;
            paintImage(deck, P.page, fade);
            // 「播放」页签被切到「课件库」时别去拉 PDF：省流量，
            // 也避免「刚点开 A 又改点 B」时两份 PDF 抢同一条下载管道
            var pv = $('pyPlayView');
            if (!pv || !pv.hidden) showVector(deck, P.page);
        } else {
            cv.hidden = true;
            paintImage(deck, P.page, fade);
        }
        img.alt = deck.title + ' 第 ' + P.page + ' 页';

        $('pyPageNo').textContent = '第 ' + P.page + ' / ' + deck.pageCount + ' 页';
        $('pyFsPage').textContent = P.page + ' / ' + deck.pageCount;
        $('pyJump').max = deck.pageCount;
        $('pyJump').value = P.page;

        var thumbs = $('pyThumbs');
        if (thumbs.getAttribute('data-deck') !== String(deck.id)) {
            var h = '';
            // 缩略图走 thumb=1 的小图（320px / 20~40KB）。用全尺寸图的话
            // 十几张缩略图就是十几 MB，在慢网下会把正文和 PDF 的带宽全抢走。
            for (var i = 1; i <= deck.pageCount; i++)
                h += '<img loading="lazy" data-thumb="' + i + '" src="' + imageUrl(deck.id, i, true) + '" alt="第 ' + i + ' 页" />';
            thumbs.innerHTML = h;
            thumbs.setAttribute('data-deck', String(deck.id));
        }
        var imgs = thumbs.querySelectorAll('img');
        for (var k = 0; k < imgs.length; k++)
            imgs[k].classList.toggle('on', parseInt(imgs[k].getAttribute('data-thumb'), 10) === P.page);

        paintPageSnippet();
        var active = thumbs.querySelector('img.on');
        if (active && active.scrollIntoView) {
            var box = thumbs.getBoundingClientRect(), r = active.getBoundingClientRect();
            if (r.left < box.left || r.right > box.right)
                active.scrollIntoView({ block: 'nearest', inline: 'center' });
        }
    }

    /// 本页挂的片段：从列表里读（loadDecks 已把整份映射带回来，翻页零请求）
    function snippetOptions() {
        var list = (P.boot && P.boot.snippets) || [];
        return list;
    }

    function paintPageSnippet(keepSelection) {
        var sel = $('pyPageSnip');
        if (!sel) return;
        // 重建 options 会把 select 的当前值清成第一项，所以用户选的值必须先抓出来
        var keep = sel.value;

        var opts = snippetOptionsHtml(snippetOptions(), true);
        sel.innerHTML = opts;

        var deck = currentDeck();
        var sid = '';
        if (deck && deck.snippets) sid = deck.snippets[String(P.page)] || '';
        if (keepSelection && keep) sid = keep;   // 用户刚选的优先，别被回读覆盖
        sel.value = sid;
        P.snippetId = sid;

        var info = $('pyPageSnipInfo');
        if (info) {
            info.textContent = sid
                ? '这一页挂了片段：' + sid + '（点右上「运行」看输出）'
                : '这一页还没挂代码。选一个片段后点「保存挂载」，以后翻到这页会自动带出来。';
        }
        var runBtn = $('pyRunPage');
        if (runBtn) runBtn.hidden = !sid;
        if (!sid) {
            $('pyPageCode').textContent = '（给某一页挂上片段后，这里显示源码）';
            $('pyPageOut').textContent = '尚未运行';
            $('pyPageOut').classList.remove('bad');
            $('pyPageOutTitle').textContent = '输出';
            $('pyPageTime').textContent = '';
        } else if (P.snippetLoaded !== sid) {
            $('pyPageCode').textContent = '（点「运行」看源码与输出）';
            $('pyPageOut').textContent = '尚未运行';
            P.snippetLoaded = '';
        }
    }

    async function runPageSnippet() {
        var sid = $('pyPageSnip').value;
        if (!sid) return;
        $('pyPageOut').textContent = '运行中…';
        $('pyPageTime').textContent = '';
        try {
            var d = await call('snippet', { id: sid });
            var r = d.result;
            $('pyPageCode').textContent = r.code;
            P.snippetLoaded = sid;
            paintOut($('pyPageOut'), $('pyPageOutTitle'), $('pyPageTime'), r.run, '输出 · 成功', '输出 · 失败');
        } catch (e) {
            $('pyPageOut').classList.add('bad');
            $('pyPageOut').textContent = '⚠ ' + e.message;
        }
    }

    async function savePageSnippet() {
        var deck = currentDeck();
        if (!deck) { showErr('先选一份课件。'); return; }
        var sid = $('pyPageSnip').value;
        await jpost('PageSnippet', { deckId: deck.id, pageNo: P.page, snippetId: sid });
        deck.snippets = deck.snippets || {};
        if (sid) deck.snippets[String(P.page)] = sid;
        else delete deck.snippets[String(P.page)];
        paintPageSnippet();
        $('pyPageSnipInfo').textContent = sid ? '已挂载：' + sid : '已取消这一页的挂载';
    }

    function goPage(delta) {
        var deck = currentDeck();
        if (!deck) return;
        var next = P.page + delta;
        if (next < 1) next = 1;
        if (next > deck.pageCount) next = deck.pageCount;
        if (next === P.page) return;
        P.page = next;
        paintPlayer();
    }

    function jumpTo(n) {
        var deck = currentDeck();
        if (!deck) return;
        n = parseInt(n, 10) || 1;
        if (n < 1) n = 1;
        if (n > deck.pageCount) n = deck.pageCount;
        P.page = n;
        paintPlayer();
    }

    function toggleFullscreen() {
        var box = $('pyFsBox');
        if (!box) return;
        if (document.fullscreenElement) { document.exitFullscreen(); return; }
        if (box.requestFullscreen) box.requestFullscreen();
    }

    function setDeckView(v) {
        P.deckView = v;
        var btns = document.querySelectorAll('[data-deckview]');
        for (var i = 0; i < btns.length; i++)
            btns[i].classList.toggle('on', btns[i].getAttribute('data-deckview') === v);
        $('pyPlayView').hidden = v !== 'play';
        $('pyLibView').hidden = v !== 'lib';
        if (v === 'play') paintPlayer();
    }

    /* ---------- 上传 ---------- */
    function setProgress(ratio) {
        var box = $('pyProg');
        if (!box) return;
        box.hidden = false;
        box.querySelector('i').style.width = Math.round(Math.max(0, Math.min(1, ratio)) * 100) + '%';
    }

    async function doUpload() {
        var input = $('pyDeckFile');
        var file = input && input.files && input.files[0];
        if (!file) { $('pyUploadStatus').textContent = '先选一个 .ppt / .pptx 文件。'; return; }

        // 先在本地拦一道：服务端上限 60MB（PyLabModel.MaxDeckBytes）。
        // 不拦的话用户得把几十兆传完才被告知太大——白白等几分钟。
        var MAX_MB = 60;
        if (file.size > MAX_MB * 1048576) {
            $('pyUploadStatus').textContent = '✗ 这份课件 ' + (file.size / 1048576).toFixed(1)
                + 'MB，超过 ' + MAX_MB + 'MB 上限。建议在 PowerPoint 里「压缩媒体」后重存，或按章节拆成几份。';
            setProgress(0);
            return;
        }

        var title = ($('pyDeckTitle').value || '').trim();
        var cat = $('pyDeckCat').value;
        var fd = new FormData();
        fd.append('file', file);
        fd.append('title', title);
        if (cat) fd.append('categoryId', cat);

        $('pyUploadStatus').textContent = '上传中…（大文件会慢一些，别关页面）';
        setProgress(0.02);
        try {
            var d = await jpostForm('Upload', fd);
            setProgress(1);
            if (d.status === 'ready') {
                $('pyUploadStatus').textContent = '✓ 搞定：' + d.pageCount + ' 页，引擎 ' + d.engine + '。';
                P.deckId = d.id;
                P.page = 1;
            } else {
                $('pyUploadStatus').textContent = '⚠ 转换失败：' + (d.error || '未知原因');
            }
            input.value = '';
            $('pyDeckTitle').value = '';
            await loadDecks();
            paintDeckGrid();
            setTimeout(function () { var pb = $('pyProg'); if (pb) pb.hidden = true; }, 1500);
        } catch (e) {
            $('pyUploadStatus').textContent = '✗ ' + e.message;
            setProgress(0);
            setTimeout(function () { var pb = $('pyProg'); if (pb) pb.hidden = true; }, 1500);
        }
    }

    /* ═════════════ ③④（Python 桥） ═════════════ */
    function paintSnippetList(list) {
        var sel = $('pySnipSel');
        if (!sel) return;
        sel.innerHTML = snippetOptionsHtml(list, false);
    }

    /// 片段下拉框的 options：按 chapter 分组（导入书例后可能有上百条，平铺根本找不到）
    function snippetOptionsHtml(list, withEmpty) {
        var heads = withEmpty ? '<option value="">（这一页不挂代码）</option>' : '';
        var byChapter = {}, order = [];
        list.forEach(function (s) {
            var k = s.chapter || '未分类';
            if (!byChapter[k]) { byChapter[k] = []; order.push(k); }
            byChapter[k].push(s);
        });
        if (!order.length) return heads;
        if (order.length === 1 && !withEmpty)
            return list.map(function (s) { return '<option value="' + esc(s.id) + '">' + esc(s.title) + '</option>'; }).join('');
        return heads + order.map(function (k) {
            return '<optgroup label="' + esc(k) + '（' + byChapter[k].length + '）">' +
                byChapter[k].map(function (s) {
                    return '<option value="' + esc(s.id) + '">' + esc(s.title) + '</option>';
                }).join('') + '</optgroup>';
        }).join('');
    }

    async function runSnippet(id) {
        id = id || $('pySnipSel').value;
        if (!id) return;
        $('pySnipOut').textContent = '运行中…';
        $('pySnipTime').textContent = '';
        try {
            var d = await call('snippet', { id: id });
            var r = d.result;
            $('pySnipCode').textContent = r.code;
            $('pySnipExpect').textContent = '预期：' + r.expect;
            paintOut($('pySnipOut'), $('pySnipOutTitle'), $('pySnipTime'), r.run, '输出 · 成功', '输出 · 失败');
        } catch (e) {
            $('pySnipOut').classList.add('bad');
            $('pySnipOut').textContent = '⚠ ' + e.message;
        }
    }

    function paintExtensions(list) {
        var grid = $('pyExtGrid');
        if (!grid) return;
        grid.innerHTML = list.map(function (x) {
            return '<div class="py-item"><h4>' + esc(x.title) + '</h4>' +
                '<span class="py-tag">' + esc(x.tag) + '</span>' +
                '<button class="btn secondary" data-ext="' + esc(x.id) + '">▶ 运行这个案例</button></div>';
        }).join('');
    }

    async function runExtension(id) {
        $('pyExtOut').textContent = '运行中…';
        $('pyExtTime').textContent = '';
        try {
            var d = await call('extension', { id: id });
            var r = d.result;
            $('pyExtOutTitle').textContent = r.title;
            paintOut($('pyExtOut'), null, $('pyExtTime'), r.run, '', '');
        } catch (e) {
            $('pyExtOut').classList.add('bad');
            $('pyExtOut').textContent = '⚠ ' + e.message;
        }
    }

    /* ═════════════ 事件（document 级，只装一次） ═════════════ */
    function bindOnce() {
        document.addEventListener('click', function (ev) {
            if (!document.querySelector('[data-panel="roll"]')) return;   // 已经离开本页

            var tab = ev.target.closest('.py-tab');
            if (tab) { switchTab(tab.getAttribute('data-tab')); return; }

            var seg = ev.target.closest('[data-deckview]');
            if (seg) { setDeckView(seg.getAttribute('data-deckview')); return; }

            var modeBtn = ev.target.closest('[data-slide-mode]');
            if (modeBtn) { setSlideMode(modeBtn.getAttribute('data-slide-mode')); return; }

            var thumb = ev.target.closest('[data-thumb]');
            if (thumb) { jumpTo(thumb.getAttribute('data-thumb')); return; }

            var delStd = ev.target.closest('[data-del-student]');
            if (delStd) {
                jpost('StudentDelete', { id: delStd.getAttribute('data-del-student') })
                    .then(loadRoster).catch(function (e) { showErr(e.message); });
                return;
            }

            var catRen = ev.target.closest('[data-cat-rename]');
            if (catRen) {
                var id = catRen.getAttribute('data-cat-rename');
                var cur = (P.decks.categories || []).filter(function (c) { return String(c.id) === id; })[0];
                var nn = prompt('新的分类名', cur ? cur.name : '');
                if (nn && nn.trim()) jpost('CatRename', { id: id, name: nn.trim() })
                    .then(loadDecks).catch(function (e) { alert(e.message); });
                return;
            }
            var catDel = ev.target.closest('[data-cat-del]');
            if (catDel) {
                if (!confirm('删除这个分类？课件不会被删，会回到「未分类」。')) return;
                jpost('CatDelete', { id: catDel.getAttribute('data-cat-del') })
                    .then(loadDecks).catch(function (e) { alert(e.message); });
                return;
            }
            var play = ev.target.closest('[data-play]');
            if (play) {
                P.deckId = parseInt(play.getAttribute('data-play'), 10);
                P.page = 1;
                setDeckView('play');
                paintDeckSelect();
                paintPlayer();
                return;
            }
            var ren = ev.target.closest('[data-rename]');
            if (ren) {
                var did = ren.getAttribute('data-rename');
                var dk = deckById(parseInt(did, 10));
                var t = prompt('课件标题', dk ? dk.title : '');
                if (t && t.trim()) jpost('DeckSave', { id: did, title: t.trim(), categoryId: dk.categoryId || '' })
                    .then(loadDecks).catch(function (e) { alert(e.message); });
                return;
            }
            var retry = ev.target.closest('[data-retry]');
            if (retry) {
                retry.textContent = '转换中…';
                jpost('DeckRetry', { id: retry.getAttribute('data-retry') })
                    .then(loadDecks).catch(function (e) { alert(e.message); });
                return;
            }
            var ddel = ev.target.closest('[data-deck-del]');
            if (ddel) {
                if (!confirm('删除这份课件？原始文件和渲染出的图片都会删掉。')) return;
                jpost('DeckDelete', { id: ddel.getAttribute('data-deck-del') })
                    .then(function () {
                        if (String(P.deckId) === ddel.getAttribute('data-deck-del')) { P.deckId = null; P.page = 1; }
                        return loadDecks();
                    }).catch(function (e) { alert(e.message); });
                return;
            }

            var ext = ev.target.closest('[data-ext]');
            if (ext) { runExtension(ext.getAttribute('data-ext')); return; }

            var btn = ev.target.closest('[data-act]');
            if (!btn) return;
            var act = btn.getAttribute('data-act');

            if (act === 'pick') doPick().catch(function (e) { showErr(e.message); });
            else if (act === 'reset') {
                P.calledIds = [];
                P.lastPick = null;
                $('pyName').textContent = '已重置';
                $('pyName').classList.remove('multi');
                $('pyMeta').textContent = '本轮已重新开始（考勤记录保留）';
                $('pyMarkRow').hidden = true;
            }
            else if (act === 'attendance') loadAttendance().catch(function (e) { showErr(e.message); });
            else if (act === 'mark') doMark(btn.getAttribute('data-status')).catch(function (e) { showErr(e.message); });
            else if (act === 'roster') {
                var card = $('pyRosterCard');
                card.hidden = !card.hidden;
                if (!card.hidden) paintRosterTable();
            }
            else if (act === 'importFile') doImport(false);
            else if (act === 'importFileReplace') doImport(true);
            else if (act === 'importText') doImport(false, true);
            else if (act === 'clearClass') {
                var cls = (($('pyClassInput') || {}).value || '').trim();
                if (!confirm('确定清空' + (cls ? '「' + cls + '」' : '全部') + '名单吗？这些人的考勤记录也会一起删掉。')) return;
                jpost('RosterClear', { className: cls }).then(function (d) {
                    P.className = '';
                    $('pyMeta').textContent = '已清空 ' + d.removed + ' 人';
                    return loadRoster();
                }).catch(function (e) { showErr(e.message); });
            }
            else if (act === 'upload') doUpload();
            else if (act === 'catAdd') {
                var nm = ($('pyNewCat').value || '').trim();
                if (!nm) return;
                jpost('CatAdd', { name: nm }).then(function () {
                    $('pyNewCat').value = '';
                    return loadDecks();
                }).catch(function (e) { alert(e.message); });
            }
            else if (act === 'dprev') goPage(-1);
            else if (act === 'dnext') goPage(1);
            else if (act === 'dfirst') jumpTo(1);
            else if (act === 'djump') jumpTo($('pyJump').value);
            else if (act === 'fs') toggleFullscreen();
            else if (act === 'savePageSnip') savePageSnippet().catch(function (e) { showErr(e.message); });
            else if (act === 'runPage') runPageSnippet();
            else if (act === 'runSnip') runSnippet();
        });

        document.addEventListener('change', function (ev) {
            var t = ev.target;
            if (!t) return;
            if (t.id === 'pySnipSel') { runSnippet(t.value); return; }
            if (t.id === 'pyClass') { P.className = t.value; P.calledIds = []; paintRosterTable(); return; }
            if (t.id === 'pyDeckSel') {
                P.deckId = parseInt(t.value, 10) || null;
                P.page = 1;
                $('pyThumbs').removeAttribute('data-deck');
                paintPlayer();
                return;
            }
            if (t.id === 'pyFilterCat') { paintDeckGrid(); return; }
            if (t.id === 'pyPageSnip') { paintPageSnippet(true); return; }
            if (t.id === 'pyRosterFile') {
                var f = t.files && t.files[0];
                $('pyFileName').textContent = f ? f.name : '未选择文件';
                return;
            }
            var move = t.closest && t.closest('[data-move]');
            if (move) {
                jpost('DeckSave', {
                    id: move.getAttribute('data-move'),
                    title: (deckById(parseInt(move.getAttribute('data-move'), 10)) || {}).title || '',
                    categoryId: t.value
                }).then(loadDecks).catch(function (e) { alert(e.message); });
            }
        });

        document.addEventListener('keydown', function (ev) {
            var panel = document.querySelector('.py-panel[data-panel="deck"]');
            if (!panel || !panel.classList.contains('on')) return;
            // Esc 退出全屏：浏览器自身也会处理，但 headless / 部分环境不响应，
            // 这里显式兜一道，保证「按 Esc 一定退得出去」
            if (ev.key === 'Escape' && document.fullscreenElement) {
                document.exitFullscreen();
                return;
            }
            if (ev.target && ev.target.id === 'pyJump' && ev.key === 'Enter') {
                ev.preventDefault(); jumpTo(ev.target.value); return;
            }
            var tag = (ev.target.tagName || '').toLowerCase();
            if (tag === 'input' || tag === 'textarea' || tag === 'select') return;

            if (ev.key === 'ArrowRight' || ev.key === ' ' || ev.key === 'PageDown') {
                if (ev.key !== 'ArrowRight') { if (!document.fullscreenElement) return; }
                ev.preventDefault(); goPage(1);
            } else if (ev.key === 'ArrowLeft' || ev.key === 'PageUp') {
                ev.preventDefault(); goPage(-1);
            } else if (ev.key === 'Home') {
                ev.preventDefault(); jumpTo(1);
            } else if (ev.key === 'End') {
                var dk = currentDeck(); if (dk) { ev.preventDefault(); jumpTo(dk.pageCount); }
            }
        });

        // 全屏状态变化时同步按钮文案（浏览器 Esc 退出不会走我们的 toggle）
        document.addEventListener('fullscreenchange', function () {
            var btn = document.querySelector('.py-slidebar [data-act="fs"]');
            if (btn) btn.textContent = document.fullscreenElement ? '退出全屏' : '⛶ 全屏播放';
            // 容器尺寸变了：矢量模式要按新尺寸重画一次（全屏后字更清楚就是这个道理）
            if (P.slideMode === 'vector') setTimeout(redrawVector, 80);
        });

        // 窗口缩放同理：矢量模式重画，图片模式不用管（浏览器自己缩放位图）
        window.addEventListener('resize', function () {
            if (P.slideMode !== 'vector') return;
            clearTimeout(P.resizeTimer);
            P.resizeTimer = setTimeout(redrawVector, 180);
        });
    }

    if (!P.bound) { P.bound = true; bindOnce(); }

    /* ═════════════ 初始化 ═════════════ */
    (async function boot() {
        try {
            var d = await call('bootstrap');
            if (P.ver !== ver) return;      // pjax 又切走了，丢弃这次结果
            P.boot = d.result;
            paintSnippetList(d.result.snippets || []);
            paintExtensions(d.result.extensions || []);

            await loadRoster();
            if (P.ver !== ver) return;
            await loadDecks();
            if (P.ver !== ver) return;

            var total = P.roster.students.length;
            if (!total) {
                $('pyMeta').textContent = '还没有学生名单。点「名单管理」导入一份，支持 xlsx / csv / 直接粘贴。';
            } else {
                $('pyMeta').textContent = '名单 ' + total + ' 人，点「随机点名」开始。';
            }
        } catch (e) {
            showErr('初始化失败：' + e.message);
        }
    })();
})();
</script>
}
