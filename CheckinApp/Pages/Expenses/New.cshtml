@page
@model CheckinApp.Pages.Expenses.NewModel
@{
    ViewData["Title"] = "记一笔";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>记一笔</h2>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        <div class="field">
            <label>类型</label>
            <select asp-for="Type">
                <option value="out" selected="@(Model.Type == "out" ? "selected" : null)">支出</option>
                <option value="in" selected="@(Model.Type == "in" ? "selected" : null)">收入</option>
            </select>
        </div>
        <div class="field">
            <label>金额（元）</label>
            <input asp-for="Amount" type="number" step="0.01" min="0.01" required placeholder="0.00" />
        </div>
        <div class="field">
            <label>分类</label>
            <select asp-for="Category" onchange="if(this.value==='__manage'){try{sessionStorage.setItem('catManage',String(Date.now()))}catch(e){}location.href='/Expenses/Categories';}">
                @foreach (var c in Model.Categories)
                {
                    <option value="@c" selected="@(c == Model.Category ? "selected" : null)">@c</option>
                }
                <option value="__manage">管理分类…</option>
            </select>
        </div>
        <div class="field">
            <label>日期</label>
            <input asp-for="OccurDate" type="date" required />
        </div>
        <div class="field">
            <label>备注</label>
            <input asp-for="Note" autocomplete="off" placeholder="如：食堂午饭" />
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
            <a class="btn secondary" href="/Expenses">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // 从「管理分类…」返回时（bfcache）重新加载，下拉才能拿到刚保存的分类；
        // 重新加载后的首次进入顺带把分类页带回来的保存提示（sessionStorage）显示掉，显示后即清防重复
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) { location.reload(); return; }
            try {
                var t = sessionStorage.getItem('expenseCatToast');
                if (t) {
                    sessionStorage.removeItem('expenseCatToast');
                    if (window.toast) window.toast(t, 'ok');
                }
            } catch (err) { }
        });
    </script>
}
