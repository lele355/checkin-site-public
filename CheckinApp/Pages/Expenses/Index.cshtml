@page
@model CheckinApp.Pages.Expenses.IndexModel
@{
    ViewData["Title"] = "记账";
    var prev = Model.Month.AddMonths(-1).ToString("yyyy-MM");
    var next = Model.Month.AddMonths(1).ToString("yyyy-MM");
    var v = Model.View;
}
@if (TempData["Ok"] is string okMsg)
{
    <div class="msg ok">@okMsg</div>
}
@if (TempData["Err"] is string errMsg)
{
    <div class="msg error">@errMsg</div>
}
<div class="card">
    <div class="page-head">
        <h2>
            @if (Model.Searching)
            {
                <span>搜索「@Model.Query」</span>
            }
            else
            {
                <a href="?m=@prev&view=@v" class="mini" style="text-decoration:none;">←</a>
                @Model.Month.ToString("yyyy年M月")
                <a href="?m=@next&view=@v" class="mini" style="text-decoration:none;">→</a>
            }
        </h2>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            @if (!Model.Searching)
            {
                <div class="view-switch" data-viewkey="expenses">
                    <button type="button" class="vs-btn@(v == "list" ? " on" : "")" data-view="list" title="明细视图">@Html.Raw(Icons.Svg("list", 15))<span>明细</span></button>
                    <button type="button" class="vs-btn@(v == "month" ? " on" : "")" data-view="month" title="月度汇总">@Html.Raw(Icons.Svg("grid", 15))<span>月度</span></button>
                </div>
            }
            @if (!Model.Searching && v == "list" && Model.Rows.Count(r => !r.IsGroup) >= 2)
            {
                <button class="btn secondary" type="button" id="pickStart" title="勾几笔合成一个条目">整理</button>
            }
            <a class="btn" href="/Expenses/New">@Html.Raw(Icons.Svg("plus", 16)) 记一笔</a>
        </div>
    </div>

    <form method="get" class="inline-form" style="margin-bottom:14px;">
        <input name="q" value="@Model.Query" placeholder="搜备注或分类" autocomplete="off" />
        @if (Model.Searching)
        {
            <a class="btn secondary" href="/Expenses">清除</a>
        }
        <button class="btn" type="submit">搜索</button>
    </form>

    <div class="stat-row">
        <div class="stat-box">
            <div class="mini">支出</div>
            <div class="stat-num" style="color:#e24b4a;">¥@Model.TotalOut.ToString("0.##")</div>
        </div>
        <div class="stat-box">
            <div class="mini">收入</div>
            <div class="stat-num" style="color:#639922;">¥@Model.TotalIn.ToString("0.##")</div>
        </div>
        <div class="stat-box">
            <div class="mini">结余</div>
            <div class="stat-num">¥@((Model.TotalIn - Model.TotalOut).ToString("0.##"))</div>
        </div>
    </div>

    @if (v == "list" && Model.ByCategory.Count > 0)
    {
        <div style="margin-top:12px;">
            <div class="bar-caption">支出分类</div>
            <div class="bar-list">
            @foreach (var (cat, sum) in Model.ByCategory)
            {
                var pct = Model.TotalOut == 0 ? 0 : (int)Math.Round((double)(sum / Model.TotalOut) * 100);
                <div class="bar-row">
                    <div class="bar-head">
                        <span class="bar-label">@cat</span><span class="bar-val">¥@sum.ToString("0.##")（@pct%）</span>
                    </div>
                    <div class="bar-track"><div class="bar-fill" style="width:@pct%;"></div></div>
                </div>
            }
            </div>
        </div>
    }
</div>

@if (v == "month")
{
    var max = Model.MonthRows.Count == 0 ? 0m : Model.MonthRows.Max(r => Math.Max(r.TotalIn, r.TotalOut));
    <div class="card">
        <div class="group-head">近 12 个月收支</div>
        @if (max == 0)
        {
            <div class="empty"><span class="big">📊</span>近 12 个月还没有账目。</div>
        }
        else
        {
            @foreach (var r in Model.MonthRows)
            {
                var outPct = (int)Math.Round((double)(r.TotalOut / max) * 100);
                var inPct = (int)Math.Round((double)(r.TotalIn / max) * 100);
                <a class="month-row" href="?m=@r.Month.ToString("yyyy-MM")&view=list" title="查看 @r.Month.ToString("yyyy年M月") 明细">
                    <div class="mr-name">@r.Month.ToString("yyyy年M月")</div>
                    <div class="mr-bar">
                        <div class="mr-out" style="width:@(outPct / 2)%;"></div>
                        <div class="mr-in" style="width:@(inPct / 2)%;"></div>
                    </div>
                    <div class="mr-sum">
                        <span style="color:#e24b4a;">-¥@r.TotalOut.ToString("0.##")</span>
                        <span style="color:#639922;">+¥@r.TotalIn.ToString("0.##")</span>
                    </div>
                </a>
            }
        }
    </div>
}
else if (Model.Rows.Count == 0)
{
    <div class="card"><div class="empty"><span class="big">💰</span>@(Model.Searching ? "没有匹配的账目" : "本月还没有账目")</div></div>
}
else
{
    <div class="card">
        <div class="stack">
            @foreach (var row in Model.Rows)
            {
                if (row.IsGroup)
                {
                    <details class="exp-group" data-group="@row.GroupId">
                        <summary class="row-item">
                            <div class="chip chip-icon" style="flex-shrink:0;">@Html.Raw(Icons.Svg("list", 13))</div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:600;">@row.Name</div>
                                <div class="mini">
                                    @row.Items.Count 笔 · 最近 @row.LatestText
                                    @if (row.OtherCount > 0)
                                    {
                                        <text> · 其它月份还有 @row.OtherCount 笔</text>
                                    }
                                </div>
                            </div>
                            <div style="font-weight:700;text-align:right;white-space:nowrap;">
                                @if (row.TotalOut > 0)
                                {
                                    <span style="color:#e24b4a;">-¥@row.TotalOut.ToString("0.##")</span>
                                }
                                @if (row.TotalOut > 0 && row.TotalIn > 0)
                                {
                                    <text> </text>
                                }
                                @if (row.TotalIn > 0)
                                {
                                    <span style="color:#639922;">+¥@row.TotalIn.ToString("0.##")</span>
                                }
                            </div>
                            <span class="exp-caret">@Html.Raw(Icons.Svg("chevron-down", 15))</span>
                        </summary>
                        <div class="exp-group-body">
                            @foreach (var x in row.Items)
                            {
                                <div class="row-item exp-child">
                                    <div class="chip" style="flex-shrink:0;">@x.Category</div>
                                    <div style="flex:1;min-width:0;">
                                        <div>@(string.IsNullOrWhiteSpace(x.Note) ? x.Category : x.Note)</div>
                                        <div class="mini">@SiteClock.MinuteLabel(x.OccurDate)</div>
                                    </div>
                                    <div style="font-weight:600;color:@(x.Type == "out" ? "#e24b4a" : "#639922");">
                                        @(x.Type == "out" ? "-" : "+")¥@x.Amount.ToString("0.##")
                                    </div>
                                    <a class="mini" href="/Expenses/Edit/@x.Id">@Html.Raw(Icons.Svg("pencil", 14)) 编辑</a>
                                </div>
                            }
                            <div class="exp-group-actions">
                                <form method="post" asp-page-handler="Rename" class="inline-form" style="margin:0;">
                                    <input type="hidden" name="groupId" value="@row.GroupId" />
                                    <input type="hidden" name="m" value="@Model.Month.ToString("yyyy-MM")" />
                                    <input name="name" value="@row.Name" maxlength="20" style="width:140px;" />
                                    <button class="btn secondary" type="submit">改名</button>
                                </form>
                                <form method="post" asp-page-handler="Dissolve" data-confirm="解散后这几笔账都还在，只是不再归在这个条目下" style="margin:0;">
                                    <input type="hidden" name="groupId" value="@row.GroupId" />
                                    <input type="hidden" name="m" value="@Model.Month.ToString("yyyy-MM")" />
                                    <button class="btn secondary" type="submit">解散条目</button>
                                </form>
                            </div>
                        </div>
                    </details>
                }
                else
                {
                    var x = row.Items[0];
                    <div class="row-item exp-single" data-pick data-id="@x.Id"
                         data-note="@(string.IsNullOrWhiteSpace(x.Note) ? x.Category : x.Note)">
                        <input class="exp-pick" type="checkbox" name="ids" value="@x.Id" form="pickForm" />
                        <div class="chip" style="flex-shrink:0;">@x.Category</div>
                        <div style="flex:1;min-width:0;">
                            <div style="font-weight:600;">@(string.IsNullOrWhiteSpace(x.Note) ? x.Category : x.Note)</div>
                            <div class="mini">@SiteClock.MinuteLabel(x.OccurDate)</div>
                        </div>
                        <div style="font-weight:700;color:@(x.Type == "out" ? "#e24b4a" : "#639922");">
                            @(x.Type == "out" ? "-" : "+")¥@x.Amount.ToString("0.##")
                        </div>
                        <a class="mini" href="/Expenses/Edit/@x.Id">@Html.Raw(Icons.Svg("pencil", 14)) 编辑</a>
                    </div>
                }
            }
        </div>
    </div>

    @if (!Model.Searching)
    {
        <form method="post" asp-page-handler="Merge" id="pickForm" class="pick-bar">
            <input type="hidden" name="m" value="@Model.Month.ToString("yyyy-MM")" />
            <span class="mini" id="pickCount">已选 0 笔</span>
            <input name="name" maxlength="20" placeholder="条目名，如：超市购物" />
            <button class="btn" type="submit">合并</button>
            <button class="btn secondary" type="button" id="pickCancel">取消</button>
        </form>
    }
}

@section Scripts {
    <script>
        // 整理（多选合并）：点「整理」进 picking 模式，点行 = 勾选（不动编辑链接），
        // 提交前本地先挡一道，省一次来回。条目行在 picking 模式下置灰不可选。
        (function () {
            var form = document.getElementById('pickForm');
            if (!form) return;
            var countEl = document.getElementById('pickCount');
            var nameEl = form.querySelector('input[name="name"]');
            // 注意：勾选框在列表里，靠 form="pickForm" 关联，
            // 它们**不是** form 的后代 —— 必须从 document 上找，不能 form.querySelectorAll。
            var boxes = function () { return document.querySelectorAll('.exp-pick'); };

            function picked() { return document.querySelectorAll('.exp-pick:checked').length; }
            function refresh() { countEl.textContent = '已选 ' + picked() + ' 笔'; }
            function setPicking(on) {
                document.body.classList.toggle('picking', on);
                if (!on) {
                    boxes().forEach(function (c) { c.checked = false; });
                    nameEl.value = '';
                    refresh();
                }
            }

            var start = document.getElementById('pickStart');
            var cancel = document.getElementById('pickCancel');
            if (start) start.addEventListener('click', function () { setPicking(true); });
            if (cancel) cancel.addEventListener('click', function () { setPicking(false); });

            document.querySelectorAll('.exp-single[data-pick]').forEach(function (row) {
                row.addEventListener('click', function (e) {
                    if (!document.body.classList.contains('picking')) return;
                    if (e.target.tagName === 'INPUT') return;
                    e.preventDefault();
                    var cb = row.querySelector('.exp-pick');
                    cb.checked = !cb.checked;
                    // 名字没填过就预填第一笔的备注（没备注就用分类），用户随时能改
                    if (cb.checked && !nameEl.value.trim()) nameEl.value = row.dataset.note || '';
                    refresh();
                });
            });

            form.addEventListener('submit', function (e) {
                if (picked() < 2) { e.preventDefault(); if (window.toast) window.toast('至少选 2 笔才能合并', 'error'); return; }
                if (!nameEl.value.trim()) { e.preventDefault(); if (window.toast) window.toast('给这个条目起个名字吧', 'error'); }
            });

            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setPicking(false); });
            refresh();
        })();
    </script>
}
