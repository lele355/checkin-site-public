@page
@model CheckinApp.Pages.Expenses.CategoriesModel
@using CheckinApp.Services
@{
    ViewData["Title"] = "记账分类";
    var count = Model.Categories.Count;
}
<div class="card">

    <div class="page-head">
        <h2>记账分类</h2>
        <a class="btn secondary" href="/Expenses">@Html.Raw(Icons.Svg("chevron-left", 16)) 回到记账</a>
    </div>

    @* 提示条会被 modal.js 转成浮动 Toast（.msg 元素随即从文档里移除），
       所以这里只负责输出内容，视觉上看到的是右上角那条提示。 *@
    @if (!string.IsNullOrEmpty(Model.Ok))
    {
        <div class="msg ok">@Model.Ok</div>
    }
    @if (!string.IsNullOrEmpty(Model.Err))
    {
        <div class="msg error">@Model.Err</div>
    }

    <div class="field" style="margin-top:16px;">
        <label>已有分类（@count 个，上限 @ExpenseCategoryCatalog.MaxCount）</label>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
            @foreach (var c in Model.Categories)
            {
                @* 每个分类一个独立表单：删除是不可逆动作，必须单独 POST，
                   外层不能再套 form（HTML 不允许嵌套 form）。 *@
                <form method="post" asp-page-handler="Delete"
                      data-confirm="删除「@c」？已有账目不受影响，只是新账不能再选它。"
                      style="margin:0;">
                    <input type="hidden" name="name" value="@c" />
                    <button class="btn secondary" type="submit" title="点击删除这个分类"
                            style="padding:7px 12px;font-size:.85rem;">
                        @c @Html.Raw(Icons.Svg("x", 12))
                    </button>
                </form>
            }
        </div>
    </div>

    <form method="post" asp-page-handler="Add" style="margin-top:18px;">
        <div class="field">
            <label>新增分类</label>
            <input name="NewName" maxlength="@ExpenseCategoryCatalog.MaxLen" autocomplete="off"
                   placeholder="如：宠物、房租、奶茶（最多 @ExpenseCategoryCatalog.MaxLen 个字）" />
        </div>
        <div class="form-actions" style="display:flex;gap:10px;flex-wrap:wrap;">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("plus", 16)) 添加</button>
        </div>
    </form>

    <form method="post" asp-page-handler="Reset" data-confirm="恢复成内置的那 7 个分类？自己加的分类会没了。"
          style="margin-top:6px;">
        <div class="form-actions" style="display:flex;gap:10px;flex-wrap:wrap;">
            <button class="btn secondary" type="submit">@Html.Raw(Icons.Svg("rotate-ccw", 16)) 恢复默认</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // 从记账表单的「管理分类…」进来、且刚保存成功：自动返回表单（返回页会重新加载拿新分类）。
        // 下拉跳转与 PRG 的 ?ok= 各占一条历史，back() 只弹掉 ?ok= 会停在分类列表页 ——
        // 带 catManage 标记且本次保存成功时弹两格正好回表单；历史深度不足退回一格兜底。
        // go(-2) 会把这页的 ?ok= 提示一起带走，先把提示存进 sessionStorage，
        // 由表单页（New/Edit）取出显示 —— 手动进入本页保存的路径不写这个键，提示照常在本页显示。
        (function () {
            try {
                var t = sessionStorage.getItem('catManage');
                if (!t) return;
                if (Date.now() - Number(t) > 30 * 60 * 1000) { sessionStorage.removeItem('catManage'); return; }
                if (location.search.indexOf('ok=') >= 0) {
                    sessionStorage.removeItem('catManage');
                    try {
                        var msg = new URLSearchParams(location.search).get('ok');
                        if (msg) sessionStorage.setItem('expenseCatToast', msg);
                    } catch (e2) { }
                    if (history.length >= 3) history.go(-2); else history.back();
                }
            } catch (e) { }
        })();
    </script>
}
