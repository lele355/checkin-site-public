@page "{id:int}"
@model CheckinApp.Pages.Expenses.EditModel
@{
    ViewData["Title"] = "编辑账目";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>编辑账目</h2>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label>类型</label>
            <select asp-for="Type">
                <option value="out" selected="@(Model.Type == "out" ? "selected" : null)">支出</option>
                <option value="in" selected="@(Model.Type == "in" ? "selected" : null)">收入</option>
            </select>
        </div>
        <div class="field">
            <label>金额（元）</label>
            <input asp-for="Amount" type="number" step="0.01" min="0.01" required />
        </div>
        <div class="field">
            <label>分类</label>
            <select asp-for="Category">
                @foreach (var c in Model.Categories)
                {
                    <option value="@c" selected="@(c == Model.Category ? "selected" : null)">@c</option>
                }
            </select>
            <div class="hint" style="margin-top:6px;">
                没有想要的分类？
                <a href="/Expenses/Categories">管理分类</a>
            </div>
        </div>
        <div class="field">
            <label>日期</label>
            <input asp-for="OccurDate" type="date" required />
        </div>
        <div class="field">
            <label>备注</label>
            <input asp-for="Note" autocomplete="off" />
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
            <a class="btn secondary" href="/Expenses">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>

    <hr class="rule" />
    <form method="post" asp-page-handler="Delete" data-confirm="确认删除" class="danger-row">
        <input type="hidden" name="id" value="@Model.Id" />
        <button class="btn danger" type="submit">@Html.Raw(Icons.Svg("trash-2", 16)) 删除账目</button>
    </form>
</div>
