@page
@model CheckinApp.Pages.Habits.IndexModel
@{
    ViewData["Title"] = "打卡";
}
<div class="card">
    <div class="page-head">
        <h2>习惯打卡</h2>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <div class="view-switch" data-viewkey="habits">
                <button type="button" class="vs-btn@(Model.View == "list" ? " on" : "")" data-view="list" title="列表视图">@Html.Raw(Icons.Svg("list", 15))<span>列表</span></button>
                <button type="button" class="vs-btn@(Model.View == "grid" ? " on" : "")" data-view="grid" title="卡片视图">@Html.Raw(Icons.Svg("grid", 15))<span>卡片</span></button>
            </div>
            <a class="btn" href="/Habits/New">@Html.Raw(Icons.Svg("plus", 16)) 新建习惯</a>
        </div>
    </div>
    <p class="hint" style="margin-top:8px;">每天点亮一个好习惯，连续天数就是你的坚持勋章。</p>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="card"><div class="empty"><span class="big">🌱</span>还没有习惯</div></div>
}
else if (Model.View == "grid")
{
    <div class="habit-cards">
        @foreach (var row in Model.Rows)
        {
            <div class="card habit-card">
                <div class="hc-icon">@row.Habit.Icon</div>
                <div style="font-weight:600;font-size:1.05rem;">@row.Habit.Name</div>
                <div class="mini habit-stats">
                    累计 <b class="hs-total">@row.Total</b> 天 ·
                    <span class="hs-flame flame-badge" hidden="@(row.Streak < 2 ? "hidden" : null)" title="连续 @row.Streak 天，继续加油">@Html.Raw(Icons.Svg("flame", 14))连续 <b class="hs-n">@row.Streak</b> 天</span>
                    <span class="hs-plain" hidden="@(row.Streak >= 2 ? "hidden" : null)">连续 <b class="hs-n2" style="color:var(--accent-strong);">@row.Streak</b> 天</span>
                </div>
                <div class="week-dots" title="近 7 天打卡记录">
                    @for (var i = 0; i < row.Week.Count; i++)
                    {
                        <span class="week-dot@(row.Week[i] ? " on" : "")@(i == row.Week.Count - 1 ? " today" : "")"></span>
                    }
                </div>
                <div style="display:flex;gap:8px;align-items:center;justify-content:center;margin-top:2px;">
                    @if (row.CheckedToday)
                    {
                        <form method="post" asp-page-handler="Undo" data-ajax="checkin">
                            <input type="hidden" name="id" value="@row.Habit.Id" />
                            <button class="btn secondary" type="submit" title="取消今天的打卡">✓ 今日已打卡</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Checkin" data-ajax="checkin">
                            <input type="hidden" name="id" value="@row.Habit.Id" />
                            <button class="btn" type="submit">打卡</button>
                        </form>
                    }
                    <a class="mini" href="/Habits/Edit/@row.Habit.Id">@Html.Raw(Icons.Svg("pencil", 14)) 编辑</a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="stack">
            @foreach (var row in Model.Rows)
            {
                <div class="row-item" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                    <div style="width:36px;height:36px;border-radius:10px;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;">@row.Habit.Icon</div>
                    <div style="flex:1;min-width:120px;">
                        <div style="font-weight:600;">@row.Habit.Name</div>
                        <div class="mini habit-stats">
                            累计 <b class="hs-total">@row.Total</b> 天 ·
                            <span class="hs-flame flame-badge" hidden="@(row.Streak < 2 ? "hidden" : null)" title="连续 @row.Streak 天，继续加油">@Html.Raw(Icons.Svg("flame", 14))连续 <b class="hs-n">@row.Streak</b> 天</span>
                            <span class="hs-plain" hidden="@(row.Streak >= 2 ? "hidden" : null)">连续 <b class="hs-n2" style="color:var(--accent-strong);">@row.Streak</b> 天</span>
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;align-items:center;">
                        @if (row.CheckedToday)
                        {
                            <form method="post" asp-page-handler="Undo" data-ajax="checkin">
                                <input type="hidden" name="id" value="@row.Habit.Id" />
                                <button class="btn secondary" type="submit" title="取消今天的打卡">✓ 今日已打卡</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Checkin" data-ajax="checkin">
                                <input type="hidden" name="id" value="@row.Habit.Id" />
                                <button class="btn" type="submit">打卡</button>
                            </form>
                        }
                        <a class="mini" href="/Habits/Edit/@row.Habit.Id">@Html.Raw(Icons.Svg("pencil", 14)) 编辑</a>
                    </div>
                </div>
            }
        </div>
    </div>
}
