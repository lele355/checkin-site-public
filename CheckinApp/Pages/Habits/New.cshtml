@page
@model CheckinApp.Pages.Habits.NewModel
@{
    ViewData["Title"] = "新建习惯";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>新建习惯</h2>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        <div class="field-row">
            <div class="field">
                <label>习惯名称</label>
                <input asp-for="Name" required autocomplete="off" placeholder="如：早起、背单词、跑步…" />
            </div>
            <div class="field">
                <label>图标（一个 emoji）</label>
                <input asp-for="Icon" autocomplete="off" maxlength="4" placeholder="🌱" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
            <a class="btn secondary" href="/Habits">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>
</div>
