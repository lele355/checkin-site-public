@page "{id:int}"
@model CheckinApp.Pages.Anniversaries.EditModel
@{
    ViewData["Title"] = "编辑纪念日";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>编辑纪念日</h2>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label>标题</label>
            <input asp-for="Title" required autocomplete="off" />
        </div>
        <div class="field">
            <label>日期</label>
            <input asp-for="Date" type="date" required />
        </div>
        <div class="field">
            <label>备注</label>
            <input asp-for="Note" autocomplete="off" />
        </div>
        <div class="field">
            <label>
                <input type="checkbox" class="switch" asp-for="RepeatYearly" />
                每年重复
            </label>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
            <a class="btn secondary" href="/Anniversaries">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>

    <hr class="rule" />
    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('确认删除这个纪念日？');" style="text-align:right;">
        <input type="hidden" name="id" value="@Model.Id" />
        <button class="btn danger" type="submit">@Html.Raw(Icons.Svg("trash-2", 16)) 删除此纪念日</button>
    </form>
</div>
