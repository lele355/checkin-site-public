@page
@model CheckinApp.Pages.Anniversaries.NewModel
@{
    ViewData["Title"] = "新建纪念日";
}
<div class="card" style="max-width:520px;margin:4vh auto 0;">
    <h2>新建纪念日</h2>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        <div class="field">
            <label>标题</label>
            <input asp-for="Title" required autocomplete="off" placeholder="如：在一起纪念日、生日…" />
        </div>
        <div class="field">
            <label>日期</label>
            <input asp-for="Date" type="date" required />
        </div>
        <div class="field">
            <label>备注</label>
            <input asp-for="Note" autocomplete="off" placeholder="可留空" />
        </div>
        <div class="field">
            <label>
                <input type="checkbox" class="switch" asp-for="RepeatYearly" />
                每年重复（生日、纪念日勾上）
            </label>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@Html.Raw(Icons.Svg("check", 16)) 保存</button>
            <a class="btn secondary" href="/Anniversaries">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>
</div>
