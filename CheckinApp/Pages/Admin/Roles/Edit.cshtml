@page "{id:int}"
@using CheckinApp.Security
@model CheckinApp.Pages.Admin.Roles.EditModel
@{
    ViewData["Title"] = $"编辑角色 · {Model.Name}";
    var grouped = PermissionCatalog.All.GroupBy(p => p.Module).OrderBy(g => g.Key);
}
<div class="card" style="max-width:560px;margin:4vh auto 0;">
    <h2>编辑角色</h2>
    <p class="hint">@(Model.IsBuiltin ? "内置角色（名称锁定，权限可调）" : "自定义角色")　勾完保存即时生效，用户不用重登。</p>

    @if (Model.Error is string err)
    {
        <div class="msg error">@err</div>
    }

    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label>角色名</label>
            <input name="NameIn" value="@Model.Name" @(Model.IsBuiltin ? "readonly" : "required") autocomplete="off" />
        </div>
        <div class="field">
            <label>说明</label>
            <input name="DescriptionIn" value="@Model.Description" autocomplete="off" />
        </div>

        <hr class="rule" />
        <h3 style="font-family:var(--font-body);font-size:.74rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--text-weak);margin-bottom:10px;">权限勾选</h3>

        @foreach (var g in grouped)
        {
            var label = PermissionCatalog.ModuleLabels.GetValueOrDefault(g.Key, g.Key);
            <div class="field">
                <label>@label</label>
                <div style="display:flex;flex-direction:column;gap:8px;padding:10px 14px;background:var(--card-soft);border-radius:var(--radius-sm);">
                    @foreach (var p in g)
                    {
                        <label style="display:flex;align-items:center;gap:10px;font-weight:400;text-transform:none;letter-spacing:0;font-size:.9rem;margin:0;">
                            <input type="checkbox" name="Permissions" value="@p.Code" checked="@(Model.CurrentPerms.Contains(p.Code))" style="width:auto;min-height:auto;flex-shrink:0;" />
                            <span>@p.Description <small style="color:var(--text-weak);">· @p.Code</small></span>
                        </label>
                    }
                </div>
            </div>
        }

        <div class="form-actions">
            <button class="btn" type="submit">保存权限</button>
            <a class="btn secondary" href="/Admin/Roles">@Html.Raw(Icons.Svg("x", 16)) 取消</a>
        </div>
    </form>
</div>
