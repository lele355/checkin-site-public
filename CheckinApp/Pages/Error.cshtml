@page
@model CheckinApp.Pages.ErrorModel
@{
    ViewData["Title"] = "出错了";
}
<div class="card" style="max-width:520px;margin:8vh auto 0;text-align:center;">
    <h2>😵 页面出了点小状况</h2>
    <p class="hint" style="margin:10px 0 18px;">
        服务器开小差了，稍后再试。若反复出现，把时间点记下来告诉管理员。
    </p>
    <a class="btn" asp-page="/Index" style="text-decoration:none;">回工作台</a>
</div>
