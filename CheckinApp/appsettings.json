{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicUrl": "https://example.com",
    "ClientVersion": "1.0.0",
    "ClientVersionCode": 1,
    "ClientNotes": "首个版本：远程加载 example.com 的安卓壳，支持状态栏适配与系统返回键。",
    "ClientApk": "/download/app-release.apk"
  },
  "Security": {
    "RegisterPerHour": 3
  },
  "ConnectionStrings": {
    "Default": "Data Source=data/checkin.db"
  },
  "Ai": {
    "BaseUrl": "https://api.xiaomimimo.com/v1",
    "Model": "mimo-v2.6-flash",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "MaxCompletionTokens": 4096,
    "DailyRequestLimit": 60,
    "DailyTokenLimit": 1000000
  }
}
